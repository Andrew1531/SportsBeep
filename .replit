modules = ["java-graalvm22.3", "ruby-3.2", "web", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rails Server"

[[workflows.workflow]]
name = "Rails Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && RAILS_ENV=development bundle exec rake db:migrate && PORT=5000 bundle exec rails server -b 0.0.0.0 -p 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd frontend && (RAILS_ENV=production bundle exec rake db:smart_migrate || echo 'Migration skipped, starting server...') && RAILS_ENV=production bundle exec puma -C config/puma.rb"]
build = ["bash", "-c", "bundle install --jobs 4 --retry 3 && cd frontend && RAILS_ENV=production bundle exec rake assets:precompile"]

[userenv]

[userenv.shared]
BEEP_POLICY_ID = "a221e11c9d474ac3709911161bcfd02969d268e927089d3c55a4c3c2"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
