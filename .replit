modules = ["java-graalvm22.3", "ruby-3.2", "web", "nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rails Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sports API"

[[workflows.workflow]]
name = "Rails Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && export RAILS_ENV=development PORT=5000 && bundle exec rake db:migrate && exec bundle exec puma -C config/puma.rb"
waitForPort = 5000

[[workflows.workflow]]
name = "Sports API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sports-api && node server.mjs"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd frontend && RAILS_ENV=production bundle exec rake db:smart_migrate && RAILS_ENV=production bundle exec puma -C config/puma.rb"]
build = ["bash", "-c", "bundle install --jobs 4 --retry 3 && cd frontend && RAILS_ENV=production bundle exec rake assets:precompile"]

[userenv]

[userenv.shared]
BEEP_POLICY_ID = "a221e11c9d474ac3709911161bcfd02969d268e927089d3c55a4c3c2"
TREASURY_ADDRESS = "addr1qyzgfd725zhy8h6q2q5wf2fakheqpa6j5s3q8xzfaqqsknqaxqeph7nzj9s3nds3ssurnr2d5u7gh4sa2fsny3jrushqqdvm0j"
BEEP_ASSET_UNIT = "a221e11c9d474ac3709911161bcfd02969d268e927089d3c55a4c3c242454550"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
