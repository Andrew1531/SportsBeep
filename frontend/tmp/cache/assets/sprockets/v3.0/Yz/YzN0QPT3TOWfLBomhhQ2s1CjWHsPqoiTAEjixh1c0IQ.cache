<h1 class="current-contest-header"></h1>
<div class="dashboard">
  <div class="contests" ng-class="{ 'hidden-xs': hasContest }">
    <a href="#/games" class="new-ticket">Start New Game</a>
    <ul>
      <li>
        <button ng-click="filterContests('live')" class="contest-tab" ng-class="{selected: contestStatus=='live'}">
          Live
        </button>
      </li>
      <li class="middle-btn">
        <button ng-click="filterContests('upcoming')" class="contest-tab" ng-class="{selected: contestStatus=='upcoming'}">
          Upcoming
        </button>
      </li>
      <li>
        <button ng-click="filterContests('past')" class="contest-tab" ng-class="{selected: contestStatus=='past'}">
          History
        </button>
      </li>
      <div class="clearfix"></div>
    </ul>
    <div class="clearfix"></div>
    <div class="contests-outer-container">
      <div class="contest" ng-repeat="contest in contests">
        <a ui-sref="dashboard.contestShow({ id: contest.id })">
          <game-card sb-game="contest.game" sb-include-start-time="true">
          </game-card>
        </a>
        <contest-tickets sb-contest="contest"></contest-tickets>
      </div>
    </div>
  </div>
  <div ui-view="content" class="players">
  </div>
</div>;T:metadata{	:dependencieso:Set:
