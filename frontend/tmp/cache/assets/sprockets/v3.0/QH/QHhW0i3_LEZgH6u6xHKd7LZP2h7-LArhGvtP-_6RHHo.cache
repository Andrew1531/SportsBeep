I"±	(function() {
  var extend = function(child, parent) { for (var key in parent) { if (hasProp.call(parent, key)) child[key] = parent[key]; } function ctor() { this.constructor = child; } ctor.prototype = parent.prototype; child.prototype = new ctor(); child.__super__ = parent.prototype; return child; },
    hasProp = {}.hasOwnProperty;

  angular.module('sportsbeep.services').factory('PlayerService', function($resource, HttpService, Player) {
    var PlayerService;
    PlayerService = (function(superClass) {
      extend(PlayerService, superClass);

      function PlayerService(game1) {
        this.game = game1;
        this.indexRoot = 'players';
        this.includeSquads = false;
        PlayerService.__super__.constructor.call(this, '/api/:sport/:resource/:resourceId/players/:id');
      }

      PlayerService.prototype.all = function(params) {
        return this.service.query(params);
      };

      PlayerService.prototype.forGame = function(game) {
        this.game = game;
        return this.service.query({
          resource: 'games',
          resourceId: this.game.id
        });
      };

      PlayerService.prototype.forTicket = function(ticket) {
        this.game = void 0;
        this.ticket = ticket;
        this.includeSquads = true;
        return this.service.query({
          resource: 'tickets',
          resourceId: this.ticket.id
        });
      };

      PlayerService.prototype.jsonToModel = function(data) {
        if (this.game) {
          return new Player(this.game, data);
        } else if (this.ticket) {
          return new Player(this.ticket.game, data);
        }
      };

      PlayerService.prototype.actionOptions = function() {
        return {
          query: {
            method: 'GET',
            isArray: true,
            transformResponse: (function(_this) {
              return function(data) {
                var response, wrapped;
                response = [];
                wrapped = angular.fromJson(data);
                angular.forEach(wrapped[_this.indexRoot], function(item) {
                  return response.push(_this.jsonToModel(item));
                });
                if (_this.includeSquads) {
                  _this.ticket.squads = wrapped['squads'];
                }
                return response;
              };
            })(this)
          }
        };
      };

      return PlayerService;

    })(HttpService);
    return new PlayerService;
  });

}).call(this);
