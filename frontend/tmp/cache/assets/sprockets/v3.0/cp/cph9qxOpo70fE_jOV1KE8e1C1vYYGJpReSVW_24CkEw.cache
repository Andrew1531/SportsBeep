I"p(function() {
  angular.module('sportsbeep.controllers').controller('DashboardCtrl', function($scope, $stateParams, ContestService, CurrentContest) {
    CurrentContest.contest = null;
    $scope.filterContests = function(status) {
      $scope.contestStatus = status;
      $scope.contests = [];
      return $scope.contests = ContestService.all({
        status: $scope.contestStatus
      });
    };
    $scope.filterContests('upcoming');
    return $scope.$watch((function() {
      return CurrentContest.contest;
    }), function(newVal) {
      return $scope.hasContest = newVal != null;
    });
  });

}).call(this);
