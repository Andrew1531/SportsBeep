I"(function() {
  var extend = function(child, parent) { for (var key in parent) { if (hasProp.call(parent, key)) child[key] = parent[key]; } function ctor() { this.constructor = child; } ctor.prototype = parent.prototype; child.prototype = new ctor(); child.__super__ = parent.prototype; return child; },
    hasProp = {}.hasOwnProperty;

  angular.module('sportsbeep.services').service('BestAndBustAnswerService', function($http, GlobalOptions, HttpService) {
    var BestAndBustAnswerService;
    BestAndBustAnswerService = (function(superClass) {
      extend(BestAndBustAnswerService, superClass);

      function BestAndBustAnswerService() {
        BestAndBustAnswerService.__super__.constructor.call(this, '/api/:sport/tickets/:ticketId/answers');
        this.indexRoot = 'answers';
      }

      BestAndBustAnswerService.prototype.all = function(params) {
        return this.service.query(params);
      };

      BestAndBustAnswerService.prototype.submit = function(ticketId, payload) {
        try {
          return $http.post("/api/" + (GlobalOptions.get('sport')) + "/tickets/" + ticketId + "/answers", payload);
        } catch (error) {

        }
      };

      return BestAndBustAnswerService;

    })(HttpService);
    return new BestAndBustAnswerService;
  });

}).call(this);
