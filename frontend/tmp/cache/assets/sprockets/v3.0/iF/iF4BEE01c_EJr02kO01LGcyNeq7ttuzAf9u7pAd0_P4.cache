I"û(function() {
  var extend = function(child, parent) { for (var key in parent) { if (hasProp.call(parent, key)) child[key] = parent[key]; } function ctor() { this.constructor = child; } ctor.prototype = parent.prototype; child.prototype = new ctor(); child.__super__ = parent.prototype; return child; },
    hasProp = {}.hasOwnProperty;

  angular.module('sportsbeep.services').service('TicketService', function($http, HttpService, Ticket, GlobalOptions) {
    var TicketService;
    TicketService = (function(superClass) {
      extend(TicketService, superClass);

      function TicketService() {
        TicketService.__super__.constructor.call(this, '/api/:sport/tickets/:id');
        this.indexRoot = 'games';
      }

      TicketService.prototype.createTicket = function(params) {
        return $http.post("/api/" + (GlobalOptions.get('sport')) + "/tickets", params);
      };

      TicketService.prototype.updateTicket = function(ticket, params) {
        return $http.put("/api/" + (GlobalOptions.get('sport')) + "/tickets/" + ticket.id, params);
      };

      TicketService.prototype.jsonToModel = function(data) {
        return new Ticket(data);
      };

      return TicketService;

    })(HttpService);
    return new TicketService;
  });

}).call(this);
