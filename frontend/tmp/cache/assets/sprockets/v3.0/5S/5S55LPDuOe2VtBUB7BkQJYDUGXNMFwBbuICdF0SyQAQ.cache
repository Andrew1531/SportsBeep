<div class="player-cards">
  <a ui-sref="gameShow.players({ position: player.gamePosition.id })" ng-repeat="player in players">
    <player-card sb-player="player"></player-card>
  </a>
  <a ng-repeat="ticketSquad in ticketSquads" ng-click="selectSquad(ticketSquad, game)" >
