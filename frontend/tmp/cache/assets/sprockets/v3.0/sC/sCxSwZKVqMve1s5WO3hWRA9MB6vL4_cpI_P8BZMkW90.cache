I"â(function() {
  angular.module('sportsbeep.services').service('AuthService', function($resource) {
    var AuthService;
    AuthService = (function() {
      function AuthService() {
        this.service = $resource('/api/users/:_action', null, {
          login: {
            method: 'POST',
            params: {
              _action: 'login'
            }
          }
        });
      }

      AuthService.prototype.login = function() {
        return localStorage.setItem('authToken', $('#auth-token').data('token'));
      };

      AuthService.prototype.getAuthToken = function() {
        return localStorage.getItem('authToken');
      };

      return AuthService;

    })();
    return new AuthService;
  });

}).call(this);
