I"S(function() {
  angular.module('sportsbeep.controllers').controller('TicketCtrl', function($scope, ticket, contest, game, TicketPlayer, CurrentContest, CurrentTicket, ChoosePlayerService, SquadService, ScoresheetService, GamePositionService, GameSquadService, TicketService, PlayerService, Ticket) {
    CurrentTicket.clear();
    CurrentContest.contest = contest;
    return CurrentTicket.fromTicket(ticket).then(function() {
      var gameSquads, squads;
      $scope.ticket = ticket;
      $scope.contest = contest;
      $scope.game = game;
      $scope.positions = CurrentTicket.getAvailablePlayerPositions();
      $scope.ticketPlayers = CurrentTicket.ticketPlayers;
      $scope.gamePlayers = PlayerService.forGame(game).$promise;
      CurrentTicket.game = game;
      gameSquads = GameSquadService.all();
      squads = $scope.ticket.squads;
      $scope.players = $scope.ticketPlayers.map(function(tp) {
        return tp.player;
      });
      return $scope.squads = squads.map((function(_this) {
        return function(squad) {
          var gameSquad, i, len;
          for (undefined; i < len; i++) {
            gameSquad = gameSquads[i];
            if (gameSquad.id === squad.game_position) {
              squad.name = gameSquad.name;
            }
          }
          return squad;
        };
      })(this));
    });
  });

}).call(this);
