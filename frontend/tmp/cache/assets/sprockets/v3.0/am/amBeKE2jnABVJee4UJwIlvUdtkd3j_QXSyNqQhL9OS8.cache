I"ª(function() {
  var extend = function(child, parent) { for (var key in parent) { if (hasProp.call(parent, key)) child[key] = parent[key]; } function ctor() { this.constructor = child; } ctor.prototype = parent.prototype; child.prototype = new ctor(); child.__super__ = parent.prototype; return child; },
    hasProp = {}.hasOwnProperty;

  angular.module('sportsbeep.factories').factory('Player', function(Model) {
    var Player;
    return Player = (function(superClass) {
      extend(Player, superClass);

      function Player(game, json) {
        this.game = game;
        Player.__super__.constructor.call(this, json);
        this.team = this.getTeam(game, this.team.id);
        this.teamColor = this.getTeamColor();
        this.gamePosition = this.getGamePosition();
      }

      Player.prototype.getGamePosition = function() {
        if (this.game_position != null) {
          return {
            id: this.game_position
          };
        } else if (this.gamePosition) {
          return this.gamePosition;
        } else {
          return {};
        }
      };

      Player.prototype.getTeam = function(game, teamId) {
        if (game.home_team.id === teamId) {
          return game.home_team;
        } else {
          return game.away_team;
        }
      };

      Player.prototype.getTeamColor = function() {
        return this.team.primary_color;
      };

      return Player;

    })(Model);
  });

}).call(this);
