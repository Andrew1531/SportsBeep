  angular.module('sportsbeep.factories').factory('GameSquad', function() {
    var GameSquad;
    return GameSquad = (function() {
      function GameSquad(id, name, score) {
        if (score == null) {
          score = 0.0;
        }
        this.id = id;
        this.name = name;
        this.score = score;
      }

      return GameSquad;

    })();
  });

}).call(this);
