  angular.module('sportsbeep.factories').factory('TicketSquad', function() {
    var TicketSquad;
    return TicketSquad = (function() {
      function TicketSquad(gameSquad, team) {
        this.gameSquad = gameSquad;
        this.team = team;
        this.name = this.gameSquad.name;
