I"º(function() {
  angular.module('sportsbeep.controllers').controller('GameShowCtrl', function($scope, $stateParams, GameService, GamePositionService, GameSquadService, CurrentTicket, PlayerService, ChooseSquadTeamModalService) {
    $scope.game = GameService.find($stateParams.id, function(data) {
      $scope.gamePositions = GamePositionService.all();
      $scope.gameSquads = GameSquadService.all();
      $scope.game.players = PlayerService.forGame($scope.game);
      return CurrentTicket.game = $scope.game;
    });
    CurrentTicket.clear();
    $scope.currentTicket = CurrentTicket;
    $scope.selectSquad = function(ticketSquad, game) {
      return ChooseSquadTeamModalService.show(ticketSquad, game).then((function(_this) {
        return function(team) {
          return CurrentTicket.selectTeamForGameSquad(team, ticketSquad);
        };
      })(this));
    };
    return $scope.$watch('currentTicket.updatedAt', (function(_this) {
      return function() {
        $scope.players = $scope.currentTicket.ticketPlayers.map(function(tp) {
          return tp.player;
        });
        return $scope.ticketSquads = $scope.currentTicket.ticketSquads;
      };
    })(this));
  });

}).call(this);
