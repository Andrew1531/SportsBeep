I"(function() {
  angular.module('sportsbeep.controllers').controller('TicketShowCtrl', function($scope, $stateParams, ticket, contest, game, CurrentContest, CurrentTicket, ChoosePlayerService, SquadService, ScoresheetService, GamePositionService, ChooseSquadTeamModalService, GameSquadService, TicketService, PlayerService, Ticket) {
    $scope.getPlayerAtPosition = function(position) {
      return CurrentTicket.getPlayerAtPosition(position);
    };
    $scope.selectSquad = function(ticketSquad) {
      ticketSquad.gameSquad = {
        id: ticketSquad.game_position
      };
      return ChooseSquadTeamModalService.show(ticketSquad, $scope.game).then((function(_this) {
        return function(team) {
          CurrentTicket.selectTeamForGameSquad(team, ticketSquad);
          return $scope.squads = CurrentTicket.ticketSquads;
        };
      })(this));
    };
    $scope.updateTicket = function() {
      var $checkmark, $spinner;
      $spinner = $('.set-your-team .fa-spinner');
      $checkmark = $('.set-your-team .fa-check');
      $checkmark.hide();
      $spinner.show();
      return TicketService.updateTicket($scope.ticket, CurrentTicket.serialize()).success((function(_this) {
        return function(data) {
          $spinner.hide();
          return $checkmark.show();
        };
      })(this)).error(function(data) {
        $scope.error = data.error;
        return $spinner.hide();
      });
    };
    $scope.getScoresheetFor = (function(_this) {
      return function(player) {
        var http;
        http = ScoresheetService.find($scope.ticket.id, player.id, function(data) {
          return $scope.stats = data.stats;
        });
        return http.$promise;
      };
    })(this);
    return $scope.getSquadScoresheetFor = (function(_this) {
      return function(squad) {
        var http;
        http = SquadService.find($scope.ticket.id, squad.game_position, function(data) {
          return $scope.stats = data.stats;
        });
        return http.$promise;
      };
    })(this);
  });

}).call(this);
