I"D(function() {
  angular.module('sportsbeep.services').service('ChooseSquadTeamModalService', function($q) {
    var ChooseSquadTeamModalService;
    ChooseSquadTeamModalService = (function() {
      function ChooseSquadTeamModalService() {}

      ChooseSquadTeamModalService.prototype.show = function(squad, game) {
        var promise;
        this.d = $q.defer();
        this.squad = squad;
        this.game = game;
        promise = this.d.promise;
        promise["finally"](function() {
          $('.container').removeClass('blurred');
          return $('#squad-overlay').hide();
        });
        $('.container').addClass('blurred');
        $('#squad-overlay').show();
        return promise;
      };

      return ChooseSquadTeamModalService;

    })();
    return new ChooseSquadTeamModalService;
  });

}).call(this);
