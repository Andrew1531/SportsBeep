I"Š(function() {
  var indexOf = [].indexOf || function(item) { for (var i = 0, l = this.length; i < l; i++) { if (i in this && this[i] === item) return i; } return -1; };

  angular.module('sportsbeep.controllers').controller('ChoosePlayerCtrl', function($scope, $stateParams, ChoosePlayerService, CurrentTicket, GamePositionService) {
    var playerPositionsForGamePosition;
    $scope.position = $stateParams.position;
    playerPositionsForGamePosition = GamePositionService.playerPositionsFor({
      id: $stateParams.position
    });
    $scope.selectPlayer = function(player, position) {
      return CurrentTicket.selectPlayerForGamePosition(player, {
        id: position
      });
    };
    return $scope.gamePlayers.then(function(players) {
      var awayTeamPlayers, homeTeamPlayers, i, j, maxSize, playersOnTicketIDs, ref;
      playersOnTicketIDs = CurrentTicket.ticketPlayers.map(function(ticketPlayer) {
        return ticketPlayer.player.id;
      });
      $scope.players = players.filter((function(_this) {
        return function(player) {
          var ref, ref1;
          return (ref = player.position, indexOf.call(playerPositionsForGamePosition, ref) >= 0) && (ref1 = player.id, indexOf.call(playersOnTicketIDs, ref1) < 0);
        };
      })(this));
      $scope.players = $scope.players.sort(function(a, b) {
        if (a.name.toUpperCase() > b.name.toUpperCase()) {
          return 1;
        } else {
          return -1;
        }
      });
      homeTeamPlayers = $scope.players.filter(function(player) {
        return player.team.id === $scope.game.home_team.id;
      });
      awayTeamPlayers = $scope.players.filter(function(player) {
        return player.team.id === $scope.game.away_team.id;
      });
      maxSize = Math.max(homeTeamPlayers.length, awayTeamPlayers.length);
      players = [];
      for (i = j = 0, ref = maxSize; 0 <= ref ? j <= ref : j >= ref; i = 0 <= ref ? ++j : --j) {
        if (homeTeamPlayers[i]) {
          players.push(homeTeamPlayers[i]);
        }
        if (awayTeamPlayers[i]) {
          players.push(awayTeamPlayers[i]);
        }
      }
      return $scope.players = players;
    });
  });

}).call(this);
