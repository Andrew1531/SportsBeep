I"5(function() {
  angular.module('sportsbeep.controllers').controller('ChooseSquadTeamModalCtrl', function($scope, CurrentTicket, ChooseSquadTeamModalService) {
    $scope.$watch((function() {
      return CurrentTicket.game;
    }), function(game) {
      return $scope.game = game;
    });
    $scope.$watch((function() {
      return ChooseSquadTeamModalService.squad;
    }), function(squad) {
      if (squad) {
        $scope.squad = squad;
        if (squad.name) {
          return $scope.squad.name = squad.name;
        }
      }
    });
    $scope.selectHomeTeam = function() {
      return ChooseSquadTeamModalService.d.resolve($scope.game.home_team);
    };
    return $scope.selectAwayTeam = function() {
      return ChooseSquadTeamModalService.d.resolve($scope.game.away_team);
    };
  });

}).call(this);
