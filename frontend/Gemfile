source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '3.2.2'

gem 'rails', '~> 6.1.0'
gem 'sqlite3', '~> 1.4'
gem 'sass-rails', '>= 6'
gem 'sassc', '~> 2.1.0'  # Pin to stable version - 2.4.0 has native compilation issues
gem 'sprockets', '~> 3.7.2'  # Pin for sassc compatibility
gem 'sprockets-rails'
gem 'turbolinks', '~> 5'
gem 'jbuilder', '~> 2.7'
gem 'uglifier', '>= 1.3.0'  # JavaScript compressor for production

# Web server for production and development
gem 'puma', '~> 5.0'

group :development, :test do
  gem 'byebug', platforms: [:mri, :mingw, :x64_mingw]
end

group :development do
  gem 'web-console', '>= 4.1.0'
  gem 'listen', '~> 3.3'
end

# Application specific gems - minimal set
gem 'devise'
gem 'simple_form'  # Form builder for sign up and login pages
gem 'jquery-rails'
gem 'coffee-rails'
gem 'angular-rails-templates'
