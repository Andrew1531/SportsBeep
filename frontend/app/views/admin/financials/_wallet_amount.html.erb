<% if decimals.nil? %>
  <span class="text-muted">Wallet amount unavailable</span>
  <br><small>Platform decimals are unavailable; no display amount is assumed.</small>
<% else %>
  <strong class="treasury-wallet-amount"><%= number_with_delimiter(TokenAmount.format(units, decimals: decimals)) %> <%= ticker %></strong>
<% end %>