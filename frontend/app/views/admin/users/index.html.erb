<div class="page-header">
  <h3>
    <% if @promo_code %>
      Users with Promo Code: <code><%= @promo_code.code %></code>
    <% else %>
      All Users
    <% end %>
    <small>(<%= number_with_delimiter(@count) %> total)</small>
  </h3>
</div>

<!-- Search Bar -->
<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-6">
    <%= form_tag admin_users_path, method: :get, class: 'form-inline' do %>
      <div class="form-group" style="width: 400px;">
        <%= text_field_tag :search, params[:search], class: 'form-control', placeholder: 'Search by email or username...', style: 'width: 100%;' %>
      </div>
      <%= submit_tag 'Search', class: 'btn btn-primary' %>
      <% if params[:search].present? %>
        <%= link_to 'Clear', admin_users_path, class: 'btn btn-default' %>
      <% end %>
    <% end %>
  </div>
  <div class="col-md-6 text-right">
    <%= paginate @users %>
  </div>
</div>

<!-- Users Table -->
<table id="users" class="table table-hover table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Username</th>
      <th>Email</th>
      <th>Balance</th>
      <th>Tickets</th>
      <th>Promo Code</th>
      <th>Created</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if @users.any? %>
      <% @users.each do |user| %>
        <tr>
          <td><code><%= user.id %></code></td>
          <td>
            <strong><%= link_to user.username, admin_user_path(user) %></strong>
          </td>
          <td><%= user.email %></td>
          <td>
            <% if user.account %>
              <span class="label label-<%= user.account.balance_cents > 0 ? 'success' : 'default' %>">
                <%= number_to_currency(user.account.balance_cents / 100.0) %>
              </span>
            <% else %>
              <span class="text-muted">No account</span>
            <% end %>
          </td>
          <td>
            <span class="badge"><%= user.tickets.count %></span>
          </td>
          <td>
            <% if user.promo_code %>
              <%= link_to user.promo_code.code, admin_promo_code_path(user.promo_code), class: 'label label-info' %>
            <% else %>
              <span class="text-muted">None</span>
            <% end %>
          </td>
          <td>
            <small class="text-muted">
              <%= time_ago_in_words(user.created_at) %> ago
            </small>
          </td>
          <td>
            <%= link_to 'View', admin_user_path(user), class: 'btn btn-xs btn-primary' %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="8" class="text-center text-muted">
          <% if params[:search].present? %>
            No users found matching "<%= params[:search] %>"
          <% else %>
            No users yet
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="text-center">
  <%= paginate @users %>
</div>

<style>
.table > thead > tr > th {
  background-color: #f5f5f5;
  font-weight: 600;
}

.table > tbody > tr:hover {
  background-color: #f9f9f9;
}
</style>
