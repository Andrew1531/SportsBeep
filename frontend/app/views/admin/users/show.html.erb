<h3><%= @user.email %> <small><%= @user.username %></small></h3>
<div class="row">
  <div class="col-xs-6">
    <table class="table table-bordered table-striped">
      <thead>
        <th>Attribute</th>
        <th>Value</th>
      </thead>
      <tbody>
        <% %w(id email username device_token platform).each do |attr| %>
          <tr>
            <td><code><%= attr %></code></td>
            <td><%= @user.send attr %></td>
          </tr>
        <% end %>
        <tr>
            <td><code>created_at</code></td>
            <td><%= l est(@user.created_at), format: :short %></td>
          </tr>
      </tbody>
    </table>
    <%= simple_form_for [:admin, @user] do |f| %>
      <%= f.input :password %>
      <%= f.submit %>
    <% end %>
  </div>
</div>