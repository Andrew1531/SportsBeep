<% back_path = @game.is_a?(Nfl::Game) ? admin_nfl_games_path : admin_mlb_games_path rescue admin_mlb_games_path %>
<div class="container-fluid">
  <div class="row">
    <div class="col-xs-12">
      <%= link_to '&larr; Back to Games'.html_safe, back_path, class: 'btn btn-default' %>
    </div>
  </div>
  
  <br>

  <div class="row">
    <div class="col-xs-12 col-md-8">
      <div class="panel panel-primary">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="glyphicon glyphicon-calendar"></i>
            Game #<%= @game.id %>
          </h3>
        </div>
        <div class="panel-body">
          <div class="row">
            <div class="col-xs-5 text-center">
              <h2><%= @game.away_team.try(:name) || @game.away_team %></h2>
              <p class="text-muted">Away Team</p>
            </div>
            <div class="col-xs-2 text-center">
              <h1 class="text-muted">@</h1>
            </div>
            <div class="col-xs-5 text-center">
              <h2><%= @game.home_team.try(:name) || @game.home_team %></h2>
              <p class="text-muted">Home Team</p>
            </div>
          </div>
          
          <hr>
          
          <table class="table table-bordered">
            <tr>
              <td width="30%"><strong>Start Time</strong></td>
              <td>
                <% if @game.start_time %>
                  <%= @game.start_time.strftime("%A, %B %d, %Y at %I:%M %p") %>
                <% else %>
                  <span class="text-muted">TBD</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <td><strong>Status</strong></td>
              <td>
                <% status = @game.status.to_s.presence || 'scheduled' %>
                <span class="label label-<%= status == 'live' ? 'success' : (status == 'ended' ? 'default' : 'info') %>">
                  <%= status.titleize %>
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Bettable</strong></td>
              <td>
                <% if @game.bettable? %>
                  <span class="label label-success"><i class="glyphicon glyphicon-ok"></i> Yes - Users can bet on this game</span>
                <% else %>
                  <span class="label label-default"><i class="glyphicon glyphicon-remove"></i> No - Betting disabled</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <td><strong>Game Type</strong></td>
              <td><code><%= @game.type || 'Game' %></code></td>
            </tr>
            <tr>
              <td><strong>Created</strong></td>
              <td><%= @game.created_at.strftime("%b %d, %Y %I:%M %p") rescue 'N/A' %></td>
            </tr>
          </table>
        </div>
      </div>
    </div>
    
    <div class="col-xs-12 col-md-4">
      <div class="panel panel-info">
        <div class="panel-heading">
          <h4 class="panel-title">Game Actions</h4>
        </div>
        <div class="panel-body">
          <div class="btn-group-vertical" style="width: 100%;">
            <% if @game.bettable? %>
              <button class="btn btn-warning" disabled>
                <i class="glyphicon glyphicon-ban-circle"></i> Disable Betting
              </button>
            <% else %>
              <button class="btn btn-success" disabled>
                <i class="glyphicon glyphicon-ok-circle"></i> Enable Betting
              </button>
            <% end %>
            <button class="btn btn-default" disabled>
              <i class="glyphicon glyphicon-refresh"></i> Refresh Stats
            </button>
          </div>
          <p class="text-muted" style="margin-top: 10px; font-size: 12px;">
            <i class="glyphicon glyphicon-info-sign"></i>
            Actions will be enabled once sports data API is connected.
          </p>
        </div>
      </div>
      
    </div>
  </div>

  <% if @game.respond_to?(:league_picks) && @game.league_picks.any? %>
    <div class="row">
      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4 class="panel-title">League Picks</h4>
          </div>
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>Home Team</th>
                  <th>Away Team</th>
                  <th>Start Time</th>
                </tr>
              </thead>
              <tbody>
                <% @game.league_picks.each do |pick| %>
                  <tr>
                    <td><%= pick.home_team %></td>
                    <td><%= pick.away_team %></td>
                    <td><%= pick.start_time.strftime("%b %d, %Y %I:%M %p") rescue 'TBD' %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
