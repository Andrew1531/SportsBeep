<h3><%= @game.away_team %> @ <%= @game.home_team %> <small><%= l est(@game.start_time), format: :short %></small></h3>
<div class="row">
  <div class="col-xs-6">
    <h4>League Picks</h4>
    <table id="league-picks" class="table table-striped">
      <thead>
        <tr>
          <th>Home team</th>
          <th>Away team</th>
          <th>Start time</th>
        </tr>
      </thead>
      <tbody>
        <% @game.league_picks.each do |game| %>
          <tr data-href="<%= polymorphic_path([:admin, game]) %>">
            <td><%= game.home_team %></td>
            <td><%= game.away_team %></td>
            <td><%= l est(game.start_time), format: :short %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>