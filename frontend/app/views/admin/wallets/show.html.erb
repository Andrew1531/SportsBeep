<div class="page-header"><h2>Wallets for <%= @user.username %></h2></div>
<p><%= link_to 'All wallets', admin_wallets_path, class: 'btn btn-default' %> <%= link_to 'User profile', admin_user_path(@user), class: 'btn btn-default' %> <%= link_to 'Swap history', admin_swaps_path(user_id: @user.id), class: 'btn btn-default' %></p>
<dl>
  <dt>Current Cardano address</dt><dd style="overflow-wrap:anywhere"><code><%= @user.cardano_wallet_address.presence || 'Not connected' %></code></dd>
  <dt>Stake address</dt><dd style="overflow-wrap:anywhere"><code><%= @user.cardano_stake_address.presence || 'Not recorded' %></code></dd>
  <dt>Wallet provider</dt><dd><%= @user.cardano_wallet_name.presence || 'Not recorded' %></dd>
  <dt>Verified at</dt><dd><%= @user.cardano_wallet_verified_at&.in_time_zone&.strftime('%Y-%m-%d %H:%M %Z') || 'Not verified' %></dd>
</dl>
<h3>In-app token balances</h3>
<p class="text-muted">These are internal ledger balances, not a live blockchain wallet balance. Raw units are authoritative; formatted amounts use the app's configured decimals.</p>
<div class="table-responsive"><table class="table table-striped">
  <thead><tr><th>Token</th><th>Available</th><th>Available raw units</th><th>Loaded raw units (separate tracking)</th><th>Decimals</th></tr></thead>
  <tbody>
    <% @balances.each do |balance| %><tr><td><%= balance.approved_token.ticker %></td><td><%= balance.approved_token.format_units(balance.balance_units) %></td><td><code><%= balance.balance_units %></code></td><td><code><%= balance.loaded_units %></code></td><td><%= balance.approved_token.decimals %></td></tr><% end %>
    <% if @balances.empty? %><tr><td colspan="5">No token balances recorded.</td></tr><% end %>
  </tbody>
</table></div>
<h3>Retained payout addresses</h3>
<p class="text-muted">Addresses retained on transfer records are historical destinations, not necessarily currently connected wallets.</p>
<% if @historical_addresses.empty? %><p>No historical payout addresses recorded.</p><% else %><ul><% @historical_addresses.each do |address| %><li style="overflow-wrap:anywhere"><code><%= address %></code></li><% end %></ul><% end %>
<h3>Transfers</h3>
<div class="table-responsive"><table class="table table-striped">
  <thead><tr><th>Date</th><th>Direction</th><th>Token / amount</th><th>Raw units</th><th>Status</th><th>Transaction</th></tr></thead>
  <tbody>
    <% @transfers.each do |transfer| %><tr>
      <td><%= transfer.created_at.in_time_zone.strftime('%Y-%m-%d %H:%M %Z') %></td><td><%= transfer.direction %></td>
      <td><%= transfer.approved_token ? "#{transfer.approved_token.format_units(transfer.amount_in_units)} #{transfer.approved_token.ticker}" : 'Legacy denomination not assigned' %></td>
      <td><code><%= transfer.amount_in_units %></code></td><td><%= transfer.status %></td>
      <td style="max-width:220px;overflow-wrap:anywhere"><% if transfer.tx_hash.present? %><%= link_to transfer.tx_hash, transfer.explorer_url, target: '_blank', rel: 'noopener noreferrer' %><% else %>Not submitted<% end %></td>
    </tr><% end %>
    <% if @transfers.empty? %><tr><td colspan="6">No transfers recorded.</td></tr><% end %>
  </tbody>
</table></div>
<%= paginate @transfers %>