<h3>
  Administrators (<%= @administrators.size %>)
  <%= link_to 'Create', new_admin_administrator_path, class: 'btn btn-primary' %>
</h3>
<table id="administrators" class="table table-hover">
  <thead>
    <tr>
      <th>E-mail</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @administrators.each do |admin| %>
      <tr>
        <td><%= admin.email %></td>
        <td><%= link_to 'Delete', admin_administrator_path(admin), class: 'btn btn-xs btn-danger', method: :delete, confirm: 'Are you sure?' %></td>
      </tr>
    <% end %>
  </tbody>
</table>