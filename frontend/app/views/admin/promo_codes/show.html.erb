<h3>Promo Code <%= @promo_code.code %> <small><%= @promo_code.users_count %> redemptions</small></h3>
<div class="row">
  <div class="col-xs-6">
    <table class="table table-bordered table-striped">
      <thead>
        <th>Attribute</th>
        <th>Value</th>
      </thead>
      <tbody>
        <tr>
          <td><code>code</code></td>
          <td><%= @promo_code.code %></td>
        </tr>
        <tr>
          <td><code>note</code></td>
          <td><%= @promo_code.note %></td>
        </tr>
      </tbody>
    </table>
    <%= link_to 'Edit', edit_admin_promo_code_path(@promo_code), class: 'btn btn-primary' %>
    <%= link_to 'Delete', admin_promo_code_path(@promo_code), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } %>
  </div>
</div>