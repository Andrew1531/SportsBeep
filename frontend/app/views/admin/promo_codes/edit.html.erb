<div class="container-fluid">
  <div class="row">
    <div class="col-xs-12">
      <%= link_to '&larr; Back to Promo Codes'.html_safe, admin_promo_codes_path, class: 'btn btn-default' %>
    </div>
  </div>
  
  <br>

  <div class="row">
    <div class="col-xs-12 col-md-6">
      <div class="panel panel-warning">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="glyphicon glyphicon-pencil"></i>
            Edit Promo Code: <%= @promo_code.code %>
          </h3>
        </div>
        <div class="panel-body">
          <%= render 'form', promo_code: @promo_code %>
        </div>
      </div>
    </div>
    
    <div class="col-xs-12 col-md-6">
      <div class="panel panel-info">
        <div class="panel-heading">
          <h4 class="panel-title">Code Statistics</h4>
        </div>
        <div class="panel-body">
          <table class="table table-bordered">
            <tr>
              <td><strong>Current Code</strong></td>
              <td><code><%= @promo_code.code %></code></td>
            </tr>
            <tr>
              <td><strong>Total Redemptions</strong></td>
              <td><span class="badge"><%= @promo_code.users.size %></span></td>
            </tr>
            <tr>
              <td><strong>Created</strong></td>
              <td><%= @promo_code.created_at.strftime("%b %d, %Y") rescue 'N/A' %></td>
            </tr>
          </table>
          
          <div class="alert alert-warning">
            <i class="glyphicon glyphicon-warning-sign"></i>
            <strong>Warning:</strong> Changing the code will affect how users enter it. Existing redemptions will remain linked.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
