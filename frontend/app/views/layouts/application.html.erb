<!DOCTYPE html>
<html>
<head>
  <title>Sportsbeep</title>
  <%= stylesheet_link_tag "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%= favicon_link_tag 'favicon-32.png', type: 'image/png' %>
  <%= csrf_meta_tags %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <%= render 'shared/google_analytics' %>
  <style>
    .sb-topbar {
      background: rgba(20, 23, 37, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .sb-topbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      height: 64px;
    }
    .sb-logo-link {
      display: flex;
      align-items: center;
      text-decoration: none;
      gap: 10px;
    }
    .sb-logo-link img.sb-logo-icon {
      height: 36px;
      width: 36px;
    }
    .sb-logo-link img.sb-logo-text {
      height: 22px;
    }
    .sb-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .sb-nav li a {
      font-family: 'BebasNeue', sans-serif;
      font-size: 15px;
      letter-spacing: 0.8px;
      color: rgba(255,255,255,0.55);
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sb-nav li a:hover {
      color: #fff;
      background: rgba(255,255,255,0.07);
    }
    .sb-nav li a.sb-nav-active {
      color: #fff;
      background: rgba(231, 76, 60, 0.15);
    }
    .sb-nav li a i {
      font-size: 13px;
      opacity: 0.7;
    }
    .sb-nav li.sb-nav-divider {
      width: 1px;
      height: 20px;
      background: rgba(255,255,255,0.08);
      margin: 0 4px;
    }
    .sb-nav li a.sb-nav-logout {
      color: rgba(255,255,255,0.35);
      font-size: 13px;
    }
    .sb-nav li a.sb-nav-logout:hover {
      color: #fc8181;
      background: rgba(245,101,101,0.1);
    }
    .sb-mobile-toggle {
      display: none;
      background: none;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 8px;
      padding: 8px 12px;
      cursor: pointer;
      color: white;
      font-size: 18px;
    }
    @media(max-width: 991px) {
      .sb-mobile-toggle { display: block; }
      .sb-nav {
        display: none;
        position: absolute;
        top: 64px;
        left: 0;
        right: 0;
        background: rgba(20, 23, 37, 0.98);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        flex-direction: column;
        padding: 12px 16px;
        gap: 2px;
      }
      .sb-nav.sb-nav-open { display: flex; }
      .sb-nav li a {
        font-size: 18px;
        padding: 14px 16px;
        width: 100%;
      }
      .sb-nav li.sb-nav-divider {
        width: 100%;
        height: 1px;
        margin: 4px 0;
      }
    }
    .sb-footer {
      background: #0d0f1a;
      border-top: 1px solid rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.4);
      padding: 40px 0 24px;
    }
    .sb-footer h4 {
      color: rgba(255,255,255,0.8);
      font-family: 'BebasNeue', sans-serif;
      font-size: 18px;
      letter-spacing: 1px;
      margin: 0 0 14px;
    }
    .sb-footer a {
      color: rgba(255,255,255,0.4);
      text-decoration: none;
      transition: color 0.2s;
    }
    .sb-footer a:hover {
      color: rgba(255,255,255,0.8);
    }
    .sb-footer-grid {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 40px;
    }
    @media(max-width: 767px) {
      .sb-footer-grid { grid-template-columns: 1fr; gap: 24px; }
    }
    .sb-footer-links {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .sb-footer-links li { margin-bottom: 8px; }
    .sb-footer-links li a { font-size: 13px; }
    .sb-footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 24px 0;
      margin-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.04);
      text-align: center;
      font-size: 12px;
    }
  </style>
</head>
<body style="background: #0f1120; margin: 0;">

  <nav class="sb-topbar">
    <div class="sb-topbar-inner">
      <%= link_to root_path, class: 'sb-logo-link' do %>
        <%= image_tag 'logo.png', class: 'sb-logo-icon' %>
        <%= image_tag 'sportsbeep.png', class: 'sb-logo-text hidden-xs' %>
      <% end %>

      <button class="sb-mobile-toggle" onclick="document.getElementById('sb-main-nav').classList.toggle('sb-nav-open')">
        <i class="fa fa-bars"></i>
      </button>

      <ul class="sb-nav" id="sb-main-nav">
        <% if current_user %>
          <li><%= link_to user_dashboard_path, class: ('sb-nav-active' if controller_name == 'dashboard' && action_name == 'index') do %><i class="fa fa-grid-2"></i> DASHBOARD<% end %></li>
          <li><%= link_to sportsbook_path, class: ('sb-nav-active' if controller_name == 'sportsbook') do %><i class="fa fa-trophy"></i> SPORTSBOOK<% end %></li>
          <li><%= link_to my_bets_path, class: ('sb-nav-active' if controller_name == 'sportsbook' && action_name == 'my_bets') do %><i class="fa fa-receipt"></i> MY BETS<% end %></li>
          <li class="sb-nav-divider"></li>
          <li>
            <%= link_to wallet_path, class: ('sb-nav-active' if action_name == 'wallet' || action_name == 'vending') do %>
              <i class="fa fa-wallet"></i> WALLET
              <% if current_user.cardano_wallet_address.present? %>
                <span style="display: inline-block; background: rgba(72,187,120,0.25); color: #68d391; font-size: 10px; padding: 1px 6px; border-radius: 10px; margin-left: 4px; font-weight: 700;">1</span>
              <% end %>
            <% end %>
          </li>
          <li class="sb-nav-divider"></li>
          <li><%= link_to destroy_user_session_path, method: :delete, class: 'sb-nav-logout' do %><i class="fa fa-arrow-right-from-bracket"></i> LOGOUT<% end %></li>
        <% else %>
          <li><%= link_to new_user_registration_path do %><i class="fa fa-user-plus"></i> SIGN UP<% end %></li>
          <li><%= link_to new_user_session_path do %><i class="fa fa-right-to-bracket"></i> LOGIN<% end %></li>
        <% end %>
      </ul>
    </div>
  </nav>

  <%= yield %>

  <% if current_user %>
    <%= render 'shared/wallet_connect_js' %>
  <% end %>

  <footer class="sb-footer">
    <div class="sb-footer-grid">
      <div>
        <h4>SPORTSBEEP</h4>
        <p style="font-size: 13px; line-height: 1.6; margin: 0;">
          Powered by <a href="https://ladmedia.co" target="_blank" style="text-decoration: underline;">LAD MEDIA</a><br>
          Sportsbook on Cardano.
        </p>
      </div>
      <div>
        <h4>LEGAL</h4>
        <ul class="sb-footer-links">
          <li><a href="/how-to-play">How to Play</a></li>
          <li><a href="/tos">Terms of Service</a></li>
          <li><a href="/privacy_policy">Privacy Policy</a></li>
          <li><a href="/refund_policy">Refund Policy</a></li>
        </ul>
      </div>
      <div>
        <h4>CONNECT</h4>
        <ul class="sb-footer-links">
          <li><a href="https://discord.gg/sportsbeep" target="_blank"><i class="fa-brands fa-discord" style="width: 18px; color: #5865F2;"></i> Discord</a></li>
          <li><a href="https://t.me/sportsbeep" target="_blank"><i class="fa-brands fa-telegram" style="width: 18px; color: #0088cc;"></i> Telegram</a></li>
          <li><a href="https://twitter.com/playsportsbeep" target="_blank"><i class="fa-brands fa-x-twitter" style="width: 18px;"></i> @playsportsbeep</a></li>
        </ul>
      </div>
    </div>
    <div class="sb-footer-bottom">
      <p style="margin: 0;">&copy; <%= Date.today.year %> Beep Communications, Inc. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
