<!DOCTYPE html>
<html>
<head>
  <title>Sportsbeep - Bet on the beep!</title>
  <%= stylesheet_link_tag "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%= csrf_meta_tags %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Font Awesome 6 for modern social media icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <%= render 'shared/google_analytics' %>
</head>
<body class="landing-page">
<div class="container">
  <div class="row">
    <%= yield %>
  </div>
</div>

<footer style="background-color: #2c3e50; color: #bdc3c7; padding: 30px 0; margin-top: 0;">
  <div class="container">
    <div class="row">
      <div class="col-xs-12 col-sm-4">
        <h4 style="color: white;">SportsBeep</h4>
        <p><small>Powered by <a href="https://ladmedia.co" target="_blank" style="color: #ecf0f1; text-decoration: underline;">LAD MEDIA</a><br>Fantasy sports on the Cardano blockchain.</small></p>
      </div>
      <div class="col-xs-12 col-sm-4">
        <h4 style="color: white;">Links</h4>
        <ul class="list-unstyled" style="line-height: 2;">
          <li><a href="/how-to-play" style="color: #bdc3c7;">How to Play</a></li>
          <li><a href="/tos" style="color: #bdc3c7;">Terms of Service</a></li>
          <li><a href="/privacy_policy" style="color: #bdc3c7;">Privacy Policy</a></li>
          <li><a href="/refund_policy" style="color: #bdc3c7;">Refund Policy</a></li>
        </ul>
      </div>
      <div class="col-xs-12 col-sm-4">
        <h4 style="color: white;">Connect</h4>
        <ul class="list-unstyled" style="line-height: 2.4;">
          <li><a href="https://discord.gg/sportsbeep" target="_blank" style="color: #bdc3c7; text-decoration: none;"><i class="fa-brands fa-discord" style="width: 22px; color: #5865F2; font-size: 16px;"></i> Discord</a></li>
          <li><a href="https://t.me/sportsbeep" target="_blank" style="color: #bdc3c7; text-decoration: none;"><i class="fa-brands fa-telegram" style="width: 22px; color: #0088cc; font-size: 16px;"></i> Telegram</a></li>
          <li><a href="https://twitter.com/playsportsbeep" target="_blank" style="color: #bdc3c7; text-decoration: none;"><i class="fa-brands fa-x-twitter" style="width: 22px; color: #fff; font-size: 16px;"></i> @playsportsbeep</a></li>
        </ul>
      </div>
    </div>
    <hr style="border-color: #4a6274;">
    <div class="text-center">
      <p><small>&copy; <%= Date.today.year %> Beep Communications, Inc. All rights reserved. | 32948 Edgewater Cove, Milsboro, DE 19966</small></p>
    </div>
  </div>
</footer>

</body>
</html>
