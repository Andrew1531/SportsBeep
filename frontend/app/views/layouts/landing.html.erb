<!DOCTYPE html>
<html>
<head>
  <title>Sportsbeep - Bet on the beep!</title>
  <%= stylesheet_link_tag "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%= csrf_meta_tags %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Font Awesome 6 for modern social media icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <%= render 'shared/google_analytics' %>
</head>
<body class="landing-page">
<div class="container">
  <div class="row">
    <%= yield %>
  </div>
</div>

<footer class="landing-footer" id="contact-us">
  <div class="landing-footer__inner">
    <div class="landing-footer__brand">
      <%= link_to root_path, class: 'landing-footer__brand-lockup', aria: { label: 'SportsBeep home' } do %>
        <%= image_tag 'logo-md.png', class: 'landing-footer__logo', alt: 'SportsBeep' %>
      <% end %>
      <p>Next-generation sports engagement, built on Cardano.</p>
      <nav class="landing-footer__socials" aria-label="SportsBeep social channels">
        <a href="https://twitter.com/playsportsbeep" target="_blank" rel="noopener noreferrer" aria-label="Follow SportsBeep on X"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
        <a href="https://discord.gg/sportsbeep" target="_blank" rel="noopener noreferrer" aria-label="Join SportsBeep on Discord"><i class="fa-brands fa-discord" aria-hidden="true"></i></a>
        <a href="https://t.me/sportsbeep" target="_blank" rel="noopener noreferrer" aria-label="Join SportsBeep on Telegram"><i class="fa-brands fa-telegram" aria-hidden="true"></i></a>
      </nav>
    </div>

    <nav class="landing-footer__nav" aria-label="Footer navigation">
      <h2>Navigation</h2>
      <ul>
        <li><%= link_to 'About SportsBeep', '#about-us' %></li>
        <li><%= link_to 'Play SportsBeep', play_path %></li>
        <li><%= link_to 'How to Play', '/how-to-play' %></li>
        <li><%= link_to 'Terms of Service', '/tos' %></li>
        <li><%= link_to 'Privacy Policy', privacy_policy_path %></li>
        <li><%= link_to 'Refund Policy', refund_policy_path %></li>
      </ul>
    </nav>

    <section class="landing-footer__legal" aria-labelledby="footer-disclaimer-title">
      <h2 id="footer-disclaimer-title">Legal Disclaimer</h2>
      <p><strong>Risk warning:</strong> Digital assets can be volatile. Only participate with funds you can afford to lose.</p>
      <p><strong>Player responsibility:</strong> You are solely responsible for the security of your Cardano wallet. Never share your seed phrase.</p>
      <p><strong>Availability:</strong> SportsBeep services and game access may vary by location and are subject to applicable terms.</p>
    </section>
  </div>

  <div class="landing-footer__bottom">
    <div class="landing-footer__bottom-inner">
      <div class="landing-footer__utility">
        <span>&copy; <%= Date.today.year %> SportsBeep. All rights reserved.</span>
        <%= link_to 'Privacy Policy', privacy_policy_path %>
        <span>Cookie preferences</span>
      </div>
      <div class="landing-footer__credits">
        <span>Designed and engineered by <a href="https://ladmedia.co" target="_blank" rel="noopener noreferrer">LAD MEDIA</a></span>
        <a class="landing-footer__help" href="tel:18004263537">1-800-GAMBLER</a>
      </div>
    </div>
  </div>
</footer>

</body>
</html>
