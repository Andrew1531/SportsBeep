<%
  home_name   = @game.home_team.to_s
  away_name   = @game.away_team.to_s
  away_city, away_mascot = split_team_name(away_name)
  home_city,  home_mascot = split_team_name(home_name)
  away_color  = team_color(away_name, 0)
  home_color  = team_color(home_name, 0)
  game_date   = @game.start_time.in_time_zone('Eastern Time (US & Canada)')

  def proj(seed, lo, hi, dec = 0)
    r = (seed * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFF
    val = lo + (r % ((hi - lo) * (10**dec) + 1)).to_f / (10**dec)
    dec == 0 ? val.to_i : val.round(dec)
  end
%>

<style>
  .bb-page { background: #0b0e14; min-height: 100vh; padding-bottom: 140px; }
  .bb-header { background: linear-gradient(135deg, #0d1117 0%, #131a24 100%); border-bottom: 1px solid #1e2d40; padding: 16px 0 0; }
  .bb-matchup { display: flex; align-items: center; justify-content: center; gap: 24px; padding: 20px 0 16px; }
  .bb-team { text-align: center; min-width: 120px; }
  .bb-team-city { font-size: 11px; color: #6b7a8f; text-transform: uppercase; letter-spacing: 1px; }
  .bb-team-name { font-family: 'BebasNeue', 'Impact', sans-serif; font-size: 30px; color: #fff; line-height: 1; }
  .bb-vs { font-size: 14px; color: #4a5568; font-weight: 700; letter-spacing: 2px; }
  .bb-game-time { text-align: center; font-size: 12px; color: #6b7a8f; padding-bottom: 14px; }
  .bb-tab-bar { display: flex; border-top: 1px solid #1e2d40; }
  .bb-tab { flex: 1; text-align: center; padding: 10px 0; font-size: 12px; font-weight: 700; color: #4a5568; cursor: pointer; border-bottom: 2px solid transparent; transition: all .2s; text-transform: uppercase; letter-spacing: 1px; }
  .bb-tab.active { color: #00c853; border-bottom-color: #00c853; }

  .bb-body { max-width: 700px; margin: 0 auto; padding: 16px; }
  .section-label { font-size: 11px; font-weight: 700; color: #4a5568; text-transform: uppercase; letter-spacing: 2px; margin: 20px 0 10px; }

  .contest-cards { display: flex; flex-direction: column; gap: 8px; margin-bottom: 8px; }
  .contest-card { background: #131a24; border: 2px solid #1e2d40; border-radius: 10px; padding: 14px 16px; cursor: pointer; transition: all .2s; display: flex; align-items: center; justify-content: space-between; }
  .contest-card:hover { border-color: #2d4a6e; }
  .contest-card.selected { border-color: #00c853; background: #0a1f10; }
  .contest-card input[type="radio"] { display: none; }
  .cc-name { font-size: 13px; font-weight: 700; color: #e2e8f0; }
  .cc-meta { font-size: 11px; color: #6b7a8f; margin-top: 2px; }
  .cc-prize { text-align: right; }
  .cc-prize-amount { font-size: 18px; font-weight: 900; color: #00c853; font-family: 'BebasNeue', 'Impact', sans-serif; }
  .cc-prize-label { font-size: 10px; color: #4a5568; text-transform: uppercase; }

  .filter-bar { display: flex; gap: 8px; margin-bottom: 14px; }
  .filter-btn { background: #131a24; border: 1px solid #1e2d40; border-radius: 20px; padding: 6px 14px; font-size: 12px; font-weight: 700; color: #6b7a8f; cursor: pointer; transition: all .2s; }
  .filter-btn.active { background: #1e2d40; border-color: #3767ab; color: #fff; }

  .players-list { display: flex; flex-direction: column; gap: 6px; }
  .player-card { background: #131a24; border: 1px solid #1e2d40; border-radius: 10px; overflow: hidden; transition: border-color .2s; }
  .player-card.picked-best { border-color: #00c853; background: #071a0c; }
  .player-card.picked-bust { border-color: #ef4444; background: #1a0707; }
  .player-row-top { display: flex; align-items: center; padding: 12px 14px; cursor: pointer; gap: 12px; }
  .player-pos { font-size: 11px; font-weight: 700; color: #4a5568; width: 30px; text-transform: uppercase; }
  .player-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 900; color: #fff; flex-shrink: 0; }
  .player-info { flex: 1; min-width: 0; }
  .player-name { font-size: 14px; font-weight: 700; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .player-team-abbr { font-size: 11px; color: #6b7a8f; margin-top: 1px; }
  .player-stats { display: flex; gap: 12px; align-items: center; flex-shrink: 0; }
  .stat-pill { text-align: center; }
  .stat-val { font-size: 14px; font-weight: 700; color: #c5d0de; }
  .stat-lbl { font-size: 9px; color: #4a5568; text-transform: uppercase; }
  .player-pick-badge { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; flex-shrink: 0; }
