  .player-actions { display: flex; gap: 8px; padding: 0 14px 12px; }
  .pick-btn { flex: 1; padding: 10px 0; border-radius: 8px; font-size: 13px; font-weight: 800; border: none; cursor: pointer; transition: all .2s; text-transform: uppercase; letter-spacing: 1px; }
  .pick-btn-best { background: #00c853; color: #000; }
  .pick-btn-best:hover { background: #00e85e; }
  .pick-btn-best.selected { background: #00c853; box-shadow: 0 0 0 2px #00c853, 0 0 16px rgba(0,200,83,.4); }
  .pick-btn-bust { background: #ef4444; color: #fff; }
  .pick-btn-bust:hover { background: #ff5555; }
  .pick-btn-bust.selected { background: #ef4444; box-shadow: 0 0 0 2px #ef4444, 0 0 16px rgba(239,68,68,.4); }
  .pick-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .player-card.hidden { display: none; }

  .picks-panel { position: fixed; bottom: 0; left: 0; right: 0; background: #0d1520; border-top: 1px solid #1e2d40; z-index: 100; padding: 12px 16px; box-shadow: 0 -8px 32px rgba(0,0,0,.7); }
  .picks-slots { display: flex; gap: 6px; margin-bottom: 10px; }
  .pick-slot { flex: 1; border-radius: 8px; padding: 8px 4px; text-align: center; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: all .2s; }
  .pick-slot-best-empty { border: 1px dashed #00c853; background: rgba(0,200,83,.04); color: #00c853; }
  .pick-slot-bust-empty { border: 1px dashed #ef4444; background: rgba(239,68,68,.04); color: #ef4444; }
  .pick-slot-filled-best { background: rgba(0,200,83,.12); border: 1px solid #00c853; color: #00c853; }
  .pick-slot-filled-bust { background: rgba(239,68,68,.12); border: 1px solid #ef4444; color: #ef4444; }
  .pick-slot-name { font-size: 10px; color: #e2e8f0; font-weight: 700; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .pick-slot-label { font-size: 9px; letter-spacing: 1px; }
  .submit-btn { width: 100%; padding: 14px; background: #00c853; border: none; border-radius: 10px; font-size: 16px; font-weight: 900; color: #000; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all .2s; font-family: 'BebasNeue', 'Impact', sans-serif; }
  .submit-btn:hover { background: #00e85e; box-shadow: 0 0 24px rgba(0,200,83,.4); }
  .submit-btn:disabled { background: #1e2d40; color: #4a5568; cursor: not-allowed; }

  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .no-players-box { text-align: center; padding: 40px 20px; color: #4a5568; }
  .back-link { margin-top: 20px; }
  .back-btn { color: #6b7a8f; font-size: 13px; text-decoration: none; }
  .back-btn:hover { color: #e2e8f0; }
</style>

<div class="bb-page">
  <div class="bb-header">
    <div class="bb-matchup">
      <div class="bb-team" style="text-align: right;">
        <div class="bb-team-city"><%= away_city %></div>
        <div class="bb-team-name" style="color: <%= away_color %>;"><%= away_mascot %></div>
      </div>
      <div>
        <div class="bb-vs">@</div>
        <div style="font-size: 10px; color: #3a4a5c; text-transform: uppercase; letter-spacing: 1px; text-align: center;">Away</div>
      </div>
      <div class="bb-team" style="text-align: left;">
        <div class="bb-team-city"><%= home_city %></div>
        <div class="bb-team-name" style="color: <%= home_color %>;"><%= home_mascot %></div>
      </div>
    </div>
    <div class="bb-game-time">
      <%= game_date.strftime('%A, %B %-d') %> &nbsp;·&nbsp; <%= game_date.strftime('%-I:%M %p ET') %>
    </div>
    <div class="bb-tab-bar">
      <div class="bb-tab active" data-tab="pick">Pick Players</div>
      <div class="bb-tab" data-tab="contests">Contests</div>
    </div>
  </div>

  <div class="bb-body">

    <%# ===== TAB: PICK PLAYERS ===== %>
    <div class="tab-content active" id="tab-pick">
      <div class="section-label">How to Play — Best/Bust</div>
      <div style="background: #131a24; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; display: flex; gap: 20px;">
        <div style="flex: 1; text-align: center;">
          <div style="font-size: 24px; margin-bottom: 4px;">🔥</div>
          <div style="font-size: 13px; font-weight: 800; color: #00c853; margin-bottom: 4px;">3 BEST</div>
          <div style="font-size: 11px; color: #6b7a8f;">Pick 3 players you think will perform the <strong style="color:#c5d0de">best</strong> today</div>
        </div>
        <div style="width: 1px; background: #1e2d40;"></div>
        <div style="flex: 1; text-align: center;">
          <div style="font-size: 24px; margin-bottom: 4px;">💀</div>
          <div style="font-size: 13px; font-weight: 800; color: #ef4444; margin-bottom: 4px;">3 BUST</div>
          <div style="font-size: 11px; color: #6b7a8f;">Pick 3 players you think will <strong style="color:#c5d0de">underperform</strong> today</div>
        </div>
      </div>

      <div class="filter-bar">
        <button class="filter-btn active" data-filter="all">All Players</button>
        <button class="filter-btn" data-filter="away" style="border-color: <%= away_color %>20; color: <%= away_color %>;"><%= away_mascot %></button>
        <button class="filter-btn" data-filter="home" style="border-color: <%= home_color %>20; color: <%= home_color %>;"><%= home_mascot %></button>
      </div>

      <% if @players.present? %>
        <div class="players-list" id="playersList">
          <% @players.each do |player| %>
            <%
              is_home   = player.team_id == @game.home_team_id
              p_color   = is_home ? home_color : away_color
              p_abbr    = player.team&.abbr || (is_home ? 'HM' : 'AW')
              seed      = player.id.to_i

              if player.position.in?(%w[SP RP P])
                s1_val = proj(seed,       2.00, 5.00, 2); s1_lbl = 'ERA'
                s2_val = proj(seed + 1,   3, 12);          s2_lbl = 'K'
                s3_val = proj(seed + 2,   1, 7);            s3_lbl = 'IP'
              else
                s1_val = proj(seed,       0.200, 0.380, 3); s1_lbl = 'AVG'
                s2_val = proj(seed + 1,   0, 3);             s2_lbl = 'HR'
                s3_val = proj(seed + 2,   0, 4);             s3_lbl = 'RBI'
              end

              initials = player.name.split(' ').map { |p| p[0] }.first(2).join
            %>
            <div class="player-card" id="pc-<%= player.id %>"
                 data-player-id="<%= player.id %>"
                 data-player-name="<%= h(player.name) %>"
                 data-team="<%= is_home ? 'home' : 'away' %>">
              <div class="player-row-top" onclick="togglePlayer(<%= player.id %>)">
                <span class="player-pos"><%= player.position %></span>
                <div class="player-avatar" style="background: <%= p_color %>20; border: 1px solid <%= p_color %>40; color: <%= p_color %>;">
                  <%= initials %>
                </div>
                <div class="player-info">
                  <div class="player-name"><%= player.name %></div>
                  <div class="player-team-abbr" style="color: <%= p_color %>"><%= p_abbr %></div>
                </div>
                <div class="player-stats">
                  <div class="stat-pill"><div class="stat-val"><%= s1_val %></div><div class="stat-lbl"><%= s1_lbl %></div></div>
                  <div class="stat-pill"><div class="stat-val"><%= s2_val %></div><div class="stat-lbl"><%= s2_lbl %></div></div>
                  <div class="stat-pill"><div class="stat-val"><%= s3_val %></div><div class="stat-lbl"><%= s3_lbl %></div></div>
                </div>
                <div class="player-pick-badge pick-badge-none" id="badge-<%= player.id %>"></div>
              </div>
              <div class="player-actions" id="actions-<%= player.id %>" style="display: none;">
                <button class="pick-btn pick-btn-best" id="best-btn-<%= player.id %>"
                        onclick="pickPlayer(<%= player.id %>, '<%= h(player.name) %>', 'best')">
                  🔥 Best Pick
                </button>
                <button class="pick-btn pick-btn-bust" id="bust-btn-<%= player.id %>"
                        onclick="pickPlayer(<%= player.id %>, '<%= h(player.name) %>', 'bust')">
                  💀 Bust Pick
                </button>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="no-players-box">
          <div style="font-size: 40px; margin-bottom: 12px;">⚾</div>
          <p style="color: #c5d0de; font-weight: 700;">No roster loaded yet</p>
          <p style="font-size: 13px; color: #4a5568;">Lineups will be imported from TheSportsDB closer to game time.</p>
          <p style="font-size: 12px; color: #3a4a5c; margin-top: 8px;">You can still browse contests in the Contests tab.</p>
        </div>
      <% end %>
    </div>

    <%# ===== TAB: CONTESTS ===== %>
    <div class="tab-content" id="tab-contests">
      <div class="section-label">Select a Contest to Enter</div>
      <% if @contests.present? %>
        <div class="contest-cards" id="contestCards">
          <% @contests.each do |contest| %>
            <% pool = contest.template&.pool %>
            <label class="contest-card" for="contest-<%= contest.id %>" id="cc-<%= contest.id %>"
                   onclick="selectContest(<%= contest.id %>)">
              <input type="radio" name="selected_contest" id="contest-<%= contest.id %>"
                     value="<%= contest.id %>">
              <div>
                <div class="cc-name">
                  <% if pool&.entry_fee_multiplier == 0 %>
                    🆓 Free Contest
                  <% elsif pool&.prize_pool.to_i >= 2000 %>
                    💎 Pro Contest
                  <% else %>
                    ⭐ Starter Contest
                  <% end %>
                </div>
                <div class="cc-meta">
                  <span><%= contest.tickets_count || 0 %> / <%= pool&.max_tickets_per_contest || '?' %> entered</span>
                  &nbsp;·&nbsp;
                  <span><%= pool ? "#{pool.entry_fee.round(2)} $BEEP entry" : 'Free' %></span>
                </div>
              </div>
              <div class="cc-prize">
                <div class="cc-prize-amount"><%= pool&.prize_pool.to_i || 0 %></div>
                <div class="cc-prize-label">$BEEP Prize</div>
              </div>
            </label>
          <% end %>
        </div>
      <% else %>
        <div class="no-players-box">
          <div style="font-size: 40px; margin-bottom: 12px;">🏆</div>
          <p style="color: #c5d0de;">No contests for this game yet.</p>
        </div>
      <% end %>
      <div style="margin-top: 12px; padding: 12px 14px; background: #131a24; border-radius: 10px; font-size: 12px; color: #6b7a8f;">
        <strong style="color: #c5d0de;">Balance:</strong> <%= @account.balance rescue 0 %> $BEEP &nbsp;·&nbsp;
        <strong style="color: #c5d0de;">Required:</strong> Select a contest above
      </div>
    </div>

    <div class="back-link">
      <%= link_to '← Back to Games', fantasy_path(sport: @sport), class: 'back-btn' %>
    </div>

  </div>
</div>

<%# ===== FLOATING PICKS PANEL ===== %>
<%= form_tag fantasy_enter_contest_path, method: :post, id: 'pickForm' do %>
  <input type="hidden" name="contest_id" id="hidden_contest_id" value="">
  <div id="picksPanel" class="picks-panel">
    <div class="picks-slots" id="picksSlots">
      <div class="pick-slot pick-slot-best-empty" id="slot-best-0"><div class="pick-slot-label">🔥 Best</div><div style="font-size: 9px; color: #00c853; margin-top: 2px;">Empty</div></div>
      <div class="pick-slot pick-slot-best-empty" id="slot-best-1"><div class="pick-slot-label">🔥 Best</div><div style="font-size: 9px; color: #00c853; margin-top: 2px;">Empty</div></div>
      <div class="pick-slot pick-slot-best-empty" id="slot-best-2"><div class="pick-slot-label">🔥 Best</div><div style="font-size: 9px; color: #00c853; margin-top: 2px;">Empty</div></div>
      <div class="pick-slot pick-slot-bust-empty" id="slot-bust-0"><div class="pick-slot-label">💀 Bust</div><div style="font-size: 9px; color: #ef4444; margin-top: 2px;">Empty</div></div>
      <div class="pick-slot pick-slot-bust-empty" id="slot-bust-1"><div class="pick-slot-label">💀 Bust</div><div style="font-size: 9px; color: #ef4444; margin-top: 2px;">Empty</div></div>
      <div class="pick-slot pick-slot-bust-empty" id="slot-bust-2"><div class="pick-slot-label">💀 Bust</div><div style="font-size: 9px; color: #ef4444; margin-top: 2px;">Empty</div></div>
    </div>
    <button class="submit-btn" id="submitBtn" disabled type="submit">
      Select Contest + 6 Picks to Enter
    </button>
  </div>
<% end %>

<script>
var bestPicks  = {};  // id -> name
var bustPicks  = {};  // id -> name
var allPicks   = {};  // id -> 'best'|'bust'
var selectedContest = null;
var expandedPlayer  = null;

function togglePlayer(id) {
  var actions = document.getElementById('actions-' + id);
  if (!actions) return;
  if (expandedPlayer && expandedPlayer !== id) {
    var prev = document.getElementById('actions-' + expandedPlayer);
    if (prev) prev.style.display = 'none';
  }
  var opening = (actions.style.display === 'none' || !actions.style.display);
  actions.style.display = opening ? 'flex' : 'none';
  expandedPlayer = opening ? id : null;
  if (opening) {
    setTimeout(function() {
      var card = document.getElementById('pc-' + id);
      if (card) {
        var rect = card.getBoundingClientRect();
        var panelHeight = 160;
        var viewportBottom = window.innerHeight - panelHeight;
        if (rect.bottom > viewportBottom) {
          window.scrollBy({ top: rect.bottom - viewportBottom + 8, behavior: 'smooth' });
        }
      }
    }, 50);
  }
}

function pickPlayer(id, name, type) {
  var opposite = type === 'best' ? 'bust' : 'best';

  if (allPicks[id] === type) {
    delete allPicks[id];
    if (type === 'best') delete bestPicks[id];
    else delete bustPicks[id];
    updateCardState(id, null);
    updateSlots();
    updateSubmit();
    return;
  }

  if (allPicks[id] === opposite) {
    if (opposite === 'best') delete bestPicks[id];
    else delete bustPicks[id];
  }

  if (type === 'best' && Object.keys(bestPicks).length >= 3) {
    alert('You already have 3 BEST picks. Remove one first.');
    return;
  }
  if (type === 'bust' && Object.keys(bustPicks).length >= 3) {
    alert('You already have 3 BUST picks. Remove one first.');
    return;
  }

  allPicks[id] = type;
  if (type === 'best') bestPicks[id] = name;
  else bustPicks[id] = name;

  updateCardState(id, type);
  updateSlots();
  updateSubmit();

  var actions = document.getElementById('actions-' + id);
  if (actions) actions.style.display = 'none';
  expandedPlayer = null;
}

function updateCardState(id, type) {
  var card = document.getElementById('pc-' + id);
  var badge = document.getElementById('badge-' + id);
  var bestBtn = document.getElementById('best-btn-' + id);
  var bustBtn = document.getElementById('bust-btn-' + id);
  if (!card) return;

  card.classList.remove('picked-best', 'picked-bust');
  badge.innerHTML = '';
  badge.className = 'player-pick-badge pick-badge-none';
  if (bestBtn) { bestBtn.classList.remove('selected'); bestBtn.textContent = '🔥 Best Pick'; }
  if (bustBtn) { bustBtn.classList.remove('selected'); bustBtn.textContent = '💀 Bust Pick'; }

  if (type === 'best') {
    card.classList.add('picked-best');
    badge.className = 'player-pick-badge pick-badge-best';
    badge.innerHTML = '🔥';
    if (bestBtn) { bestBtn.classList.add('selected'); bestBtn.textContent = '✓ Best Picked'; }
  } else if (type === 'bust') {
    card.classList.add('picked-bust');
    badge.className = 'player-pick-badge pick-badge-bust';
    badge.innerHTML = '💀';
    if (bustBtn) { bustBtn.classList.add('selected'); bustBtn.textContent = '✓ Bust Picked'; }
  }
}

function updateSlots() {
  var bestArr = Object.entries(bestPicks);
  var bustArr = Object.entries(bustPicks);
  for (var i = 0; i < 3; i++) {
    var bSlot = document.getElementById('slot-best-' + i);
    if (bestArr[i]) {
      bSlot.className = 'pick-slot pick-slot-filled-best';
      bSlot.innerHTML = '<div class="pick-slot-label">🔥 BEST</div><div class="pick-slot-name">' + escHtml(bestArr[i][1]) + '</div>';
    } else {
      bSlot.className = 'pick-slot pick-slot-best-empty';
      bSlot.innerHTML = '<div class="pick-slot-label">🔥 Best</div><div style="font-size:9px;color:#00c853;margin-top:2px">Empty</div>';
    }
    var uSlot = document.getElementById('slot-bust-' + i);
    if (bustArr[i]) {
      uSlot.className = 'pick-slot pick-slot-filled-bust';
      uSlot.innerHTML = '<div class="pick-slot-label">💀 BUST</div><div class="pick-slot-name">' + escHtml(bustArr[i][1]) + '</div>';
    } else {
      uSlot.className = 'pick-slot pick-slot-bust-empty';
      uSlot.innerHTML = '<div class="pick-slot-label">💀 Bust</div><div style="font-size:9px;color:#ef4444;margin-top:2px">Empty</div>';
    }
  }
  updateHiddenInputs();
}

function updateHiddenInputs() {
  document.querySelectorAll('input[name="best_player_ids[]"]').forEach(function(e) { e.remove(); });
  document.querySelectorAll('input[name="bust_player_ids[]"]').forEach(function(e) { e.remove(); });
  var form = document.getElementById('pickForm');
  Object.keys(bestPicks).forEach(function(id) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'best_player_ids[]'; inp.value = id;
    form.appendChild(inp);
  });
  Object.keys(bustPicks).forEach(function(id) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'bust_player_ids[]'; inp.value = id;
    form.appendChild(inp);
  });
}

function updateSubmit() {
  var btn = document.getElementById('submitBtn');
  var bCnt = Object.keys(bestPicks).length;
  var uCnt = Object.keys(bustPicks).length;
  var ready = bCnt === 3 && uCnt === 3 && selectedContest;
  btn.disabled = !ready;
  if (!ready) {
    var parts = [];
    if (!selectedContest) parts.push('Select a Contest');
    if (bCnt < 3) parts.push((3 - bCnt) + ' more BEST pick' + (3 - bCnt !== 1 ? 's' : ''));
    if (uCnt < 3) parts.push((3 - uCnt) + ' more BUST pick' + (3 - uCnt !== 1 ? 's' : ''));
    btn.textContent = parts.join(' · ');
  } else {
    btn.textContent = '🏆 Enter Contest';
  }
}

function selectContest(id) {
  selectedContest = id;
  document.getElementById('hidden_contest_id').value = id;
  document.querySelectorAll('.contest-card').forEach(function(c) { c.classList.remove('selected'); });
  var cc = document.getElementById('cc-' + id);
  if (cc) cc.classList.add('selected');
  updateSubmit();
}

function escHtml(str) {
  return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// Tab switching
document.querySelectorAll('.bb-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('.bb-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
    this.classList.add('active');
    var target = document.getElementById('tab-' + this.dataset.tab);
    if (target) target.classList.add('active');
  });
});

// Player team filter
document.querySelectorAll('.filter-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
    this.classList.add('active');
    var filter = this.dataset.filter;
    document.querySelectorAll('.player-card').forEach(function(card) {
      if (filter === 'all' || card.dataset.team === filter) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });
});

document.getElementById('submitBtn').addEventListener('click', function(e) {
  if (!selectedContest) {
    e.preventDefault();
    document.querySelector('[data-tab="contests"]').click();
    alert('Please select a contest first from the Contests tab.');
    return;
  }
});
</script>
