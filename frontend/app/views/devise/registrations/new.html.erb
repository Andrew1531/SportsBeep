<div style="min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center; padding: 40px 15px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
  <div style="width: 100%; max-width: 500px;">
    <div style="text-align: center; margin-bottom: 30px;">
      <%= image_tag 'logo.png', height: '60px', width: '60px', style: 'margin-bottom: 10px;' %>
      <h2 style="color: white; font-weight: 700; margin: 0 0 5px 0; font-size: 28px;">Create Your Account</h2>
      <p style="color: #8892b0; margin: 0; font-size: 15px;">Join the future of fantasy sports on the blockchain</p>
    </div>

    <div style="background: white; border-radius: 12px; padding: 35px 30px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">

      <% if resource.errors.any? %>
        <div style="background: #fff5f5; border: 1px solid #fc8181; border-radius: 8px; padding: 12px 15px; margin-bottom: 20px;">
          <% resource.errors.full_messages.each do |message| %>
            <p style="color: #c53030; margin: 0 0 4px 0; font-size: 14px;"><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { style: 'margin: 0;' }) do |f| %>

        <div style="display: flex; gap: 12px; margin-bottom: 18px;">
          <div style="flex: 1;">
            <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">First Name</label>
            <%= f.input_field :first_name, required: true, autofocus: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px; transition: border-color 0.2s;', placeholder: 'First name' %>
          </div>
          <div style="flex: 1;">
            <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">Last Name</label>
            <%= f.input_field :last_name, required: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px; transition: border-color 0.2s;', placeholder: 'Last name' %>
          </div>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">Username</label>
          <%= f.input_field :username, required: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px;', placeholder: 'Choose a username' %>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">Email Address</label>
          <%= f.input_field :email, required: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px;', placeholder: 'you@example.com' %>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">Password</label>
          <%= f.input_field :password, required: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px;', placeholder: 'Minimum 6 characters' %>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 13px; color: #374151; margin-bottom: 5px;">Confirm Password</label>
          <%= f.input_field :password_confirmation, required: true, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #d1d5db; font-size: 15px;', placeholder: 'Re-enter your password' %>
        </div>

        <div style="margin-bottom: 22px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 14px;">
          <label style="display: block; font-weight: 600; font-size: 13px; color: #0369a1; margin-bottom: 5px;">Cardano Wallet Address <span style="font-weight: 400; color: #7dd3fc;">(Optional)</span></label>
          <%= f.input_field :cardano_wallet_address, required: false, class: 'form-control', style: 'border-radius: 8px; padding: 10px 14px; border: 1.5px solid #bae6fd; font-size: 14px; font-family: monospace;', placeholder: 'addr1...' %>
          <p style="margin: 6px 0 0 0; font-size: 12px; color: #0284c7;">Link your Cardano wallet to receive $BEEP token rewards</p>
        </div>

        <button type="submit" style="width: 100%; padding: 13px; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; transition: transform 0.1s, box-shadow 0.2s; box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);">
          Create Account
        </button>

      <% end %>

      <div style="text-align: center; margin-top: 20px; padding-top: 18px; border-top: 1px solid #e5e7eb;">
        <p style="color: #6b7280; font-size: 14px; margin: 0;">
          Already have an account?
          <%= link_to 'Sign in', new_session_path(resource_name), style: 'color: #e74c3c; font-weight: 600; text-decoration: none;' %>
        </p>
      </div>
    </div>

    <p style="text-align: center; color: #4a5568; font-size: 12px; margin-top: 20px;">
      By signing up, you agree to our
      <a href="/tos" style="color: #8892b0; text-decoration: underline;">Terms of Service</a>
      and
      <a href="/privacy_policy" style="color: #8892b0; text-decoration: underline;">Privacy Policy</a>
    </p>
  </div>
</div>
