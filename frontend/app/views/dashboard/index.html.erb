<div class="container" style="padding-top: 20px; padding-bottom: 60px;">

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible" role="alert">
      <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible" role="alert">
      <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <h2 style="color: #e74c3c; margin-top: 0;">
        Welcome back, <strong><%= @user.username %></strong>!
      </h2>
      <p class="text-muted">Your SportsBeep Dashboard</p>
    </div>
  </div>

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
      <div class="panel panel-primary text-center" style="border-color: #e74c3c;">
        <div class="panel-heading" style="background-color: #e74c3c; border-color: #e74c3c;">
          <h4 class="panel-title" style="color: white;">$BEEP Balance</h4>
        </div>
        <div class="panel-body">
          <h2 style="margin: 5px 0; color: #e74c3c;"><%= @account.balance rescue '$0.00' %></h2>
          <p class="text-muted"><small>Available Balance</small></p>
          <%= link_to 'View Wallet', wallet_path, class: 'btn btn-sm btn-default' %>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
      <div class="panel panel-info text-center">
        <div class="panel-heading">
          <h4 class="panel-title">Promo Balance</h4>
        </div>
        <div class="panel-body">
          <h2 style="margin: 5px 0;"><%= @account.promo_balance rescue '$0.00' %></h2>
          <p class="text-muted"><small>Promotional Credits</small></p>
          <%= link_to 'Redeem Code', redeem_promo_path, class: 'btn btn-sm btn-default' %>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
      <div class="panel panel-success text-center">
        <div class="panel-heading">
          <h4 class="panel-title">MLB Contests</h4>
        </div>
        <div class="panel-body">
          <h2 style="margin: 5px 0;"><%= @mlb_tickets.size %></h2>
          <p class="text-muted"><small>Recent Entries</small></p>
          <a href="#mlb-entries" class="btn btn-sm btn-default">View Entries</a>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
      <div class="panel panel-warning text-center">
        <div class="panel-heading">
          <h4 class="panel-title">NFL Contests</h4>
        </div>
        <div class="panel-body">
          <h2 style="margin: 5px 0;"><%= @nfl_tickets.size %></h2>
          <p class="text-muted"><small>Recent Entries</small></p>
          <a href="#nfl-entries" class="btn btn-sm btn-default">View Entries</a>
        </div>
      </div>
    </div>
  </div>

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <div class="well" style="background-color: #34495e; color: white; border: none;">
        <div class="row">
          <div class="col-xs-12 col-sm-6">
            <h4>Quick Actions</h4>
            <p>Jump right into the action!</p>
          </div>
          <div class="col-xs-12 col-sm-6 text-right" style="padding-top: 10px;">
            <%= link_to 'Browse Contests', '#', class: 'btn btn-danger btn-lg', style: 'margin-right: 10px;' %>
            <%= link_to 'How to Play', how_to_play_path, class: 'btn btn-default btn-lg' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @user.cardano_wallet_address.present? %>
    <div class="row" style="margin-bottom: 25px;">
      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4 class="panel-title"><i class="glyphicon glyphicon-link"></i> Cardano Wallet</h4>
          </div>
          <div class="panel-body">
            <p><strong>Wallet Address:</strong></p>
            <code style="word-break: break-all;"><%= @user.cardano_wallet_address %></code>
            <p class="text-muted" style="margin-top: 10px;"><small>Your $BEEP token rewards will be sent to this address.</small></p>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row" style="margin-bottom: 25px;">
      <div class="col-xs-12">
        <div class="alert alert-info">
          <i class="glyphicon glyphicon-info-sign"></i>
          <strong>Connect your Cardano wallet!</strong>
          Link your Cardano wallet address in your account settings to receive $BEEP token rewards.
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-xs-12 col-md-6" style="margin-bottom: 25px;">
      <div class="panel panel-default" id="mlb-entries">
        <div class="panel-heading">
          <h4 class="panel-title"><i class="glyphicon glyphicon-list"></i> Recent MLB Entries</h4>
        </div>
        <div class="panel-body">
          <% if @mlb_tickets.any? %>
            <table class="table table-condensed table-striped">
              <thead>
                <tr>
                  <th>Contest</th>
                  <th>Score</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% @mlb_tickets.each do |ticket| %>
                  <tr>
                    <td><%= ticket.contest.try(:name) || "Contest ##{ticket.contest_id}" %></td>
                    <td><%= ticket.score rescue 'N/A' %></td>
                    <td><%= ticket.created_at.strftime("%b %d, %Y") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center" style="padding: 20px;">No MLB contest entries yet. Browse contests to get started!</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-xs-12 col-md-6" style="margin-bottom: 25px;">
      <div class="panel panel-default" id="nfl-entries">
        <div class="panel-heading">
          <h4 class="panel-title"><i class="glyphicon glyphicon-list"></i> Recent NFL Entries</h4>
        </div>
        <div class="panel-body">
          <% if @nfl_tickets.any? %>
            <table class="table table-condensed table-striped">
              <thead>
                <tr>
                  <th>Contest</th>
                  <th>Score</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% @nfl_tickets.each do |ticket| %>
                  <tr>
                    <td><%= ticket.contest.try(:name) || "Contest ##{ticket.contest_id}" %></td>
                    <td><%= ticket.score rescue 'N/A' %></td>
                    <td><%= ticket.created_at.strftime("%b %d, %Y") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center" style="padding: 20px;">No NFL contest entries yet. Browse contests to get started!</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h4 class="panel-title"><i class="glyphicon glyphicon-transfer"></i> Recent Transactions</h4>
        </div>
        <div class="panel-body">
          <% if @recent_transactions.any? %>
            <table class="table table-condensed table-striped">
              <thead>
                <tr>
                  <th>Description</th>
                  <th class="text-right">Amount</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_transactions.each do |txn| %>
                  <tr>
                    <td><%= txn.description %></td>
                    <td class="text-right"><%= txn.amount %></td>
                    <td><%= txn.created_at.strftime("%b %d, %Y") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <%= link_to 'View All Transactions', user_transactions_path, class: 'btn btn-sm btn-default' %>
          <% else %>
            <p class="text-muted text-center" style="padding: 20px;">No transactions yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h4 class="panel-title"><i class="glyphicon glyphicon-user"></i> Account Info</h4>
        </div>
        <div class="panel-body">
          <div class="row">
            <div class="col-xs-12 col-sm-6">
              <table class="table table-condensed">
                <tr><td><strong>Username</strong></td><td><%= @user.username %></td></tr>
                <tr><td><strong>Email</strong></td><td><%= @user.email %></td></tr>
                <tr><td><strong>Name</strong></td><td><%= [@user.first_name, @user.last_name].compact.join(' ').presence || 'Not set' %></td></tr>
              </table>
            </div>
            <div class="col-xs-12 col-sm-6">
              <table class="table table-condensed">
                <tr><td><strong>Member Since</strong></td><td><%= @user.created_at.strftime("%B %Y") %></td></tr>
                <tr><td><strong>Last Login</strong></td><td><%= @user.last_sign_in_at ? @user.last_sign_in_at.strftime("%b %d, %Y") : 'N/A' %></td></tr>
                <tr><td><strong>Promo Code</strong></td><td><%= @user.promo_code.try(:code) || 'None' %></td></tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
