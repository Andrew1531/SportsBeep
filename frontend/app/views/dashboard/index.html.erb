<style>
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .sb-ticker-wrap {
    overflow: hidden;
    background: #0b0e14;
    border-bottom: 1px solid rgba(0,200,83,0.25);
    border-top: 1px solid rgba(0,200,83,0.15);
    position: relative;
  }
  .sb-ticker-wrap::before {
    content: 'LIVE';
    position: absolute; left: 0; top: 0; bottom: 0;
    background: #00c853;
    color: #000;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    z-index: 2;
  }
  .sb-ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 60s linear infinite;
    padding: 10px 0 10px 70px;
  }
  .sb-ticker-wrap:hover .sb-ticker-track {
    animation-play-state: paused;
  }
  .sb-ticker-item {
    display: inline-flex;
    align-items: center;
    padding: 0 28px;
    border-right: 1px solid rgba(255,255,255,0.08);
    white-space: nowrap;
    font-size: 12px;
    color: #cdd6f4;
    font-family: monospace;
    gap: 6px;
  }
  .sb-ticker-sport {
    background: rgba(0,200,83,0.15);
    color: #00c853;
    border: 1px solid rgba(0,200,83,0.3);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 10px;
    font-weight: 700;
  }
  .sb-ticker-ml-fav  { color: #fc8181; font-weight: 600; }
  .sb-ticker-ml-dog  { color: #68d391; font-weight: 600; }
  .sb-ticker-time    { color: #8892b0; font-size: 11px; }
  .sb-ticker-sep     { color: rgba(255,255,255,0.2); }
  .txn-row { transition: background 0.15s; }
  .txn-row:hover { background: rgba(255,255,255,0.03); border-radius: 6px; }
</style>

<div class="sb-ticker-wrap">
  <div class="sb-ticker-track">
    <% items = @ticker_items + @ticker_items %>
    <% items.each do |t| %>
      <span class="sb-ticker-item">
        <span class="sb-ticker-sport"><%= t[:sport] %></span>
        <%= t[:emoji] %>
        <strong><%= t[:away] %></strong>
        <span class="sb-ticker-sep">@</span>
        <strong><%= t[:home] %></strong>
        <span class="sb-ticker-sep">|</span>
        <span class="<%= t[:home_ml] < 0 ? 'sb-ticker-ml-fav' : 'sb-ticker-ml-dog' %>"><%= t[:home_ml] > 0 ? "+#{t[:home_ml]}" : t[:home_ml] %></span>
        <span class="sb-ticker-sep">/</span>
        <span class="<%= t[:away_ml] < 0 ? 'sb-ticker-ml-fav' : 'sb-ticker-ml-dog' %>"><%= t[:away_ml] > 0 ? "+#{t[:away_ml]}" : t[:away_ml] %></span>
        <span class="sb-ticker-time">— <%= t[:status] %></span>
      </span>
    <% end %>
  </div>
</div>

<div style="min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px;">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div style="margin-bottom: 30px;">
      <h2 style="color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 26px;">
        Welcome back, <%= @user.username %>
      </h2>
      <p style="color: #8892b0; margin: 0; font-size: 15px;">Your SportsBeep Dashboard</p>
    </div>

    <%# Account Info — kept first so identity and profile controls are easy to find %>
    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;"><i class="fa fa-user" style="color: #f7760d; margin-right: 8px;"></i>Account Information</h4>
      </div>
      <div style="padding: 22px;">
        <div class="row">
          <div class="col-xs-12 col-sm-4" style="text-align: center; margin-bottom: 18px;">
            <% if @user.profile_photo.attached? %>
              <%= image_tag @user.profile_photo, alt: "#{@user.username}'s profile photo", style: 'width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 3px solid #f7760d; margin-bottom: 12px;' %>
            <% else %>
              <div style="width: 112px; height: 112px; border-radius: 50%; background: rgba(247,118,13,0.12); border: 2px dashed rgba(247,118,13,0.55); color: #f7760d; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
                <i class="fa fa-user" style="font-size: 40px;"></i>
              </div>
            <% end %>
            <%= form_tag update_profile_photo_path, method: :patch, multipart: true, style: 'margin: 0;' do %>
              <label for="profile_photo" style="display: inline-block; padding: 9px 14px; background: #f7760d; color: #111521; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em;">
                <i class="fa fa-camera" style="margin-right: 6px;"></i>Choose Photo
              </label>
              <%= file_field_tag :profile_photo, id: 'profile_photo', accept: 'image/jpeg,image/png,image/webp', style: 'position:absolute; width:1px; height:1px; opacity:0;', onchange: 'this.form.submit()' %>
              <p style="color: #8892b0; font-size: 10px; margin: 8px 0 0;">JPG, PNG, or WebP. Maximum 5 MB.</p>
            <% end %>
          </div>
          <div class="col-xs-12 col-sm-4">
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Username</p>
              <p style="color: white; font-size: 15px; font-weight: 600; margin: 0;"><%= @user.username %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Email</p>
              <p style="color: white; font-size: 15px; margin: 0; overflow-wrap: anywhere;"><%= @user.email %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Name</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= [@user.first_name, @user.last_name].compact.join(' ').presence || 'Not set' %></p>
            </div>
          </div>
          <div class="col-xs-12 col-sm-4">
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Member Since</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @member_since_at.strftime("%B %Y") %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Last Login</p>
              <p style="color: white; font-size: 15px; margin: 0;">
                <% if @user.current_sign_in_at %>
                  <time datetime="<%= @user.current_sign_in_at.iso8601 %>" title="<%= @user.current_sign_in_at.strftime('%B %d, %Y at %l:%M %p %Z') %>"><%= time_ago_in_words(@user.current_sign_in_at) %> ago</time>
                <% else %>
                  First login
                <% end %>
              </p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Promo Code</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @user.promo_code.try(:code) || 'None' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Balance cards %>
    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 28px 24px; text-align: center;">
          <div style="width: 52px; height: 52px; background: linear-gradient(135deg, #e74c3c, #c0392b); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
            <i class="fa fa-coins" style="color: white; font-size: 24px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 8px;">Game Balance ($BEEP)</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 8px; font-size: 32px;"><%= @account.balance rescue '0.00' %></h3>
          <% dash_wallet_connected = (@user&.cardano_wallet_address.present? rescue false) %>
          <% if dash_wallet_connected %>
            <p style="color: #00c853; font-size: 12px; margin: 0 0 14px;"><i class="fa fa-link" style="margin-right: 5px;"></i>Wallet connected</p>
          <% else %>
            <p style="color: #f6ad55; font-size: 12px; margin: 0 0 14px;"><i class="fa fa-unlink" style="margin-right: 5px;"></i>No wallet connected</p>
          <% end %>
          <%= link_to 'View Wallet', wallet_path, style: 'display: inline-block; padding: 9px 24px; background: rgba(231,76,60,0.2); color: #e74c3c; border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 28px 24px; text-align: center;">
          <div style="width: 52px; height: 52px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
            <i class="fa fa-gift" style="color: white; font-size: 24px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 8px;">Promo Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 16px; font-size: 32px;"><%= @account.promo_balance rescue '0.00' %></h3>
          <%= link_to 'Redeem Code', redeem_promo_path, style: 'display: inline-block; padding: 9px 24px; background: rgba(108,92,231,0.2); color: #a29bfe; border: 1px solid rgba(108,92,231,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
    </div>

    <%# Quick actions %>
    <div style="background: linear-gradient(135deg, rgba(231,76,60,0.15), rgba(192,57,43,0.1)); border: 1px solid rgba(231,76,60,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
      <div class="row" style="display: flex; align-items: center; flex-wrap: wrap;">
        <div class="col-xs-12 col-sm-6" style="margin-bottom: 10px;">
          <h4 style="color: white; font-weight: 700; margin: 0 0 4px;">Quick Actions</h4>
          <p style="color: #8892b0; margin: 0; font-size: 14px;">Jump right into the action!</p>
        </div>
        <div class="col-xs-12 col-sm-6 text-right" style="padding-top: 5px;">
          <%= link_to sportsbook_path, style: 'display: inline-block; padding: 11px 28px; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 15px rgba(231,76,60,0.35); margin-right: 10px;' do %>Sportsbook<% end %>
          <%= link_to 'How to Play', how_to_play_path, style: 'display: inline-block; padding: 11px 28px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
      <% if @account.balance_cents <= 0 %>
        <div style="margin-top: 12px; background: rgba(253,203,110,0.1); border: 1px solid rgba(253,203,110,0.3); border-radius: 10px; padding: 12px 18px;">
          <p style="color: #fdcb6e; margin: 0; font-size: 13px;">
            <i class="fa fa-exclamation-triangle" style="margin-right: 6px;"></i>
            You need <strong>$BEEP tokens</strong> to enter contests. <%= link_to 'Go to Wallet', wallet_path, style: 'color: #a29bfe; font-weight: 700; text-decoration: underline;' %> to swap ADA for $BEEP.
          </p>
        </div>
      <% end %>
    </div>

    <%# Recent Transactions — main content area %>
    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 18px 24px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
        <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">
          <i class="fa fa-arrow-right-arrow-left" style="color: #00c853; margin-right: 10px;"></i>Recent Transactions
        </h4>
        <%= link_to user_transactions_path, style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
          View All <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
        <% end %>
      </div>
      <div style="padding: 6px 24px 18px;">
        <% if @recent_transactions.any? %>
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr>
                <th style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; padding: 14px 0 10px; text-align: left;">Description</th>
                <th style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; padding: 14px 0 10px; text-align: center;">Type</th>
                <th style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; padding: 14px 0 10px; text-align: right;">Amount</th>
                <th style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; padding: 14px 0 10px; text-align: right;">Date</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_transactions.each do |txn| %>
                <%
                  is_credit = txn.amount_cents.to_i >= 0 rescue true
                  type_label = txn.type.to_s.gsub('Transaction','').gsub(/([A-Z])/,' \1').strip.presence || 'Adjustment'
                  amt_color  = is_credit ? '#68d391' : '#fc8181'
                  amt_prefix = is_credit ? '+' : ''
                %>
                <tr class="txn-row" style="border-top: 1px solid rgba(255,255,255,0.05);">
                  <td style="color: white; padding: 12px 0; font-size: 14px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= txn.description %></td>
                  <td style="padding: 12px 8px; text-align: center;">
                    <span style="background: rgba(255,255,255,0.07); color: #8892b0; border-radius: 20px; padding: 3px 10px; font-size: 11px; white-space: nowrap;"><%= type_label %></span>
                  </td>
                  <td style="color: <%= amt_color %>; padding: 12px 0; font-size: 14px; text-align: right; font-weight: 700; font-family: monospace;"><%= amt_prefix %><%= txn.amount %></td>
                  <td style="color: #8892b0; padding: 12px 0; font-size: 12px; text-align: right; white-space: nowrap;"><%= txn.created_at.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div style="text-align: center; padding: 40px 0;">
            <i class="fa fa-arrow-right-arrow-left" style="font-size: 38px; color: rgba(255,255,255,0.1); margin-bottom: 14px; display: block;"></i>
            <p style="color: #8892b0; margin: 0 0 16px; font-size: 15px;">No transactions yet</p>
            <%= link_to sportsbook_path, style: 'display: inline-block; padding: 10px 26px; background: linear-gradient(135deg,#e74c3c,#c0392b); color: white; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none;' do %>
              Place Your First Bet
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Connected Wallets %>
    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 24px; margin-bottom: 20px;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 18px;">
        <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">
          <i class="fa fa-link" style="color: #a29bfe; margin-right: 8px;"></i>Connected Wallets
        </h4>
        <%= link_to wallet_path, style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
          Manage <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
        <% end %>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-8 col-sm-offset-2">
          <div style="background: rgba(0,136,204,0.08); border: 1px solid rgba(0,180,216,0.2); border-radius: 10px; padding: 14px 18px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center;">
                <i class="fa fa-wallet" style="color: #00b4d8; font-size: 18px; margin-right: 10px;"></i>
                <div>
                  <p style="color: white; font-weight: 600; margin: 0; font-size: 14px;">Cardano</p>
                  <% if @user.cardano_wallet_address.present? %>
                    <code style="color: #8892b0; font-size: 11px;"><%= @user.cardano_wallet_address[0..8] %>...<%= @user.cardano_wallet_address[-4..] %></code>
                  <% else %>
                    <p style="color: #8892b0; margin: 0; font-size: 12px;">Not connected</p>
                  <% end %>
                </div>
              </div>
              <span style="padding: 4px 10px; background: <%= @user.cardano_wallet_address.present? ? 'rgba(72,187,120,0.15)' : 'rgba(255,255,255,0.06)' %>; color: <%= @user.cardano_wallet_address.present? ? '#68d391' : '#8892b0' %>; border-radius: 20px; font-size: 11px; font-weight: 600;"><%= @user.cardano_wallet_address.present? ? 'Connected' : 'Inactive' %></span>
            </div>
          </div>
        </div>
      </div>
      <% unless @user.cardano_wallet_address.present? %>
        <div style="margin-top: 14px; text-align: center;">
          <%= link_to wallet_path, style: 'display: inline-block; padding: 10px 24px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;' do %>
            <i class="fa fa-plus" style="margin-right: 6px;"></i> Connect Cardano Wallet
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>
