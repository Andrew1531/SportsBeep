<div style="min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px;">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div style="margin-bottom: 30px;">
      <h2 style="color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 26px;">
        Welcome back, <%= @user.username %>
      </h2>
      <p style="color: #8892b0; margin: 0; font-size: 15px;">Your SportsBeep Dashboard</p>
    </div>

    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center; transition: transform 0.2s;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #e74c3c, #c0392b); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-coins" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">$BEEP Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 14px; font-size: 24px;"><%= @account.balance rescue '0.00' %></h3>
          <%= link_to 'View Wallet', wallet_path, style: 'display: inline-block; padding: 7px 18px; background: rgba(231,76,60,0.2); color: #e74c3c; border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-gift" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Promo Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 14px; font-size: 24px;"><%= @account.promo_balance rescue '0.00' %></h3>
          <%= link_to 'Redeem Code', redeem_promo_path, style: 'display: inline-block; padding: 7px 18px; background: rgba(108,92,231,0.2); color: #a29bfe; border: 1px solid rgba(108,92,231,0.3); border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #00b894, #00cec9); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-baseball" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">MLB Contests</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 14px; font-size: 24px;"><%= @mlb_tickets.size %></h3>
          <a href="#mlb-entries" style="display: inline-block; padding: 7px 18px; background: rgba(0,184,148,0.2); color: #00b894; border: 1px solid rgba(0,184,148,0.3); border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;">View Entries</a>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #fdcb6e, #e17055); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-football" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">NFL Contests</p>
          <h3 style="color: white; font-weight: 700; margin: 0 0 14px; font-size: 24px;"><%= @nfl_tickets.size %></h3>
          <a href="#nfl-entries" style="display: inline-block; padding: 7px 18px; background: rgba(253,203,110,0.2); color: #fdcb6e; border: 1px solid rgba(253,203,110,0.3); border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;">View Entries</a>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(231,76,60,0.15), rgba(192,57,43,0.1)); border: 1px solid rgba(231,76,60,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
      <div class="row" style="display: flex; align-items: center; flex-wrap: wrap;">
        <div class="col-xs-12 col-sm-6" style="margin-bottom: 10px;">
          <h4 style="color: white; font-weight: 700; margin: 0 0 4px;">Quick Actions</h4>
          <p style="color: #8892b0; margin: 0; font-size: 14px;">Jump right into the action!</p>
        </div>
        <div class="col-xs-12 col-sm-6 text-right" style="padding-top: 5px;">
          <%= link_to sportsbook_path, style: 'display: inline-block; padding: 11px 28px; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 15px rgba(231,76,60,0.35); margin-right: 10px;' do %>Sportsbook<% end %>
          <%= link_to 'How to Play', how_to_play_path, style: 'display: inline-block; padding: 11px 28px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none;' %>
        </div>
      </div>
      <% if @account.balance_cents <= 0 %>
        <div style="margin-top: 12px; background: rgba(253,203,110,0.1); border: 1px solid rgba(253,203,110,0.3); border-radius: 10px; padding: 12px 18px;">
          <p style="color: #fdcb6e; margin: 0; font-size: 13px;">
            <i class="fa fa-exclamation-triangle" style="margin-right: 6px;"></i>
            You need <strong>$BEEP tokens</strong> to enter contests. <%= link_to 'Go to Wallet', wallet_path, style: 'color: #a29bfe; font-weight: 700; text-decoration: underline;' %> to swap ADA for $BEEP.
          </p>
        </div>
      <% end %>
    </div>

    <% if @user.cardano_wallet_address.present? %>
      <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 24px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 18px;">
          <div style="display: flex; align-items: center;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
              <i class="fa fa-wallet" style="color: white; font-size: 18px;"></i>
            </div>
            <div>
              <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Cardano Wallet</h4>
              <p style="color: #8892b0; margin: 0; font-size: 12px;">Connected to Mainnet</p>
            </div>
          </div>
          <% if @wallet_info %>
            <div style="text-align: right; margin-top: 5px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">ADA Balance</p>
              <h3 style="color: #00b4d8; font-weight: 700; margin: 0; font-size: 26px;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %> <span style="font-size: 14px; color: #8892b0;">ADA</span></h3>
            </div>
          <% end %>
        </div>

        <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Wallet Address</p>
          <code style="color: #00b4d8; word-break: break-all; font-size: 12px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
        </div>

        <% if @wallet_info && @wallet_info[:stake_address].present? %>
          <div style="background: rgba(0,0,0,0.15); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Stake Address</p>
            <code style="color: #63b3ed; word-break: break-all; font-size: 11px;"><%= @wallet_info[:stake_address] %></code>
          </div>
        <% end %>

        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
          <p style="color: #8892b0; margin: 0; font-size: 13px;">
            <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
            $BEEP token rewards will be sent to this wallet
          </p>
          <% if @wallet_info && @wallet_info[:status] == 'empty' %>
            <span style="display: inline-block; padding: 4px 12px; background: rgba(253,203,110,0.15); color: #fdcb6e; border: 1px solid rgba(253,203,110,0.3); border-radius: 20px; font-size: 11px; font-weight: 600; margin-top: 5px;">No transactions yet</span>
          <% elsif @wallet_info && @wallet_info[:status] == 'active' %>
            <span style="display: inline-block; padding: 4px 12px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 11px; font-weight: 600; margin-top: 5px;">Active</span>
          <% end %>
        </div>
      </div>
    <% else %>
      <div style="background: rgba(0,136,204,0.1); border: 1px solid rgba(0,136,204,0.25); border-radius: 14px; padding: 18px 24px; margin-bottom: 20px;">
        <p style="color: #63b3ed; margin: 0; font-size: 14px;">
          <i class="fa fa-wallet" style="margin-right: 6px;"></i>
          <strong>Connect your Cardano wallet!</strong> Link your wallet address in your account settings to receive $BEEP token rewards.
        </p>
      </div>
    <% end %>

    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-md-6" style="margin-bottom: 15px;">
        <div id="mlb-entries" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden;">
          <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08);">
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;"><i class="fa fa-baseball" style="color: #00b894; margin-right: 8px;"></i>Recent MLB Entries</h4>
          </div>
          <div style="padding: 18px 22px;">
            <% if @mlb_tickets.any? %>
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: left;">Contest</th>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: center;">Score</th>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: right;">Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @mlb_tickets.each do |ticket| %>
                    <tr style="border-top: 1px solid rgba(255,255,255,0.06);">
                      <td style="color: white; padding: 10px 0; font-size: 14px;"><%= ticket.contest.try(:name) || "Contest ##{ticket.contest_id}" %></td>
                      <td style="color: #a29bfe; padding: 10px 0; font-size: 14px; text-align: center;"><%= ticket.score rescue 'N/A' %></td>
                      <td style="color: #8892b0; padding: 10px 0; font-size: 13px; text-align: right;"><%= ticket.created_at.strftime("%b %d, %Y") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <div style="text-align: center; padding: 25px 0;">
                <i class="fa fa-baseball" style="font-size: 32px; color: rgba(255,255,255,0.15); margin-bottom: 10px; display: block;"></i>
                <p style="color: #8892b0; margin: 0; font-size: 14px;">No MLB entries yet</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="col-xs-12 col-md-6" style="margin-bottom: 15px;">
        <div id="nfl-entries" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden;">
          <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08);">
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;"><i class="fa fa-football" style="color: #fdcb6e; margin-right: 8px;"></i>Recent NFL Entries</h4>
          </div>
          <div style="padding: 18px 22px;">
            <% if @nfl_tickets.any? %>
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: left;">Contest</th>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: center;">Score</th>
                    <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: right;">Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @nfl_tickets.each do |ticket| %>
                    <tr style="border-top: 1px solid rgba(255,255,255,0.06);">
                      <td style="color: white; padding: 10px 0; font-size: 14px;"><%= ticket.contest.try(:name) || "Contest ##{ticket.contest_id}" %></td>
                      <td style="color: #a29bfe; padding: 10px 0; font-size: 14px; text-align: center;"><%= ticket.score rescue 'N/A' %></td>
                      <td style="color: #8892b0; padding: 10px 0; font-size: 13px; text-align: right;"><%= ticket.created_at.strftime("%b %d, %Y") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <div style="text-align: center; padding: 25px 0;">
                <i class="fa fa-football" style="font-size: 32px; color: rgba(255,255,255,0.15); margin-bottom: 10px; display: block;"></i>
                <p style="color: #8892b0; margin: 0; font-size: 14px;">No NFL entries yet</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;"><i class="fa fa-arrow-right-arrow-left" style="color: #a29bfe; margin-right: 8px;"></i>Recent Transactions</h4>
      </div>
      <div style="padding: 18px 22px;">
        <% if @recent_transactions.any? %>
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr>
                <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: left;">Description</th>
                <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: right;">Amount</th>
                <th style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 0 0 12px; text-align: right;">Date</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_transactions.each do |txn| %>
                <tr style="border-top: 1px solid rgba(255,255,255,0.06);">
                  <td style="color: white; padding: 10px 0; font-size: 14px;"><%= txn.description %></td>
                  <td style="color: #68d391; padding: 10px 0; font-size: 14px; text-align: right; font-weight: 600;"><%= txn.amount %></td>
                  <td style="color: #8892b0; padding: 10px 0; font-size: 13px; text-align: right;"><%= txn.created_at.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div style="margin-top: 14px;">
            <%= link_to 'View All Transactions', user_transactions_path, style: 'color: #a29bfe; font-size: 13px; font-weight: 600; text-decoration: none;' %>
          </div>
        <% else %>
          <div style="text-align: center; padding: 25px 0;">
            <i class="fa fa-arrow-right-arrow-left" style="font-size: 32px; color: rgba(255,255,255,0.15); margin-bottom: 10px; display: block;"></i>
            <p style="color: #8892b0; margin: 0; font-size: 14px;">No transactions yet</p>
          </div>
        <% end %>
      </div>
    </div>

    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;"><i class="fa fa-user" style="color: #63b3ed; margin-right: 8px;"></i>Account Info</h4>
      </div>
      <div style="padding: 22px;">
        <div class="row">
          <div class="col-xs-12 col-sm-6">
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Username</p>
              <p style="color: white; font-size: 15px; font-weight: 600; margin: 0;"><%= @user.username %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Email</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @user.email %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Name</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= [@user.first_name, @user.last_name].compact.join(' ').presence || 'Not set' %></p>
            </div>
          </div>
          <div class="col-xs-12 col-sm-6">
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Member Since</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @user.created_at.strftime("%B %Y") %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Last Login</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @user.last_sign_in_at ? @user.last_sign_in_at.strftime("%b %d, %Y") : 'First login' %></p>
            </div>
            <div style="margin-bottom: 16px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Promo Code</p>
              <p style="color: white; font-size: 15px; margin: 0;"><%= @user.promo_code.try(:code) || 'None' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
