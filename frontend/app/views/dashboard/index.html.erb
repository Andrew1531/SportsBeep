<style>
  @keyframes ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .dashboard-terminal {
    --dash-ink: #111521;
    --dash-deep: #080b12;
    --dash-panel: #191e2b;
    --dash-panel-hi: #232b3c;
    --dash-copy: #f1f3fb;
    --dash-muted: #9aa4bb;
    --dash-line: rgba(222,230,255,.14);
    --dash-orange: #f7760d;
    --dash-amber: #fbbf24;
    --dash-danger: #ff6b7c;
    min-height: calc(100dvh - 140px);
    padding: 34px 15px 72px;
    color: var(--dash-copy);
    background: radial-gradient(circle at 8% 0%, rgba(251,191,36,.11), transparent 28%), radial-gradient(circle at 94% 6%, rgba(247,118,13,.09), transparent 26%), var(--dash-ink);
    position: relative;
  }
  .dashboard-terminal::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: .07; background-image: radial-gradient(rgba(255,255,255,.55) .4px, transparent .65px); background-size: 5px 5px; mix-blend-mode: soft-light; }
  .dashboard-terminal > .container { position: relative; z-index: 1; max-width: 1180px; }
  .dashboard-terminal a { text-decoration: none; }
  .dashboard-terminal a:focus-visible, .dashboard-terminal input:focus-visible { outline: 2px solid var(--dash-orange); outline-offset: 3px; }
  .dash-ticker { overflow: hidden; position: relative; background: #0c1019; border-top: 1px solid rgba(247,118,13,.2); border-bottom: 1px solid rgba(247,118,13,.34); }
  .dash-ticker::before { content: "LIVE"; position: absolute; inset: 0 auto 0 0; z-index: 2; display: flex; align-items: center; padding: 0 12px; color: var(--dash-ink); background: var(--dash-orange); font: 800 10px/1 'DM Mono', monospace; letter-spacing: .13em; }
  .dash-ticker-track { display: flex; width: max-content; padding: 10px 0 10px 68px; animation: ticker-scroll 60s linear infinite; }
  .dash-ticker:hover .dash-ticker-track { animation-play-state: paused; }
  .dash-ticker-item { display: inline-flex; align-items: center; gap: 7px; padding: 0 28px; border-right: 1px solid var(--dash-line); color: var(--dash-copy); white-space: nowrap; font: 500 12px/1.2 'DM Mono', monospace; }
  .dash-ticker-sport { padding: 2px 5px; border: 1px solid rgba(247,118,13,.45); color: var(--dash-orange); background: rgba(247,118,13,.08); font: 700 9px/1 'DM Mono', monospace; letter-spacing: .06em; }
  .dash-ticker-fav { color: #ff8896; font-weight: 700; } .dash-ticker-dog { color: #f6c76b; font-weight: 700; } .dash-ticker-sep, .dash-ticker-time { color: var(--dash-muted); }
  .dash-alert { margin-bottom: 18px; padding: 12px 15px; border: 1px solid var(--dash-line); border-left: 2px solid var(--dash-orange); background: rgba(25,30,43,.92); color: var(--dash-copy); font-size: 13px; }
  .dash-alert--error { border-left-color: var(--dash-danger); color: #ffb4bd; }
  .dash-header { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--dash-line); }
  .dash-kicker, .dash-label { margin: 0 0 7px; color: var(--dash-muted); font: 700 10px/1.2 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
  .dash-kicker { color: var(--dash-orange); }
  .dash-title { margin: 0; color: var(--dash-copy); font: italic 800 32px/.9 'Barlow Condensed', 'Arial Narrow', sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .dash-header-status { color: var(--dash-muted); font: 700 10px/1.4 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .dash-header-status i { color: var(--dash-orange); margin-right: 5px; }
  .dash-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr); gap: 20px; align-items: start; }
  .dash-main-stack, .dash-side-stack { display: grid; gap: 20px; }
  .dash-panel { overflow: hidden; border: 1px solid var(--dash-line); border-radius: 5px; background: rgba(25,30,43,.92); box-shadow: 0 12px 35px rgba(0,0,0,.14); }
  .dash-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 15px 18px; border-bottom: 1px solid var(--dash-line); background: rgba(8,11,18,.25); }
  .dash-panel-title { margin: 0; color: var(--dash-copy); font: 800 20px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .dash-panel-title i { color: var(--dash-orange); margin-right: 7px; }
  .dash-text-link { color: var(--dash-orange); font: 700 10px/1.2 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .dash-text-link:hover { color: #ff9b48; }
  .dash-balances { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; border: 1px solid var(--dash-line); background: var(--dash-line); }
  .dash-balance { min-height: 172px; padding: 18px; background: var(--dash-panel); }
  .dash-balance--primary { border-top: 2px solid var(--dash-orange); }
  .dash-balance-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; margin-bottom: 17px; background: rgba(247,118,13,.11); border: 1px solid rgba(247,118,13,.35); color: var(--dash-orange); }
  .dash-balance-value { margin: 0 0 5px; color: var(--dash-copy); font: 700 24px/1 'DM Mono', monospace; }
  .dash-balance-unit { color: var(--dash-muted); font-size: 10px; }
  .dash-balance-status { min-height: 17px; margin: 12px 0 0; color: var(--dash-muted); font: 700 10px/1.3 'DM Mono', monospace; text-transform: uppercase; }
  .dash-balance-status i { color: var(--dash-orange); margin-right: 4px; } .dash-balance-status--offline { color: var(--dash-amber); }
  .dash-mini-action { display: inline-block; margin-top: 10px; padding: 6px 8px; border: 1px solid rgba(247,118,13,.55); border-radius: 2px; color: var(--dash-orange); background: rgba(247,118,13,.06); font: 700 10px/1 'DM Mono', monospace; letter-spacing: .05em; text-transform: uppercase; }
  .dash-mini-action:hover { color: var(--dash-ink); background: var(--dash-orange); }
  .dash-action-panel { padding: 18px; border-left: 2px solid var(--dash-orange); background: linear-gradient(90deg, rgba(247,118,13,.1), rgba(25,30,43,.92) 48%); }
  .dash-action-panel p { margin: 0; color: var(--dash-muted); font-size: 13px; line-height: 1.5; }
  .dash-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .dash-button { display: inline-flex; align-items: center; justify-content: center; padding: 10px 16px; border: 1px solid var(--dash-line); border-radius: 3px; color: var(--dash-copy); background: rgba(255,255,255,.04); font: 800 16px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .dash-button:hover { border-color: var(--dash-orange); color: var(--dash-orange); }
  .dash-button--signal { border-color: var(--dash-orange); color: var(--dash-ink); background: var(--dash-orange); } .dash-button--signal:hover { color: var(--dash-ink); background: #ff8b2c; }
  .dash-wallet-warning { margin-top: 14px !important; padding: 10px 12px; border: 1px solid rgba(251,191,36,.35); background: rgba(251,191,36,.07); color: #f6d27d !important; font-size: 12px !important; }
  .dash-wallet-warning a { color: var(--dash-orange); font-weight: 700; text-decoration: underline; }
  .dash-account-body { display: grid; grid-template-columns: 150px 1fr; gap: 20px; padding: 18px; }
  .dash-photo { text-align: center; }
  .dash-avatar, .dash-avatar img { display: block; width: 92px; height: 92px; margin: 0 auto 11px; object-fit: cover; border-radius: 50%; }
  .dash-avatar { display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(247,118,13,.55); color: var(--dash-orange); background: rgba(247,118,13,.1); font-size: 31px; }
  .dash-avatar img { border: 2px solid var(--dash-orange); }
  .dash-photo-button { display: inline-block; padding: 7px 9px; cursor: pointer; border: 1px solid rgba(247,118,13,.52); border-radius: 2px; color: var(--dash-orange); background: rgba(247,118,13,.07); font: 700 9px/1.2 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; }
  .dash-photo-button:hover { color: var(--dash-ink); background: var(--dash-orange); }
  .dash-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .dash-photo-help { margin: 7px 0 0; color: var(--dash-muted); font-size: 9px; line-height: 1.4; }
  .dash-account-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .dash-data { min-width: 0; padding: 0 0 14px; border-bottom: 1px solid rgba(222,230,255,.08); }
  .dash-data:nth-last-child(-n+2) { padding-bottom: 0; border-bottom: 0; }
  .dash-value { margin: 0; overflow-wrap: anywhere; color: var(--dash-copy); font-size: 13px; line-height: 1.35; }
  .dash-transactions { overflow-x: auto; padding: 0 18px 10px; }
  .dash-table { width: 100%; min-width: 570px; border-collapse: collapse; }
  .dash-table th { padding: 13px 0 9px; color: var(--dash-muted); font: 700 9px/1.2 'DM Mono', monospace; letter-spacing: .1em; text-align: left; text-transform: uppercase; }
  .dash-table th:not(:first-child), .dash-table td:not(:first-child) { text-align: right; } .dash-table th:nth-child(2), .dash-table td:nth-child(2) { text-align: center; }
  .dash-table td { max-width: 230px; padding: 12px 0; border-top: 1px solid rgba(222,230,255,.08); color: var(--dash-copy); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash-type { display: inline-block; padding: 3px 6px; border: 1px solid rgba(222,230,255,.12); color: var(--dash-muted); background: rgba(255,255,255,.035); font: 700 9px/1 'DM Mono', monospace; }
  .dash-amount { font: 700 12px 'DM Mono', monospace; } .dash-date { color: var(--dash-muted) !important; font-size: 11px !important; }
  .dash-empty { padding: 33px 12px; text-align: center; color: var(--dash-muted); } .dash-empty i { display: block; margin-bottom: 12px; color: rgba(247,118,13,.48); font-size: 28px; } .dash-empty p { margin: 0 0 14px; font-size: 13px; }
  .dash-wallet-card { padding: 17px 18px; }
  .dash-wallet-network { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px; border: 1px solid var(--dash-line); border-left: 2px solid var(--dash-orange); background: rgba(8,11,18,.36); }
  .dash-wallet-network-main { display: flex; align-items: center; min-width: 0; gap: 10px; } .dash-wallet-network-main > i { color: var(--dash-orange); } .dash-wallet-network p { margin: 0; } .dash-wallet-network code { color: var(--dash-muted); font-size: 10px; }
  .dash-wallet-name { color: var(--dash-copy); font: 800 17px/1 'Barlow Condensed', sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .dash-status { flex: 0 0 auto; padding: 4px 6px; border: 1px solid rgba(247,118,13,.4); color: var(--dash-orange); background: rgba(247,118,13,.08); font: 700 9px/1 'DM Mono', monospace; text-transform: uppercase; } .dash-status--inactive { border-color: var(--dash-line); color: var(--dash-muted); background: transparent; }
  .dash-connect-wrap { margin-top: 13px; text-align: center; }
  @media (max-width: 767px) {
    .dashboard-terminal { padding: 24px 12px 48px; } .dash-header { align-items: flex-start; flex-direction: column; } .dash-title { font-size: 28px; } .dash-grid { display: flex; flex-direction: column; align-items: stretch; } .dash-main-stack, .dash-side-stack { display: contents; } .dash-account-panel { order: 1; } .dash-balance-panel { order: 0; } .dash-action-panel { order: 2; } .dash-transactions-panel { order: 3; } .dash-wallet-panel { order: 4; }
    .dash-account-body { grid-template-columns: 1fr; } .dash-account-details { grid-template-columns: 1fr; } .dash-data:nth-last-child(-n+2) { padding-bottom: 14px; border-bottom: 1px solid rgba(222,230,255,.08); } .dash-data:last-child { padding-bottom: 0; border-bottom: 0; } .dash-balances { grid-template-columns: 1fr; } .dash-balance { min-height: 146px; } .dash-ticker-item { padding: 0 16px; } .dash-panel-head { padding: 14px; } .dash-wallet-card { padding: 14px; } .dash-action-panel { padding: 16px; }
  }
</style>

<div class="dash-ticker">
  <div class="dash-ticker-track">
    <% items = @ticker_items + @ticker_items %>
    <% items.each do |t| %>
      <span class="dash-ticker-item">
        <span class="dash-ticker-sport"><%= t[:sport] %></span><%= t[:emoji] %>
        <strong><%= t[:away] %></strong><span class="dash-ticker-sep">@</span><strong><%= t[:home] %></strong>
        <span class="dash-ticker-sep">|</span>
        <span class="<%= t[:home_ml] < 0 ? 'dash-ticker-fav' : 'dash-ticker-dog' %>"><%= t[:home_ml] > 0 ? "+#{t[:home_ml]}" : t[:home_ml] %></span>
        <span class="dash-ticker-sep">/</span>
        <span class="<%= t[:away_ml] < 0 ? 'dash-ticker-fav' : 'dash-ticker-dog' %>"><%= t[:away_ml] > 0 ? "+#{t[:away_ml]}" : t[:away_ml] %></span>
        <span class="dash-ticker-time">— <%= t[:status] %></span>
      </span>
    <% end %>
  </div>
</div>

<main class="dashboard-terminal">
  <div class="container">
    <% if flash[:notice] %><div class="dash-alert"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="dash-alert dash-alert--error"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></div><% end %>

    <header class="dash-header">
      <div><p class="dash-kicker">Account terminal</p><h1 class="dash-title">Welcome, <%= @user.username %></h1></div>
      <div class="dash-header-status"><i class="fa fa-circle" aria-hidden="true"></i> Session active</div>
    </header>

    <div class="dash-grid">
      <div class="dash-main-stack">
        <section class="dash-panel dash-account-panel">
          <div class="dash-panel-head"><h2 class="dash-panel-title"><i class="fa fa-user"></i>Account information</h2></div>
          <div class="dash-account-body">
            <div class="dash-photo">
              <% if @user.profile_photo.attached? %>
                <div class="dash-avatar"><%= image_tag rails_storage_proxy_path(@user.profile_photo), alt: 'Your profile photo' %></div>
              <% else %><div class="dash-avatar"><i class="fa fa-user"></i></div><% end %>
              <%= form_tag update_profile_photo_path, method: :patch, multipart: true do %>
                <label for="profile_photo" class="dash-photo-button"><i class="fa fa-camera"></i> Choose photo</label>
                <%= file_field_tag :profile_photo, id: 'profile_photo', accept: 'image/jpeg,image/png,image/webp', class: 'dash-file-input', onchange: 'this.form.submit()' %>
                <p class="dash-photo-help">JPG, PNG, or WebP.<br>Maximum 5 MB.</p>
              <% end %>
            </div>
            <div class="dash-account-details">
              <div class="dash-data"><p class="dash-label">Username</p><p class="dash-value"><%= @user.username %></p></div>
              <div class="dash-data"><p class="dash-label">Email</p><p class="dash-value"><%= @user.email %></p></div>
              <div class="dash-data"><p class="dash-label">Name</p><p class="dash-value"><%= [@user.first_name, @user.last_name].compact.join(' ').presence || 'Not set' %></p></div>
              <div class="dash-data"><p class="dash-label">Member since</p><p class="dash-value"><%= @member_since_at.strftime("%B %Y") %></p></div>
              <div class="dash-data"><p class="dash-label">Last login</p><p class="dash-value"><% if @user.current_sign_in_at %><time datetime="<%= @user.current_sign_in_at.iso8601 %>" title="<%= @user.current_sign_in_at.strftime('%B %d, %Y at %l:%M %p %Z') %>"><%= time_ago_in_words(@user.current_sign_in_at) %> ago</time><% else %>First login<% end %></p></div>
              <div class="dash-data"><p class="dash-label">Promo code</p><p class="dash-value"><%= @user.promo_code.try(:code) || 'None' %></p></div>
            </div>
          </div>
        </section>

        <section class="dash-panel dash-transactions-panel">
          <div class="dash-panel-head"><h2 class="dash-panel-title"><i class="fa fa-arrow-right-arrow-left"></i>Recent transactions</h2><%= link_to 'View all', user_transactions_path, class: 'dash-text-link' %></div>
          <% if @recent_transactions.any? %>
            <div class="dash-transactions"><table class="dash-table"><thead><tr><th>Description</th><th>Type</th><th>Amount</th><th>Date</th></tr></thead><tbody>
              <% @recent_transactions.each do |txn| %>
                <% is_credit = txn.amount_cents.to_i >= 0 rescue true; type_label = txn.type.to_s.gsub('Transaction','').gsub(/([A-Z])/,' \1').strip.presence || 'Adjustment'; amt_color = is_credit ? '#f6c76b' : '#ff8896'; amt_prefix = is_credit ? '+' : '' %>
                <tr><td><%= txn.description %></td><td><span class="dash-type"><%= type_label %></span></td><td class="dash-amount" style="color: <%= amt_color %>;"><%= amt_prefix %><%= txn.amount %></td><td class="dash-date"><%= txn.created_at.strftime("%b %d, %Y") %></td></tr>
              <% end %>
            </tbody></table></div>
          <% else %>
            <div class="dash-empty"><i class="fa fa-arrow-right-arrow-left"></i><p>No transactions yet</p><%= link_to 'Place your first bet', sportsbook_path, class: 'dash-button dash-button--signal' %></div>
          <% end %>
        </section>
      </div>

      <aside class="dash-side-stack">
        <section class="dash-balance-panel">
          <div class="dash-balances">
            <div class="dash-balance dash-balance--primary"><div class="dash-balance-icon"><i class="fa fa-coins"></i></div><p class="dash-label">Game balance</p><p class="dash-balance-value"><%= @account.balance rescue '0.00' %> <span class="dash-balance-unit">BEEP</span></p><% dash_wallet_connected = (@user&.cardano_wallet_address.present? rescue false) %><p class="dash-balance-status <%= 'dash-balance-status--offline' unless dash_wallet_connected %>"><i class="fa <%= dash_wallet_connected ? 'fa-link' : 'fa-unlink' %>"></i><%= dash_wallet_connected ? 'Wallet connected' : 'No wallet connected' %></p><%= link_to 'Open wallet', wallet_path, class: 'dash-mini-action' %></div>
            <div class="dash-balance"><div class="dash-balance-icon"><i class="fa fa-gift"></i></div><p class="dash-label">Promo balance</p><p class="dash-balance-value"><%= @account.promo_balance rescue '0.00' %> <span class="dash-balance-unit">BEEP</span></p><%= link_to 'Redeem code', redeem_promo_path, class: 'dash-mini-action' %></div>
          </div>
        </section>

        <section class="dash-panel dash-action-panel">
          <p class="dash-kicker">Quick actions</p><h2 class="dash-panel-title">Ready for the slate?</h2><p>Enter the sportsbook or review the rules before your next contest.</p>
          <div class="dash-actions"><%= link_to 'Sportsbook', sportsbook_path, class: 'dash-button dash-button--signal' %><%= link_to 'How to play', how_to_play_path, class: 'dash-button' %></div>
          <% if @account.balance_cents <= 0 %><p class="dash-wallet-warning"><i class="fa fa-triangle-exclamation"></i> You need <strong>$BEEP tokens</strong> to enter contests. <%= link_to 'Go to Wallet', wallet_path %> to swap ADA for $BEEP.</p><% end %>
        </section>

        <section class="dash-panel dash-wallet-panel">
          <div class="dash-panel-head"><h2 class="dash-panel-title"><i class="fa fa-link"></i>Connected wallet</h2><%= link_to 'Manage', wallet_path, class: 'dash-text-link' %></div>
          <div class="dash-wallet-card">
            <div class="dash-wallet-network"><div class="dash-wallet-network-main"><i class="fa fa-wallet"></i><div><p class="dash-wallet-name">Cardano</p><% if @user.cardano_wallet_address.present? %><code><%= @user.cardano_wallet_address[0..8] %>...<%= @user.cardano_wallet_address[-4..] %></code><% else %><code>Not connected</code><% end %></div></div><span class="dash-status <%= 'dash-status--inactive' unless @user.cardano_wallet_address.present? %>"><%= @user.cardano_wallet_address.present? ? 'Connected' : 'Inactive' %></span></div>
            <% unless @user.cardano_wallet_address.present? %><div class="dash-connect-wrap"><%= link_to 'Connect Cardano wallet', wallet_path, class: 'dash-button dash-button--signal' %></div><% end %>
          </div>
        </section>
      </aside>
    </div>
  </div>
</main>