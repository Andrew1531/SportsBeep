<div style="min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px;">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div style="margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
      <div>
        <h2 style="color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 26px;">
          <i class="fa fa-store" style="color: #e74c3c; margin-right: 8px;"></i>SportsBeep Vending
        </h2>
        <p style="color: #8892b0; margin: 0; font-size: 15px;">Connect your Cardano wallet, swap tokens & manage your crypto</p>
      </div>
      <div style="margin-top: 5px;">
        <%= link_to wallet_path, style: 'display: inline-block; padding: 11px 28px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none; margin-right: 8px;' do %>
          <i class="fa fa-wallet" style="margin-right: 6px;"></i> My Wallet
        <% end %>
        <%= link_to user_dashboard_path, style: 'display: inline-block; padding: 11px 28px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none;' do %>
          <i class="fa fa-arrow-left" style="margin-right: 6px;"></i> Dashboard
        <% end %>
      </div>
    </div>

    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-sm-6 col-md-4" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #e74c3c, #c0392b); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-coins" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">$BEEP Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= @account.balance rescue '0.00' %></h3>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-4" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-wallet" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Cardano</p>
          <h3 style="color: <%= @user.cardano_wallet_address.present? ? '#68d391' : '#fc8181' %>; font-weight: 700; margin: 0; font-size: 16px;"><%= @user.cardano_wallet_address.present? ? 'Connected' : 'Not Connected' %></h3>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-4" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-link" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Wallet Status</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= @user.cardano_wallet_address.present? ? '1' : '0' %> / 1</h3>
        </div>
      </div>
    </div>

    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-md-8 col-md-offset-2" style="margin-bottom: 20px;">
        <div style="background: linear-gradient(135deg, rgba(0,136,204,0.12), rgba(0,180,216,0.08)); border: 1px solid rgba(0,180,216,0.3); border-radius: 14px; padding: 24px 28px; height: 100%;">
          <div style="display: flex; align-items: center; margin-bottom: 20px;">
            <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
              <i class="fa fa-wallet" style="color: white; font-size: 22px;"></i>
            </div>
            <div>
              <h4 style="color: white; font-weight: 700; margin: 0; font-size: 18px;">Cardano Wallet</h4>
              <p style="color: #8892b0; margin: 0; font-size: 13px;">ADA / $BEEP Token</p>
            </div>
          </div>

          <% if @user.cardano_wallet_address.present? %>
            <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Wallet Address</p>
              <code style="color: #00b4d8; word-break: break-all; font-size: 13px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
            </div>
            <% if @wallet_info %>
              <div style="background: rgba(0,0,0,0.15); border-radius: 8px; padding: 12px 16px; margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="color: #8892b0; font-size: 13px;">ADA Balance</span>
                  <span style="color: #00b4d8; font-weight: 700; font-size: 18px;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %> ADA</span>
                </div>
              </div>
            <% end %>
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
              <span style="display: inline-flex; align-items: center; padding: 6px 14px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 12px; font-weight: 600;">
                <i class="fa fa-circle" style="font-size: 8px; margin-right: 6px;"></i> Connected
              </span>
              <%= link_to disconnect_cardano_path, method: :delete, data: { confirm: 'Disconnect your Cardano wallet?' }, style: 'display: inline-block; padding: 8px 18px; background: rgba(245,101,101,0.15); color: #fc8181; border: 1px solid rgba(245,101,101,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 5px;' do %>
                <i class="fa fa-unlink" style="margin-right: 4px;"></i> Disconnect
              <% end %>
            </div>
          <% else %>
            <div style="text-align: center; padding: 10px 0 20px;">
              <p style="color: #8892b0; margin: 0 0 20px; font-size: 14px; line-height: 1.6;">
                Enter your Cardano wallet address to receive $BEEP token rewards.
              </p>
              <%= form_tag(connect_cardano_path, method: :post, id: 'cardano-form') do %>
                <div style="position: relative; margin-bottom: 12px;">
                  <input type="text" name="cardano_address" id="cardano-address-input" placeholder="addr1q..." style="width: 100%; padding: 14px 18px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: white; font-size: 14px; outline: none; box-sizing: border-box;" oninput="validateCardanoAddress()">
                </div>
                <button type="submit" id="cardano-connect-btn" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,136,204,0.35); transition: opacity 0.2s; opacity: 0.5;" disabled onmouseover="if(!this.disabled)this.style.opacity='0.9'" onmouseout="this.style.opacity=this.disabled?'0.5':'1'">
                  <i class="fa fa-wallet" style="margin-right: 8px;"></i> Connect Cardano Wallet
                </button>
              <% end %>
              <p style="color: #8892b0; margin: 10px 0 0; font-size: 12px;">
                <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                Supports Nami, Eternl, and other Cardano wallets
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(108,92,231,0.12), rgba(162,155,254,0.08)); border: 1px solid rgba(162,155,254,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
      <div style="display: flex; align-items: center; margin-bottom: 20px;">
        <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
          <i class="fa fa-right-left" style="color: white; font-size: 18px;"></i>
        </div>
        <div>
          <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Token Swap</h4>
          <p style="color: #8892b0; margin: 0; font-size: 12px;">Exchange ADA for $BEEP tokens</p>
        </div>
      </div>

      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <div style="flex: 1; padding: 12px; background: rgba(0,136,204,0.2); color: #00b4d8; border: 2px solid rgba(0,180,216,0.4); border-radius: 10px; font-size: 14px; font-weight: 700; text-align: center;">
          <i class="fa fa-wallet" style="margin-right: 6px;"></i> ADA &rarr; $BEEP
        </div>
      </div>

      <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; margin-bottom: 14px;">
        <div style="margin-bottom: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Send</p>
          </div>
          <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
            <input type="number" id="swap-input-amount" placeholder="0.00" min="0" step="0.01" style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;" oninput="updateSwapOutput()">
            <div style="display: flex; align-items: center; background: rgba(0,136,204,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
              <span style="color: #00b4d8; font-weight: 700; font-size: 14px;">ADA</span>
            </div>
          </div>
        </div>

        <div style="text-align: center; margin: 12px 0;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(108,92,231,0.3); border: 1px solid rgba(162,155,254,0.4); border-radius: 50%;">
            <i class="fa fa-arrow-down" style="color: #a29bfe; font-size: 14px;"></i>
          </div>
        </div>

        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Receive</p>
            <p style="color: #8892b0; font-size: 12px; margin: 0;">Rate: <span style="color: #a29bfe;">1 ADA = 5.48 $BEEP</span></p>
          </div>
          <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
            <input type="text" id="swap-output-amount" placeholder="0.00" readonly style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;">
            <div style="display: flex; align-items: center; background: rgba(231,76,60,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
              <span style="color: #e74c3c; font-weight: 700; font-size: 14px;">$BEEP</span>
            </div>
          </div>
        </div>
      </div>

      <div style="background: rgba(0,0,0,0.15); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: #8892b0; font-size: 13px;">Exchange Rate</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">1 ADA = 5.48 $BEEP</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: #8892b0; font-size: 13px;">Network Fee</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">~0.17 ADA</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: #8892b0; font-size: 13px;">Estimated Time</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">~1-2 minutes</span>
        </div>
      </div>

      <button onclick="initiateVendingSwap()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(108,92,231,0.35); transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
        Swap for $BEEP
      </button>
      <p style="text-align: center; color: #8892b0; margin: 10px 0 0; font-size: 12px;">
        <i class="fa fa-shield-halved" style="margin-right: 4px;"></i>
        Powered by Cardano blockchain smart contracts
      </p>
      <div id="swap-status" style="display: none; margin-top: 14px;"></div>
    </div>

    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
      <h4 style="color: white; font-weight: 700; margin: 0 0 18px; font-size: 17px;">
        <i class="fa fa-circle-question" style="color: #a29bfe; margin-right: 8px;"></i>Supported Cardano Wallets
      </h4>
      <div style="background: rgba(0,136,204,0.08); border: 1px solid rgba(0,180,216,0.2); border-radius: 10px; padding: 16px 20px;">
        <h5 style="color: #00b4d8; font-weight: 700; margin: 0 0 10px; font-size: 15px;"><i class="fa fa-wallet" style="margin-right: 6px;"></i> Cardano</h5>
        <ul style="color: #8892b0; margin: 0; padding-left: 18px; font-size: 13px; line-height: 2;">
          <li>Nami Wallet</li>
          <li>Eternl (ccvault)</li>
          <li>Flint Wallet</li>
        </ul>
      </div>
    </div>

  </div>
</div>

<script>
  var ADA_RATE = 5.48;

  function updateSwapOutput() {
    var input = document.getElementById('swap-input-amount');
    var output = document.getElementById('swap-output-amount');
    var val = parseFloat(input.value) || 0;
    output.value = val > 0 ? (val * ADA_RATE).toFixed(2) : '';
  }

  function initiateVendingSwap() {
    var amount = parseFloat(document.getElementById('swap-input-amount').value);
    var statusDiv = document.getElementById('swap-status');

    if (!amount || amount <= 0) {
      statusDiv.style.display = 'block';
      statusDiv.innerHTML = '<div style="background: rgba(245,101,101,0.15); border: 1px solid rgba(245,101,101,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i>Please enter a valid amount to swap.</p></div>';
      return;
    }

    var beepAmount = (amount * ADA_RATE).toFixed(2);

    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-spinner fa-spin" style="margin-right: 6px;"></i>Processing swap of ' + amount + ' ADA for ' + beepAmount + ' $BEEP...</p></div>';

    setTimeout(function() {
      statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle" style="margin-right: 6px;"></i>Swap request submitted! Your ' + beepAmount + ' $BEEP will be credited to your account shortly. $BEEP is live on Cardano mainnet.</p></div>';
    }, 2000);
  }

  function validateCardanoAddress() {
    var input = document.getElementById('cardano-address-input');
    var btn = document.getElementById('cardano-connect-btn');
    if (!input || !btn) return;
    var val = input.value.trim();
    var valid = val.length > 50 && (val.startsWith('addr1') || val.startsWith('addr_test1'));
    btn.disabled = !valid;
    btn.style.opacity = valid ? '1' : '0.5';
  }
</script>
