<div class="container" style="padding-top: 20px; padding-bottom: 60px;">

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <h2 style="color: #e74c3c; margin-top: 0;">
        <i class="glyphicon glyphicon-transfer"></i> Transaction History
      </h2>
      <p class="text-muted">Complete record of all your account transactions</p>
    </div>
  </div>

  <div class="row" style="margin-bottom: 20px;">
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 10px;">
      <div class="well text-center" style="margin-bottom: 0;">
        <h4 style="margin: 0; color: #e74c3c;"><%= @account.balance rescue '$0.00' %></h4>
        <small class="text-muted">Current Balance</small>
      </div>
    </div>
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 10px;">
      <div class="well text-center" style="margin-bottom: 0;">
        <h4 style="margin: 0;"><%= @transactions.size %></h4>
        <small class="text-muted">Total Transactions</small>
      </div>
    </div>
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 10px;">
      <div class="well text-center" style="margin-bottom: 0;">
        <h4 style="margin: 0;"><%= @account.promo_balance rescue '$0.00' %></h4>
        <small class="text-muted">Promo Balance</small>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h4 class="panel-title">All Transactions</h4>
        </div>
        <div class="panel-body">
          <% if @transactions.any? %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th class="text-right">Amount</th>
                    <th class="text-right">Balance After</th>
                  </tr>
                </thead>
                <tbody>
                  <% @transactions.each do |txn| %>
                    <tr>
                      <td><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
                      <td><%= txn.description %></td>
                      <td>
                        <span class="label label-default"><%= txn.type.to_s.demodulize.titleize rescue 'Transaction' %></span>
                      </td>
                      <td class="text-right">
                        <% amount_val = txn.amount_cents.to_i rescue 0 %>
                        <span style="color: <%= amount_val >= 0 ? '#27ae60' : '#e74c3c' %>; font-weight: bold;">
                          <%= amount_val >= 0 ? '+' : '' %><%= txn.amount %>
                        </span>
                      </td>
                      <td class="text-right text-muted"><%= txn.account.balance rescue 'N/A' %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center" style="padding: 40px;">
              <i class="glyphicon glyphicon-inbox" style="font-size: 48px; color: #ccc;"></i>
              <h4 class="text-muted" style="margin-top: 15px;">No Transactions Yet</h4>
              <p class="text-muted">Your transaction history will appear here once you enter contests or receive rewards.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <%= link_to '&larr; Back to Dashboard'.html_safe, user_dashboard_path, class: 'btn btn-default' %>
      <%= link_to 'View Wallet', wallet_path, class: 'btn btn-default' %>
    </div>
  </div>

</div>
