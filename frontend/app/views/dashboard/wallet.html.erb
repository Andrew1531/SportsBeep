<style>
  .wallet-page-shell { min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px; }
  .wallet-page-shell .wallet-hero { margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .wallet-page-shell .wallet-hero-copy { min-width: 0; }
  .wallet-page-shell .wallet-hero-title { color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 28px; font-family: 'BebasNeue', sans-serif; letter-spacing: 1px; }
  .wallet-page-shell .wallet-hero-subtitle { color: #8892b0; margin: 0; font-size: 14px; }
  .wallet-page-shell .wallet-back-btn { display: inline-block; padding: 10px 22px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 5px; }
  .wallet-page-shell .wallet-stats-row { margin-bottom: 24px; }
  .wallet-page-shell .wallet-stat-card { background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 18px 14px; text-align: center; min-height: 146px; position: relative; }
  .wallet-page-shell .wallet-stat-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
  .wallet-page-shell .wallet-stat-kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px; color: #8892b0; }
  .wallet-page-shell .wallet-stat-sub { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px; color: #555e73; }
  .wallet-page-shell .wallet-stat-value { font-weight: 700; margin: 0 0 2px; font-size: 22px; }
  .wallet-page-shell .wallet-stat-unit { font-size: 10px; margin: 0; color: #555e73; }
  .wallet-page-shell .wallet-stack-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 18px 22px; }
  @media (max-width: 767px) {
    .wallet-page-shell { padding: 20px 12px 44px; }
    .wallet-page-shell .wallet-hero { margin-bottom: 20px; }
    .wallet-page-shell .wallet-hero-title { font-size: 24px; }
    .wallet-page-shell .wallet-hero-subtitle { font-size: 13px; line-height: 1.5; }
    .wallet-page-shell .wallet-back-btn { width: 100%; text-align: center; margin-top: 0; }
    .wallet-page-shell .wallet-stats-row .col-xs-6 { width: 100%; }
    .wallet-page-shell .wallet-stat-card { padding: 16px 14px; min-height: 132px; border-radius: 14px; }
    .wallet-page-shell .wallet-stat-value { font-size: 20px; }
    .wallet-page-shell .wallet-stack-card { padding: 16px; border-radius: 14px; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head { align-items: flex-start !important; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head > div:first-child { margin-right: 0 !important; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head { gap: 12px; }
  }
</style>

<style>
  /* Wallet terminal: a compact control surface built on the whitepaper system. */
  .wallet-page-shell {
    --wallet-ink: #111521;
    --wallet-deep: #080b12;
    --wallet-panel: #191e2b;
    --wallet-panel-hi: #232b3c;
    --wallet-copy: #f1f3fb;
    --wallet-muted: #9aa4bb;
    --wallet-line: rgba(222,230,255,.14);
    --wallet-orange: #f7760d;
    --wallet-amber: #fbbf24;
    min-height: calc(100dvh - 140px);
    padding: 34px 15px 72px;
    color: var(--wallet-copy);
    background:
      radial-gradient(circle at 8% 0%, rgba(251,191,36,.11), transparent 28%),
      radial-gradient(circle at 94% 6%, rgba(247,118,13,.09), transparent 26%),
      var(--wallet-ink);
    position: relative;
  }
  .wallet-page-shell::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: .07;
    background-image: radial-gradient(rgba(255,255,255,.55) .4px, transparent .65px);
    background-size: 5px 5px;
    mix-blend-mode: soft-light;
  }
  .wallet-page-shell > .container { position: relative; z-index: 1; max-width: 1180px; }
  .wallet-page-shell .wallet-hero {
    padding: 0 0 22px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--wallet-line);
  }
  .wallet-page-shell .wallet-hero-title {
    color: var(--wallet-copy);
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .wallet-page-shell .wallet-hero-title i { color: var(--wallet-orange) !important; }
  .wallet-page-shell .wallet-hero-subtitle { color: var(--wallet-muted); font-size: 13px; }
  .wallet-page-shell .wallet-back-btn {
    border-radius: 3px;
    border-color: rgba(247,118,13,.42);
    background: rgba(247,118,13,.06);
    color: var(--wallet-orange);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: .04em;
  }
  .wallet-page-shell .wallet-back-btn:hover { background: var(--wallet-orange); color: var(--wallet-ink); }
  .wallet-swap-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 22px;
    padding: 12px 19px;
    border: 1px solid var(--wallet-orange);
    border-radius: 3px;
    background: var(--wallet-orange);
    color: var(--wallet-ink);
    font: 800 16px/1 'Barlow Condensed', sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease;
  }
  .wallet-swap-cta:hover { background: #ff8b2c; transform: translateY(-2px); }
  .wallet-swap-cta:focus-visible,
  .wallet-page-shell button:focus-visible,
  .wallet-page-shell select:focus-visible,
  .wallet-page-shell input:focus-visible { outline: 2px solid var(--wallet-orange) !important; outline-offset: 3px; }
  .wallet-token-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 14px 16px;
    margin-bottom: 18px;
    border: 1px solid var(--wallet-line);
    border-left: 2px solid var(--wallet-orange);
    background: linear-gradient(90deg, rgba(247,118,13,.1), rgba(25,30,43,.72) 40%);
  }
  .wallet-token-bar label, .wallet-token-bar .wallet-token-meta {
    color: var(--wallet-muted);
    font: 700 10px/1.4 'DM Mono', monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .wallet-token-bar label strong, .wallet-token-bar .wallet-token-meta strong { color: var(--wallet-copy); }
  .wallet-token-bar select {
    min-width: 170px;
    padding: 8px 30px 8px 10px !important;
    border: 1px solid rgba(247,118,13,.5) !important;
    border-radius: 3px !important;
    background: var(--wallet-deep) !important;
    color: var(--wallet-copy) !important;
    font: 700 12px 'DM Mono', monospace;
  }
  .wallet-overview {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 24px;
    border: 1px solid var(--wallet-line);
    background: var(--wallet-line);
  }
  .wallet-overview__item { min-height: 88px; padding: 14px 15px; background: var(--wallet-panel); }
  .wallet-overview__label {
    margin: 0 0 8px;
    color: var(--wallet-muted);
    font: 700 9px/1.2 'DM Mono', monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .wallet-overview__value { margin: 0; color: var(--wallet-copy); font: 700 21px/1 'DM Mono', monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wallet-overview__unit { color: var(--wallet-muted); font-size: 10px; }
  .wallet-overview__status { color: #68d391; }
  .wallet-overview__action {
    display: inline-block;
    margin-top: 7px;
    padding: 4px 8px;
    border: 1px solid rgba(247,118,13,.55);
    border-radius: 2px;
    background: rgba(247,118,13,.08);
    color: var(--wallet-orange);
    font: 700 9px/1.2 'DM Mono', monospace;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .wallet-network-details {
    margin: -12px 0 22px;
    border: 1px solid var(--wallet-line);
    border-left: 2px solid rgba(247,118,13,.55);
    background: rgba(8,11,18,.48);
  }
  .wallet-network-details summary {
    padding: 9px 12px;
    color: var(--wallet-muted);
    font: 700 9px/1.4 'DM Mono', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .wallet-network-details__body {
    padding: 0 12px 11px;
    color: var(--wallet-muted);
    font-size: 11px;
    line-height: 1.6;
  }
  .wallet-activity-strip {
    display: flex;
    gap: 18px;
    margin: -7px 0 20px;
    color: var(--wallet-muted);
    font: 700 10px/1.5 'DM Mono', monospace;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .wallet-activity-strip strong { color: var(--wallet-copy); }
  .wallet-page-shell .wallet-stat-card, .wallet-page-shell .wallet-stack-card {
    border-radius: 5px !important;
    background: rgba(25,30,43,.9) !important;
    border-color: var(--wallet-line) !important;
    box-shadow: 0 12px 35px rgba(0,0,0,.14);
  }
  .wallet-page-shell .wallet-stat-card { border-top: 2px solid rgba(247,118,13,.5) !important; }
  .wallet-page-shell .wallet-stat-icon { border-radius: 3px; }
  .wallet-page-shell .wallet-stat-kicker,
  .wallet-page-shell .wallet-stat-sub,
  .wallet-page-shell .wallet-stack-card p[style*="text-transform"] {
    font-family: 'DM Mono', monospace !important;
  }
  .wallet-page-shell > .container > div[style*="display: flex"][style*="margin-bottom: 24px"] {
    gap: 0 !important;
    padding: 3px !important;
    border: 1px solid var(--wallet-line);
    border-radius: 4px !important;
    background: rgba(255,255,255,.045) !important;
  }
  .wallet-page-shell > .container > div[style*="display: flex"][style*="margin-bottom: 24px"] button {
    border-radius: 3px !important;
    font-family: 'Barlow Condensed', sans-serif !important;
    letter-spacing: .1em !important;
  }
  .wallet-page-shell > .container > div[style*="display: flex"][style*="margin-bottom: 24px"] button[style*="linear-gradient"] {
    background: var(--wallet-orange) !important;
    color: var(--wallet-ink) !important;
  }
  .wallet-page-shell input, .wallet-page-shell textarea {
    border-radius: 3px !important;
    background: #0e121d !important;
    border-color: var(--wallet-line) !important;
  }
  #panel-swap > div,
  #panel-history > div {
    background: var(--wallet-panel) !important;
    border-color: var(--wallet-line) !important;
    border-radius: 5px !important;
  }
  #panel-swap > div > div[style*="rgba(0,0,0,0.25)"],
  #panel-swap > div > div[style*="rgba(0,0,0,0.15)"] {
    background: var(--wallet-deep) !important;
    border-radius: 3px !important;
  }
  #panel-swap select {
    background: var(--wallet-deep) !important;
    color: var(--wallet-copy) !important;
    border: 1px solid var(--wallet-line) !important;
    border-radius: 3px !important;
  }
  #panel-swap button[onclick="initiateSwap()"] {
    background: var(--wallet-orange) !important;
    color: var(--wallet-ink) !important;
    border-radius: 3px !important;
    box-shadow: none !important;
    font-family: 'Barlow Condensed', sans-serif !important;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #panel-wallets button[onclick="openWalletModal()"],
  #panel-wallets .wallet-stack-head > div:first-child {
    background: var(--wallet-orange) !important;
    color: var(--wallet-ink) !important;
    box-shadow: none !important;
  }
  #panel-wallets button[onclick="openWalletModal()"] i,
  #panel-wallets .wallet-stack-head > div:first-child i { color: var(--wallet-ink) !important; }
  #tab-wallets[style*="linear-gradient"],
  #tab-swap[style*="linear-gradient"],
  #tab-history[style*="linear-gradient"] {
    background: var(--wallet-orange) !important;
    color: var(--wallet-ink) !important;
  }
  @media (max-width: 850px) {
    .wallet-overview { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wallet-overview__item:last-child { grid-column: span 2; }
  }
  @media (max-width: 600px) {
    .wallet-page-shell { padding: 24px 12px 48px; }
    .wallet-page-shell .wallet-hero-title { font-size: 27px; }
    .wallet-swap-cta { width: 100%; justify-content: center; }
    .wallet-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wallet-overview__item { min-height: 78px; padding: 12px; }
    .wallet-overview__value { font-size: 17px; }
    .wallet-token-bar { align-items: stretch; flex-direction: column; gap: 10px; }
    .wallet-token-bar select { width: 100%; }
  }
</style>

<div class="wallet-page-shell">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="wallet-hero">
      <div class="wallet-hero-copy">
        <h2 class="wallet-hero-title">
          <i class="fa fa-wallet" style="color: #a29bfe; margin-right: 10px;"></i>MY WALLET
        </h2>
        <p class="wallet-hero-subtitle">Balances, wallets, swaps &amp; transactions — all in one place</p>
      </div>
      <%= link_to user_dashboard_path, class: 'wallet-back-btn' do %>
        <i class="fa fa-arrow-left" style="margin-right: 6px;"></i> Dashboard
      <% end %>
    </div>
    <button type="button" class="wallet-swap-cta" onclick="showWalletTab('swap')" aria-controls="panel-swap">
      <i class="fa fa-right-left" aria-hidden="true"></i> Swap assets
    </button>
    <% if @approved_tokens.present? %>
      <div class="wallet-token-bar" style="margin:0 0 18px;color:white;">
        <label for="wallet-token-picker" style="margin-right:8px;">Game token</label>
        <select id="wallet-token-picker" onchange="window.location=this.value" style="color:#111;padding:7px;">
          <% @approved_tokens.each do |token| %>
            <% balance = @token_balances[token] %>
            <option value="<%= wallet_path(token_id: token.id) %>" <%= 'selected' if token == @selected_token %>><%= token.ticker %> — <%= token.format_units(balance.balance_units) %></option>
          <% end %>
        </select>
        <% if @selected_token %>
          <span class="wallet-token-meta"><strong><%= @selected_token.ticker %></strong> selected · balances below</span>
        <% end %>
      </div>
      <% if @selected_token %>
        <% token_step = @selected_token.decimals.to_i.zero? ? '1' : "0.#{'0' * (@selected_token.decimals.to_i - 1)}1" %>
        <% selected_game_units = @token_balances[@selected_token].balance_units.to_i %>
        <% selected_game_balance = @selected_token.format_units(selected_game_units) %>
      <% end %>
    <% end %>

    <% if @selected_token %>
      <% overview_game_units = @token_balances[@selected_token].balance_units.to_i %>
      <div class="wallet-overview" aria-label="Wallet overview">
        <div class="wallet-overview__item">
          <p class="wallet-overview__label">Selected token</p>
          <p class="wallet-overview__value"><%= @selected_token.ticker %></p>
          <span class="wallet-overview__unit">active asset</span>
        </div>
        <div class="wallet-overview__item">
          <p class="wallet-overview__label">Game balance</p>
          <p class="wallet-overview__value"><%= @selected_token.format_units(overview_game_units) %></p>
          <span class="wallet-overview__unit">play credit</span>
        </div>
        <div class="wallet-overview__item">
          <p class="wallet-overview__label">On-chain wallet</p>
          <p class="wallet-overview__value"><%= @selected_token.format_units(@selected_token_on_chain.to_i) %></p>
          <span class="wallet-overview__unit"><%= @selected_token.ticker %></span>
        </div>
        <div class="wallet-overview__item">
          <p class="wallet-overview__label">Total in play</p>
          <p class="wallet-overview__value"><%= @selected_token.format_units(@active_wager_total.to_i) %></p>
          <span class="wallet-overview__unit"><%= @selected_token.ticker %> committed</span>
        </div>
        <div class="wallet-overview__item">
          <p class="wallet-overview__label">Connection</p>
          <% if @user.cardano_wallet_verified_at.present? %>
            <p class="wallet-overview__value wallet-overview__status">Verified</p>
            <span class="wallet-overview__unit">Cardano wallet</span>
          <% elsif @user.cardano_wallet_address.present? %>
            <p class="wallet-overview__value" style="color:#fbbf24;">Action needed</p>
            <span class="wallet-overview__unit">verify ownership</span>
          <% else %>
            <p class="wallet-overview__value" style="color:#ff6b7c;">Offline</p>
            <span class="wallet-overview__unit">connect wallet</span>
            <button type="button" class="wallet-overview__action" onclick="openWalletModal()">Connect</button>
          <% end %>
        </div>
      </div>
      <details class="wallet-network-details">
        <summary>Network and treasury status</summary>
        <div class="wallet-network-details__body">
          <strong><%= @selected_token.ticker %></strong> on-chain: <%= @selected_token.format_units(@selected_token_on_chain.to_i) %>
          · Treasury token availability: <%= @selected_token.format_units(@treasury_token_units.to_i) %> <%= @selected_token.ticker %>
          · Treasury ADA availability: <%= @treasury_lovelace.to_i %> lovelace.
          <% if @treasury_token_units.to_i <= 0 %><span style="color:#fc8181;"> Treasury currently cannot pay this token.</span><% end %>
          <span> Payouts require ADA for fees and minimum UTxO; a build failure is not charged.</span>
        </div>
      </details>
    <% end %>

    <div class="wallet-activity-strip" aria-label="Account activity">
      <span>Referrals <strong><%= @referral_count rescue 0 %></strong></span>
      <span>All-time wagers <strong><%= @total_wager_count rescue 0 %></strong></span>
    </div>

    <div style="display: flex; gap: 6px; margin-bottom: 24px; background: rgba(255,255,255,0.04); border-radius: 12px; padding: 4px;">
      <button onclick="showWalletTab('wallets')" id="tab-wallets" style="flex: 1; padding: 11px 0; background: #f7760d; color: #111521; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-link" style="margin-right: 5px;"></i> WALLETS
      </button>
      <button onclick="showWalletTab('swap')" id="tab-swap" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-right-left" style="margin-right: 5px;"></i> SWAP
      </button>
      <button onclick="showWalletTab('history')" id="tab-history" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-receipt" style="margin-right: 5px;"></i> HISTORY
      </button>
    </div>

    <div id="panel-wallets">
      <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-md-8 col-md-offset-2" style="margin-bottom: 20px;">
          <div class="wallet-stack-card" style="background: linear-gradient(135deg, rgba(0,136,204,0.12), rgba(0,180,216,0.08)); border-color: rgba(0,180,216,0.3);">
            <div class="wallet-stack-head" style="display: flex; align-items: center; margin-bottom: 20px;">
              <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 14px; flex-shrink: 0;">
                <i class="fa fa-wallet" style="color: white; font-size: 22px;"></i>
              </div>
              <div style="flex: 1;">
                <h4 style="color: white; font-weight: 700; margin: 0; font-size: 18px;">Cardano</h4>
                <p style="color: #8892b0; margin: 0; font-size: 13px;">ADA / approved native tokens</p>
              </div>
              <% if @user.cardano_wallet_verified_at.present? %>
                <span style="padding: 5px 14px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fa fa-check" style="font-size: 9px; margin-right: 4px;"></i> Verified</span>
              <% elsif @user.cardano_wallet_address.present? %>
                <span style="padding: 5px 14px; background: rgba(246,173,85,0.15); color: #f6ad55; border: 1px solid rgba(246,173,85,0.3); border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fa fa-triangle-exclamation" style="font-size: 9px; margin-right: 4px;"></i> Verification required</span>
              <% else %>
                <span style="padding: 5px 14px; background: rgba(245,101,101,0.1); color: #fc8181; border: 1px solid rgba(245,101,101,0.2); border-radius: 20px; font-size: 12px; font-weight: 600;">Not Connected</span>
              <% end %>
            </div>

            <% if @user.cardano_wallet_address.present? %>
              <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
                <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Address</p>
                <code style="color: #00b4d8; word-break: break-all; font-size: 13px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
              </div>

              <% unless @user.cardano_wallet_verified_at.present? %>
                <div style="background: rgba(246,173,85,0.12); border: 1px solid rgba(246,173,85,0.4); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;">
                  <p style="color: #f6ad55; font-size: 13px; margin: 0 0 10px; line-height: 1.5;">
                     This address was connected before signature verification was introduced. Reconnect with the same wallet and sign the free verification message before transferring approved tokens.
                  </p>
                  <button onclick="openWalletModal()" style="width: 100%; padding: 11px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                    <i class="fa fa-signature" style="margin-right: 6px;"></i> Verify Wallet Ownership
                  </button>
                </div>
              <% end %>

              <% wallet_status = @wallet_info ? @wallet_info[:status] : nil %>

              <% if wallet_status == 'not_found' && !on_chain_mode? %>
                <%# Address unused on-chain — help user connect the right address %>
                <div style="background: rgba(255,165,0,0.12); border: 1px solid rgba(255,165,0,0.35); border-radius: 10px; padding: 16px 18px; margin-bottom: 14px;">
                  <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <i class="fa fa-triangle-exclamation" style="color: #f6ad55; font-size: 20px; margin-top: 2px; flex-shrink: 0;"></i>
                    <div>
                      <p style="color: #f6ad55; font-weight: 700; font-size: 14px; margin: 0 0 6px;">Address has no on-chain activity</p>
                      <p style="color: #a0aec0; font-size: 13px; margin: 0 0 8px; line-height: 1.5;">
                        Your connected address hasn't been used on Cardano yet, or your tokens are held across multiple wallet addresses. Reconnect with your wallet extension to link the right account.
                      </p>
                    </div>
                  </div>
                </div>

                <div style="margin-bottom: 14px;">
                  <button onclick="openWalletModal()" style="width: 100%; padding: 11px; background: rgba(255,165,0,0.2); color: #f6ad55; border: 1px solid rgba(255,165,0,0.4); border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                    <i class="fa fa-rotate" style="margin-right: 6px;"></i> Reconnect Wallet
                  </button>
                </div>

              <% elsif @wallet_info && (wallet_status == 'active' || (on_chain_mode? && wallet_status == 'not_found')) %>
                <div style="display: flex; gap: 10px; margin-bottom: 14px;">
                  <div style="flex: 1; background: rgba(0,0,0,0.2); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">ADA Balance</p>
                    <span style="color: #00b4d8; font-weight: 700; font-size: 20px;"><%= sprintf('%.2f', @wallet_info[:ada_balance].to_f) %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">ADA</span>
                  </div>
                  <div style="flex: 1; background: rgba(231,76,60,0.12); border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Connected Wallet <%= @selected_token&.ticker %></p>
                    <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= @selected_token ? @selected_token.format_units(@selected_token_on_chain.to_i) : '0' %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">on-chain</span>
                  </div>
                </div>

                <% platform_units = selected_game_units %>
                <% available_to_load = (@available_to_load_beep.to_i rescue 0) %>
                <% withdrawable = (@withdrawable_beep.to_i rescue 0) %>

                <div style="background: rgba(0,0,0,0.2); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                    <div>
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Game Balance</p>
                      <span style="color: #00c853; font-weight: 700; font-size: 20px;"><%= selected_game_balance %> <span style="font-size: 12px; color: #8892b0;"><%= @selected_token.ticker %></span></span>
                    </div>
                    <div style="text-align: right;">
                      <p style="color: #8892b0; font-size: 11px; margin: 0 0 2px;">Available in Wallet</p>
                       <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= @selected_token.format_units(@selected_token_on_chain.to_i) %> <span style="font-size: 12px; color: #8892b0;"><%= @selected_token.ticker %></span></span>
                    </div>
                  </div>

                  <% if on_chain_mode? %>
                    <div style="background: rgba(0,136,204,0.08); border: 1px solid rgba(0,180,216,0.25); border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;">
                      <p style="color: #7fc9e8; font-size: 12px; margin: 0; line-height: 1.5;">
                        <i class="fa fa-link" style="margin-right: 6px; color: #00b4d8;"></i>
                         Loading and withdrawing are <strong>real on-chain transfers</strong>. Loading sends the selected approved token from your wallet to the SportsBeep treasury (you sign in your wallet); withdrawing sends that token back. Every transfer gets a transaction hash you can verify on a Cardano explorer.
                      </p>
                    </div>

                    <% ada_bal = @wallet_info[:ada_balance].to_f rescue 0.0 %>
                    <% if ada_bal < 3.0 %>
                      <div style="background: rgba(246,173,85,0.12); border: 1px solid rgba(246,173,85,0.4); border-radius: 8px; padding: 12px 14px; margin-bottom: 14px;">
                        <p style="color: #f6ad55; font-size: 13px; margin: 0; line-height: 1.6;">
                          <i class="fa fa-triangle-exclamation" style="margin-right: 6px;"></i>
                          <strong>Not enough ADA to cover fees.</strong>
                          You have <%= sprintf('%.2f', ada_bal) %> ADA — on-chain deposits require at least 3 ADA in your wallet to pay for the transaction fee and the minimum ADA that must travel with the tokens. Send yourself 3–5 ADA from an exchange or another wallet, then try again.
                        </p>
                      </div>
                    <% end %>

                    <!-- ON-CHAIN DEPOSIT -->
                    <div style="margin-bottom: 12px;">
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Load approved token (on-chain deposit)</p>
                       <input type="hidden" id="onchain-token-id" value="<%= @selected_token.id %>">
                       <p style="color:#b8dfff;font-size:12px;margin:0 0 8px;">Using selected token: <strong><%= @selected_token.ticker %></strong></p>
                      <div style="display: flex; gap: 8px;">
                        <input type="number" id="onchain-deposit-amount" min="<%= token_step %>" step="<%= token_step %>" placeholder="Amount" inputmode="decimal"
                               style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                        <button onclick="try { startOnchainDeposit(); } catch(err) { alert('Load failed to start: ' + err.message + '. Try a hard refresh (Cmd+Shift+R).'); }" id="onchain-deposit-btn"
                                style="white-space: nowrap; padding: 12px 18px; background: linear-gradient(135deg, #00c853, #00a844); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,200,83,0.3);">
                          <i class="fa fa-download" style="margin-right: 6px;"></i> Load
                        </button>
                      </div>
                      <div id="onchain-deposit-status" style="display:none; margin-top: 8px;"></div>
                    </div>

                    <!-- ON-CHAIN WITHDRAW -->
                    <%= form_tag(withdraw_beep_path, method: :post, data: { confirm: 'This sends the selected approved token from the treasury to your wallet on the Cardano blockchain. Continue?' }) do %>
                      <%= hidden_field_tag :request_key, SecureRandom.uuid %>
                      <%= hidden_field_tag :approved_token_id, @selected_token&.id, id: 'withdraw-token-id' %>
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Withdraw selected token (on-chain payout)</p>
                       <% max_onchain_withdraw = platform_units %>
                      <div style="display: flex; gap: 8px;">
                        <input type="number" name="amount" min="<%= token_step %>" step="<%= token_step %>" max="<%= @selected_token.format_units(max_onchain_withdraw) %>"
                               placeholder="Amount" inputmode="decimal"
                               <%= 'disabled' if max_onchain_withdraw <= 0 %>
                               style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                        <button type="submit" <%= 'disabled' if max_onchain_withdraw <= 0 %>
                                style="white-space: nowrap; padding: 12px 18px; background: rgba(231,76,60,0.15); color: #fc8181; border: 1px solid rgba(231,76,60,0.35); border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= max_onchain_withdraw <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= max_onchain_withdraw <= 0 ? '0.5' : '1' %>;">
                          <i class="fa fa-upload" style="margin-right: 6px;"></i> Withdraw
                        </button>
                      </div>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        <% if max_onchain_withdraw <= 0 %>
                          No game balance available to withdraw.
                        <% else %>
                           Up to <%= @selected_token.format_units(max_onchain_withdraw) %> <%= @selected_token.ticker %> can be sent to your verified wallet on-chain.
                        <% end %>
                      </p>
                    <% end %>

                     <% recent_transfers = @chain_transfers %>
                    <% if recent_transfers.any? %>
                      <div style="margin-top: 14px; background: rgba(0,0,0,0.15); border-radius: 8px; padding: 10px 12px;">
                        <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 8px;">Recent on-chain transfers</p>
                        <% recent_transfers.each do |t| %>
                          <div style="display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 12px;">
                            <span style="color: <%= t.direction == 'deposit' ? '#68d391' : '#fc8181' %>;">
                              <i class="fa fa-<%= t.direction == 'deposit' ? 'download' : 'upload' %>" style="margin-right: 4px;"></i>
                               <%= t.direction.capitalize %> <%= @selected_token.format_units(t.amount_in_units) %> <%= @selected_token.ticker %>
                            </span>
                            <span>
                              <% status_color = { 'pending' => '#f6ad55', 'submitting' => '#f6ad55', 'submitted' => '#63b3ed', 'confirmed' => '#68d391', 'credited' => '#68d391', 'failed' => '#fc8181', 'unknown' => '#f6ad55' }[t.status] || '#8892b0' %>
                              <span style="color: <%= status_color %>; margin-right: 8px;"><%= t.status %></span>
                              <% if t.explorer_url %>
                                <a href="<%= t.explorer_url %>" target="_blank" rel="noopener" style="color: #00b4d8; text-decoration: none;"><i class="fa fa-arrow-up-right-from-square"></i></a>
                              <% end %>
                            </span>
                          </div>
                        <% end %>
                        <% if recent_transfers.any? { |t| t.direction == 'deposit' && t.status == 'pending' } %>
                          <script>document.addEventListener('DOMContentLoaded', function() { pollDepositStatus(); });</script>
                        <% end %>
                      </div>
                    <% end %>
                  <% else %>
                  <div style="background: rgba(0,200,83,0.08); border: 1px solid rgba(0,200,83,0.25); border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;">
                    <p style="color: #9fd9b4; font-size: 12px; margin: 0; line-height: 1.5;">
                      <i class="fa fa-shield-halved" style="margin-right: 6px; color: #00c853;"></i>
                      Your real $BEEP always stays in your own wallet. Holding $BEEP simply unlocks play credit to wager with — loading and removing never moves any tokens on-chain.
                    </p>
                  </div>

                  <!-- LOAD to game -->
                  <%= form_tag(load_beep_path, method: :post, style: 'margin-bottom: 12px;') do %>
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Unlock play credit</p>
                    <div style="display: flex; gap: 8px;">
                      <input type="number" name="amount" min="1" step="1" max="<%= available_to_load %>"
                             placeholder="Amount" inputmode="numeric"
                             <%= 'disabled' if available_to_load <= 0 %>
                             style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                      <button type="submit" <%= 'disabled' if available_to_load <= 0 %>
                              style="white-space: nowrap; padding: 12px 18px; background: linear-gradient(135deg, #00c853, #00a844); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= available_to_load <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= available_to_load <= 0 ? '0.5' : '1' %>; box-shadow: 0 4px 15px rgba(0,200,83,0.3);">
                        <i class="fa fa-download" style="margin-right: 6px;"></i> Load
                      </button>
                    </div>
                    <% if available_to_load <= 0 %>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                        <% if @on_chain_beep.to_i == 0 %>
                          No $BEEP detected in your connected wallet.
                        <% else %>
                          All of your on-chain $BEEP is already loaded into the game.
                        <% end %>
                      </p>
                    <% else %>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        You hold <%= available_to_load %> $BEEP — choose how much play credit to unlock. Your tokens stay in your wallet.
                      </p>
                    <% end %>
                  <% end %>

                  <!-- REMOVE play credit -->
                  <%= form_tag(withdraw_beep_path, method: :post) do %>
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Remove play credit</p>
                    <div style="display: flex; gap: 8px;">
                      <input type="number" name="amount" min="1" step="1" max="<%= withdrawable %>"
                             placeholder="Amount" inputmode="numeric"
                             <%= 'disabled' if withdrawable <= 0 %>
                             style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                      <button type="submit" <%= 'disabled' if withdrawable <= 0 %>
                              style="white-space: nowrap; padding: 12px 18px; background: rgba(231,76,60,0.15); color: #fc8181; border: 1px solid rgba(231,76,60,0.35); border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= withdrawable <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= withdrawable <= 0 ? '0.5' : '1' %>;">
                        <i class="fa fa-upload" style="margin-right: 6px;"></i> Remove
                      </button>
                    </div>
                    <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                      <% if withdrawable <= 0 %>
                        No wallet-backed play credit available to remove.
                      <% else %>
                        Up to <%= withdrawable %> $BEEP of play credit can be removed (nothing is sent on-chain).
                      <% end %>
                    </p>
                  <% end %>
                  <% end %>
                </div>

                <% if (begin; @wallet_info[:stake_address].present?; rescue; false; end) %>
                  <div style="background: rgba(0,0,0,0.1); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
                    <p style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Stake Key</p>
                    <code style="color: #63b3ed; word-break: break-all; font-size: 11px;"><%= @wallet_info[:stake_address] %></code>
                  </div>
                <% end %>

              <% else %>
                <div style="background: rgba(255,200,0,0.1); border: 1px solid rgba(255,200,0,0.2); border-radius: 8px; padding: 12px 16px; margin-bottom: 14px; text-align: center;">
                  <i class="fa fa-spinner fa-spin" style="color: #ffc107; margin-right: 6px;"></i>
                  <span style="color: #ffc107; font-size: 13px;">Reading blockchain data...</span>
                </div>
              <% end %>

            <%= link_to disconnect_cardano_path(redirect_to: wallet_path), method: :delete, data: { confirm: 'Disconnect your Cardano wallet?' }, style: 'display: inline-block; padding: 9px 20px; background: rgba(245,101,101,0.15); color: #fc8181; border: 1px solid rgba(245,101,101,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; width: 100%; text-align: center;' do %>
                <i class="fa fa-unlink" style="margin-right: 5px;"></i> Disconnect
              <% end %>
            <% else %>
              <div style="text-align: center; padding: 10px 0 16px;">
                <p style="color: #8892b0; margin: 0 0 18px; font-size: 14px; line-height: 1.6;">
                  Connect your Cardano wallet extension to link your approved-token holdings. You'll sign a free one-time message to prove ownership.
                </p>
                <button onclick="openWalletModal()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,136,204,0.35);" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                  <i class="fa fa-wallet" style="margin-right: 8px;"></i> Connect Cardano Wallet
                </button>
                <p style="color: #8892b0; margin: 10px 0 0; font-size: 12px;">
                  <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                  Eternl, Nami, Lace, Flint &amp; other CIP-30 wallets supported
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="wallet-stack-card">
        <h5 style="color: #8892b0; font-weight: 600; margin: 0 0 14px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
          <i class="fa fa-circle-question" style="margin-right: 6px;"></i>Supported Cardano Wallets
        </h5>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;"><i class="fa fa-wallet" style="margin-right: 4px;"></i> Nami</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Eternl</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Flint</span>
        </div>
      </div>
    </div>

    <div id="panel-swap" style="display: none;">
      <div style="background: linear-gradient(135deg, rgba(108,92,231,0.12), rgba(162,155,254,0.08)); border: 1px solid rgba(162,155,254,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 20px;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
            <i class="fa fa-right-left" style="color: white; font-size: 18px;"></i>
          </div>
          <div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Token Swap</h4>
            <p style="color: #8892b0; margin: 0; font-size: 12px;">Exchange crypto for $BEEP tokens</p>
          </div>
        </div>

        <div style="margin-bottom:20px;"><select id="swap-asset" onchange="updateSwapOutput()" style="width:100%;padding:12px;color:#111;"><option>Loading accepted assets…</option></select></div>

        <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; margin-bottom: 14px;">
          <div style="margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Send</p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
               <input type="number" id="swap-input-amount" placeholder="0.00" min="0" step="any" style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;" oninput="updateSwapOutput()">
              <div id="swap-input-label" style="display: flex; align-items: center; background: rgba(0,136,204,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                 <span id="swap-input-ticker" style="color: #00b4d8; font-weight: 700; font-size: 14px;">—</span>
              </div>
            </div>
          </div>

          <div style="text-align: center; margin: 12px 0;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(108,92,231,0.3); border: 1px solid rgba(162,155,254,0.4); border-radius: 50%;">
              <i class="fa fa-arrow-down" style="color: #a29bfe; font-size: 14px;"></i>
            </div>
          </div>

          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Receive</p>
               <p style="color: #8892b0; font-size: 12px; margin: 0;" id="swap-rate-label">Request a live quote</p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
              <input type="text" id="swap-output-amount" placeholder="0.00" readonly style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;">
              <div style="display: flex; align-items: center; background: rgba(231,76,60,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                <span style="color: #e74c3c; font-weight: 700; font-size: 14px;">$BEEP</span>
              </div>
            </div>
          </div>
        </div>

        <div style="background: rgba(0,0,0,0.15); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Exchange Rate</span>
             <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-rate-detail">—</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Network Fee</span>
            <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-fee-detail">~0.17 ADA</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: #8892b0; font-size: 13px;">Estimated Time</span>
            <span style="color: white; font-size: 13px; font-weight: 600;">~1-2 minutes</span>
          </div>
        </div>

         <div style="margin:0 0 12px;color:#fff"><label><input type="radio" name="swap-payout" value="wallet" checked> Send BEEP to wallet</label> <label style="margin-left:12px"><input type="radio" name="swap-payout" value="game_balance"> Credit game balance</label></div>
         <button onclick="initiateSwap()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(108,92,231,0.35); transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          Swap for $BEEP
        </button>
        <p style="text-align: center; color: #8892b0; margin: 10px 0 0; font-size: 12px;">
          <i class="fa fa-shield-halved" style="margin-right: 4px;"></i>
          Powered by blockchain smart contracts
        </p>
        <div id="swap-status" style="display: none; margin-top: 14px;"></div>
        <% if @swaps.any? %>
          <div style="margin-top:16px;color:#fff"><strong>Recent swaps</strong>
            <% @swaps.each do |swap| %>
              <div style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:12px">
                <%= swap.swap_asset.format_units(swap.amount_units) %> <%= swap.swap_asset.ticker %> → <%= swap.beep_amount %> BEEP · <%= swap.status %>
                <a href="<%= swap.source_explorer_url %>" target="_blank" rel="noopener">input</a>
                <% if swap.payout_explorer_url %> · <a href="<%= swap.payout_explorer_url %>" target="_blank" rel="noopener">payout</a><% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div id="panel-history" style="display: none;">
      <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
        <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #fdcb6e, #e17055); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
              <i class="fa fa-clock-rotate-left" style="color: white; font-size: 16px;"></i>
            </div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;">Transaction History</h4>
          </div>
          <% if @transactions.any? %>
            <%= link_to user_transactions_path(token_id: @selected_token&.id), style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
              View All <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
            <% end %>
          <% end %>
        </div>

        <% if @transactions.any? %>
            <% @transactions.each do |txn| %>
              <% amount_units = txn.amount_units.to_i %>
              <% token_transaction = txn.approved_token_id.present? && txn.approved_token_id == @selected_token&.id %>
              <% display_amount = token_transaction ? @selected_token.format_units(amount_units.abs) : txn.amount %>
              <% positive_amount = token_transaction ? amount_units >= 0 : txn.amount_cents.to_i >= 0 %>
            <div style="padding: 14px 22px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center;">
                <div style="width: 36px; height: 36px; background: <%= positive_amount ? 'rgba(0,184,148,0.15)' : 'rgba(231,76,60,0.15)' %>; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                  <i class="fa <%= positive_amount ? 'fa-arrow-down' : 'fa-arrow-up' %>" style="color: <%= positive_amount ? '#00b894' : '#e74c3c' %>; font-size: 14px;"></i>
                </div>
                <div>
                  <p style="color: white; margin: 0; font-size: 14px; font-weight: 600;"><%= txn.description %></p>
                  <p style="color: #8892b0; margin: 0; font-size: 12px;"><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></p>
                </div>
              </div>
              <span style="color: <%= positive_amount ? '#00b894' : '#e74c3c' %>; font-weight: 700; font-size: 15px;">
                <%= positive_amount ? '+' : '−' %><%= display_amount %><%= " #{@selected_token.ticker}" if token_transaction %>
              </span>
            </div>
          <% end %>
        <% else %>
          <div style="padding: 50px 20px; text-align: center;">
            <i class="fa fa-receipt" style="font-size: 40px; color: rgba(255,255,255,0.12); margin-bottom: 14px; display: block;"></i>
            <p style="color: #8892b0; margin: 0 0 4px; font-size: 15px; font-weight: 600;">No transactions yet</p>
            <p style="color: rgba(255,255,255,0.3); margin: 0; font-size: 13px;">Your wallet activity will appear here.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<!-- Deposit progress modal -->
<div id="deposit-modal" style="display:none; position:fixed; inset:0; background:rgba(5,10,25,0.85); z-index:9999; align-items:center; justify-content:center; backdrop-filter: blur(4px);">
  <div style="background:#0f1b33; border:1px solid rgba(0,180,216,0.3); border-radius:16px; max-width:420px; width:92%; padding:28px 26px; box-shadow:0 20px 60px rgba(0,0,0,0.6);">
    <h3 id="deposit-modal-title" style="color:white; font-size:18px; font-weight:700; margin:0 0 4px;">Loading your selected token</h3>
    <p id="deposit-modal-subtitle" style="color:#8892b0; font-size:13px; margin:0 0 20px; line-height:1.5;">This is a real blockchain transfer — it takes about a minute.</p>

    <div id="deposit-steps">
      <div class="dep-step" id="dep-step-1" style="display:flex; align-items:flex-start; gap:12px; padding:10px 0;">
        <span class="dep-icon" style="width:26px; height:26px; flex-shrink:0; border-radius:50%; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; font-size:12px; color:#8892b0;">1</span>
        <div><p style="color:white; font-size:14px; font-weight:600; margin:0;">Getting things ready</p>
        <p style="color:#8892b0; font-size:12px; margin:2px 0 0;">We're preparing your transfer.</p></div>
      </div>
      <div class="dep-step" id="dep-step-2" style="display:flex; align-items:flex-start; gap:12px; padding:10px 0;">
        <span class="dep-icon" style="width:26px; height:26px; flex-shrink:0; border-radius:50%; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; font-size:12px; color:#8892b0;">2</span>
        <div><p style="color:white; font-size:14px; font-weight:600; margin:0;">Approve in your wallet</p>
        <p style="color:#8892b0; font-size:12px; margin:2px 0 0;">A window from your wallet will pop up — review it and press Sign.</p></div>
      </div>
      <div class="dep-step" id="dep-step-3" style="display:flex; align-items:flex-start; gap:12px; padding:10px 0;">
        <span class="dep-icon" style="width:26px; height:26px; flex-shrink:0; border-radius:50%; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; font-size:12px; color:#8892b0;">3</span>
        <div><p style="color:white; font-size:14px; font-weight:600; margin:0;">Sending to Cardano</p>
        <p style="color:#8892b0; font-size:12px; margin:2px 0 0;">Your signed transfer is being sent to the blockchain.</p></div>
      </div>
      <div class="dep-step" id="dep-step-4" style="display:flex; align-items:flex-start; gap:12px; padding:10px 0;">
        <span class="dep-icon" style="width:26px; height:26px; flex-shrink:0; border-radius:50%; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; font-size:12px; color:#8892b0;">4</span>
        <div><p style="color:white; font-size:14px; font-weight:600; margin:0;">Waiting for the Cardano blockchain</p>
        <p style="color:#8892b0; font-size:12px; margin:2px 0 0;">Cardano adds new blocks about every 20 seconds. Once your transfer is inside a block, your game balance updates automatically. Usually under 2 minutes.</p></div>
      </div>
    </div>

    <div id="deposit-modal-error" style="display:none; margin-top:14px; background:rgba(245,101,101,0.12); border:1px solid rgba(245,101,101,0.3); border-radius:10px; padding:12px 14px; color:#fc8181; font-size:13px; line-height:1.5;"></div>

    <button id="deposit-modal-close" onclick="closeDepositModal()" style="display:none; width:100%; margin-top:18px; padding:11px; background:rgba(255,255,255,0.08); color:#a0aec0; border:1px solid rgba(255,255,255,0.15); border-radius:10px; font-size:14px; font-weight:600; cursor:pointer;">Close</button>
  </div>
</div>

<script>
  function showWalletTab(tab) {
    var panels = ['wallets', 'swap', 'history'];
    panels.forEach(function(p) {
      var panel = document.getElementById('panel-' + p);
      var tabBtn = document.getElementById('tab-' + p);
      if (panel) panel.style.display = (p === tab) ? 'block' : 'none';
      if (tabBtn) {
        if (p === tab) {
           tabBtn.style.background = '#f7760d';
           tabBtn.style.color = '#111521';
        } else {
          tabBtn.style.background = 'transparent';
          tabBtn.style.color = '#8892b0';
        }
      }
    });
  }

  var swapQuote = null;
  function swapStatus(text) { var e=document.getElementById('swap-status'); e.style.display='block'; e.textContent=text; }
  async function updateSwapOutput() {
    var asset=document.getElementById('swap-asset'), amount=document.getElementById('swap-input-amount').value;
    document.getElementById('swap-input-ticker').textContent=asset.options[asset.selectedIndex] ? asset.options[asset.selectedIndex].text : '—';
    if (!amount || !asset.value) return;
    var r=await fetch('<%= swap_quote_path %>',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken()},body:JSON.stringify({swap_asset_id:asset.value,amount:amount})}), q=await r.json();
    if(!q.ok){ swapQuote=null; swapStatus(q.error); return; }
    swapQuote=q; document.getElementById('swap-output-amount').value=q.beep_amount;
    document.getElementById('swap-rate-label').textContent='Rate: 1 '+q.ticker+' = '+q.rate+' BEEP';
    document.getElementById('swap-rate-detail').textContent='1 '+q.ticker+' = '+q.rate+' BEEP';
  }
  async function initiateSwap() {
    if(!swapQuote) return swapStatus('Request a valid live quote first.');
    try {
      swapStatus('Preparing transaction for your wallet…');
      var ext=window.cardano && window.cardano[VERIFIED_WALLET_KEY]; if(!ext) throw new Error('Your verified Cardano wallet is unavailable.');
      var api=await ext.enable(), used=await api.getUsedAddresses(), addressHex=(used&&used[0])||await api.getChangeAddress();
      var b=await (await fetch('<%= build_swap_path %>',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken()},body:JSON.stringify({quote_id:swapQuote.quote_id,address_hex:addressHex})})).json(); if(!b.ok) throw new Error(b.error);
      swapStatus('Approve and submit the transfer in your wallet…'); var signed=await api.signTx(b.unsigned_tx,false), hash=await api.submitTx(signed);
      var payout=document.querySelector('input[name="swap-payout"]:checked').value;
      var s=await (await fetch('<%= record_swap_path %>',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken()},body:JSON.stringify({quote_id:swapQuote.quote_id,tx_hash:hash,payout_method:payout})})).json(); if(!s.ok) throw new Error(s.error);
      swapStatus('Submitted. Awaiting 2 Cardano confirmations. Input: '+s.source_explorer_url); pollSwaps();
    } catch(e) { swapStatus(e.message || 'Swap submission failed. Do not resubmit if your wallet showed a transaction hash.'); }
  }
  async function pollSwaps(){ setInterval(async function(){var r=await fetch('<%= check_swaps_path %>',{method:'POST',headers:{'X-CSRF-Token':csrfToken()}}),d=await r.json();if(d.swaps&&d.swaps.length){var s=d.swaps[0];swapStatus('Swap '+s.status+(s.payout_explorer_url?' — payout: '+s.payout_explorer_url:'')+(s.error?' — '+s.error:''));}},15000); }
  document.addEventListener('DOMContentLoaded',async function(){var r=await fetch('<%= swap_assets_path %>'),d=await r.json(),el=document.getElementById('swap-asset');if(d.ok){el.innerHTML=d.assets.map(function(a){return '<option value="'+a.id+'">'+a.ticker+'</option>';}).join('');updateSwapOutput();}});

  // Key of the wallet extension the user verified with (e.g. "vespr", "eternl").
  // Always use this exact extension for deposits — never grab wallets[0] blindly,
  // which could activate a different wallet (e.g. the treasury wallet extension).
  var VERIFIED_WALLET_KEY = <%= @user.cardano_wallet_name.to_s.downcase.to_json.html_safe %>;

  // ----- Deposit progress modal helpers -----
  function openDepositModal() {
    var m = document.getElementById('deposit-modal');
    if (!m) return;
    // reset steps
    for (var i = 1; i <= 4; i++) setDepositStep(i, 'pending');
    var err = document.getElementById('deposit-modal-error');
    if (err) { err.style.display = 'none'; err.innerHTML = ''; }
    var close = document.getElementById('deposit-modal-close');
    if (close) close.style.display = 'none';
    var sub = document.getElementById('deposit-modal-subtitle');
    if (sub) sub.innerHTML = 'This is a real blockchain transfer — it takes about a minute.';
    m.style.display = 'flex';
  }

  function closeDepositModal() {
    var m = document.getElementById('deposit-modal');
    if (m) m.style.display = 'none';
  }

  // state: 'pending' | 'active' | 'done'
  function setDepositStep(n, state) {
    var step = document.getElementById('dep-step-' + n);
    if (!step) return;
    var icon = step.querySelector('.dep-icon');
    if (state === 'active') {
      icon.style.background = 'rgba(0,180,216,0.2)';
      icon.style.color = '#00b4d8';
      icon.innerHTML = '<i class="fa fa-circle-notch fa-spin"></i>';
      step.style.opacity = '1';
    } else if (state === 'done') {
      icon.style.background = 'rgba(0,200,83,0.2)';
      icon.style.color = '#00c853';
      icon.innerHTML = '<i class="fa fa-check"></i>';
      step.style.opacity = '0.75';
    } else {
      icon.style.background = 'rgba(255,255,255,0.08)';
      icon.style.color = '#8892b0';
      icon.textContent = String(n);
      step.style.opacity = '0.55';
    }
  }

  function depositModalError(msg) {
    var err = document.getElementById('deposit-modal-error');
    if (err) {
      err.style.display = 'block';
      err.innerHTML = '<i class="fa fa-triangle-exclamation" style="margin-right:6px;"></i>' + msg;
    }
    var close = document.getElementById('deposit-modal-close');
    if (close) close.style.display = 'block';
  }

  // ----- On-chain approved-token deposit flow (CIP-30 sign + submit) -----
  function depositStatus(html, color) {
    var el = document.getElementById('onchain-deposit-status');
    if (!el) {
      // fallback: surface critical errors even if the status div is missing
      console.error('[deposit]', html);
      return;
    }
    el.style.display = 'block';
    el.innerHTML = '<div style="padding: 10px 14px; border-radius: 8px; background: rgba(0,0,0,0.25); color: ' + (color || '#a0aec0') + '; font-size: 13px;">' + html + '</div>';
  }

  async function startOnchainDeposit() {
    var amount = document.getElementById('onchain-deposit-amount').value.trim();
    if (!/^\d+(\.\d+)?$/.test(amount) || /^0(?:\.0*)?$/.test(amount)) {
      depositStatus('<i class="fa fa-exclamation-circle" style="margin-right:6px;"></i>Enter a positive decimal token amount to load.', '#fc8181');
      return;
    }
    var btn = document.getElementById('onchain-deposit-btn');
    btn.disabled = true;
    openDepositModal();
    setDepositStep(1, 'active');
    try {
      if (!window.cardano) {
        throw new Error('No Cardano wallet extension detected. Install Vespr or Eternl and reload.');
      }

      // Look up the verified wallet directly by key — faster and more reliable
      // than iterating detectCardanoWallets (which filters on apiVersion some
      // wallets don't expose).
      var walletExt = window.cardano[VERIFIED_WALLET_KEY];

      // Fallback: search all registered CIP-30 extensions for a name/key match
      if (!walletExt || typeof walletExt.enable !== 'function') {
        var allKeys = Object.keys(window.cardano);
        var matchKey = allKeys.find(function(k) {
          var w = window.cardano[k];
          if (!w || typeof w.enable !== 'function') return false;
          return k.toLowerCase() === VERIFIED_WALLET_KEY ||
                 (w.name || '').toLowerCase() === VERIFIED_WALLET_KEY ||
                 k.toLowerCase().includes(VERIFIED_WALLET_KEY) ||
                 VERIFIED_WALLET_KEY.includes(k.toLowerCase());
        });
        if (!matchKey) {
          throw new Error('Wallet "' + VERIFIED_WALLET_KEY + '" not found in this browser. Open Vespr and make sure it is unlocked, then try again.');
        }
        walletExt = window.cardano[matchKey];
      }

      var walletLabel = walletExt.name || VERIFIED_WALLET_KEY;
      var api = await walletExt.enable();
      var used = await api.getUsedAddresses();
      var addressHex = (used && used.length > 0) ? used[0] : await api.getChangeAddress();

      var buildResp = await fetch('<%= build_deposit_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
        body: JSON.stringify({ amount: amount, approved_token_id: document.getElementById('onchain-token-id').value, address_hex: addressHex })
      });
      var build = await buildResp.json();
      if (!buildResp.ok || !build.ok) throw new Error(build.error || 'Could not build the transaction.');

      setDepositStep(1, 'done');
      setDepositStep(2, 'active');
      var signedTx = await api.signTx(build.unsigned_tx, false);

      setDepositStep(2, 'done');
      setDepositStep(3, 'active');
      var txHash = await api.submitTx(signedTx);

      setDepositStep(3, 'done');
      setDepositStep(4, 'active');
      await recordDeposit(txHash, amount, document.getElementById('onchain-token-id').value);
    } catch (e) {
      var raw = (e && (e.info || e.message)) ? String(e.info || e.message) : 'Deposit was cancelled or failed.';
      // Translate cryptic Mesh/Blockfrost errors into plain English
      var msg = raw;
      if (/utxo.*deplet|deplet.*utxo/i.test(raw)) {
        msg = 'Not enough ADA to build the transaction. You need at least 3 ADA in your wallet to cover fees and the minimum ADA required alongside the tokens. Top up your ADA balance and try again.';
      } else if (/user declined|user cancel|declined to sign/i.test(raw)) {
        msg = 'Transaction cancelled — you declined the signing request in your wallet.';
      } else if (/no utxo|no utxos|address.*no.*utxo/i.test(raw)) {
        msg = 'No funds found at your wallet address. Make sure your Vespr wallet is on the correct account.';
      }
      depositModalError(msg);
      depositStatus('<i class="fa fa-triangle-exclamation" style="margin-right:6px;"></i>' + msg, '#fc8181');
    } finally {
      btn.disabled = false;
    }
  }

  async function recordDeposit(txHash, amount, tokenId) {
    var resp = await fetch('<%= record_deposit_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
      body: JSON.stringify({ tx_hash: txHash, amount: amount, approved_token_id: tokenId })
    });
    var data = await resp.json();
    if (!resp.ok || !data.ok) {
      throw new Error(data.error || 'The transfer reached Cardano, but the server could not record it. Keep this transaction hash and contact support: ' + txHash);
    }
    var explorerUrl = data.explorer_url || ('https://cardanoscan.io/transaction/' + txHash);
    depositStatus('<i class="fa fa-check" style="margin-right:6px;"></i>Deposit submitted! Waiting for blockchain confirmation — your balance will update automatically. <a href="' + explorerUrl + '" target="_blank" rel="noopener" style="color:#63b3ed;">View transaction ' + txHash.slice(0, 16) + '…</a>', '#68d391');
    var sub = document.getElementById('deposit-modal-subtitle');
    if (sub) sub.innerHTML = 'Your transfer is on its way. You can close this window — your balance will update on its own.';
    var close = document.getElementById('deposit-modal-close');
    if (close) close.style.display = 'block';
    pollDepositStatus();
  }

  var depositPollTimer = null;
  function pollDepositStatus() {
    if (depositPollTimer) return;
    var attempts = 0;
    depositPollTimer = setInterval(async function() {
      attempts++;
      if (attempts > 40) { clearInterval(depositPollTimer); depositPollTimer = null; return; }
      try {
        var resp = await fetch('<%= check_deposits_path %>', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' }
        });
        var data = await resp.json();
        if (data.ok && data.results && data.results.some(function(r) { return r.status === 'credited'; })) {
          clearInterval(depositPollTimer);
          depositPollTimer = null;
          window.location.reload();
        }
        if (data.ok && data.results && data.results.length === 0) {
          clearInterval(depositPollTimer);
          depositPollTimer = null;
        }
      } catch (e) { /* keep polling */ }
    }, 15000);
  }
</script>
