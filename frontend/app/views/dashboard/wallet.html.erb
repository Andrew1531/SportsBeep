<style>
  .wallet-page-shell { min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px; }
  .wallet-page-shell .wallet-hero { margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .wallet-page-shell .wallet-hero-copy { min-width: 0; }
  .wallet-page-shell .wallet-hero-title { color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 28px; font-family: 'BebasNeue', sans-serif; letter-spacing: 1px; }
  .wallet-page-shell .wallet-hero-subtitle { color: #8892b0; margin: 0; font-size: 14px; }
  .wallet-page-shell .wallet-back-btn { display: inline-block; padding: 10px 22px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 5px; }
  .wallet-page-shell .wallet-stats-row { margin-bottom: 24px; }
  .wallet-page-shell .wallet-stat-card { background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 18px 14px; text-align: center; min-height: 146px; position: relative; }
  .wallet-page-shell .wallet-stat-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
  .wallet-page-shell .wallet-stat-kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px; color: #8892b0; }
  .wallet-page-shell .wallet-stat-sub { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px; color: #555e73; }
  .wallet-page-shell .wallet-stat-value { font-weight: 700; margin: 0 0 2px; font-size: 22px; }
  .wallet-page-shell .wallet-stat-unit { font-size: 10px; margin: 0; color: #555e73; }
  .wallet-page-shell .wallet-stack-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 18px 22px; }
  @media (max-width: 767px) {
    .wallet-page-shell { padding: 20px 12px 44px; }
    .wallet-page-shell .wallet-hero { margin-bottom: 20px; }
    .wallet-page-shell .wallet-hero-title { font-size: 24px; }
    .wallet-page-shell .wallet-hero-subtitle { font-size: 13px; line-height: 1.5; }
    .wallet-page-shell .wallet-back-btn { width: 100%; text-align: center; margin-top: 0; }
    .wallet-page-shell .wallet-stats-row .col-xs-6 { width: 100%; }
    .wallet-page-shell .wallet-stat-card { padding: 16px 14px; min-height: 132px; border-radius: 14px; }
    .wallet-page-shell .wallet-stat-value { font-size: 20px; }
    .wallet-page-shell .wallet-stack-card { padding: 16px; border-radius: 14px; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head { align-items: flex-start !important; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head > div:first-child { margin-right: 0 !important; }
    .wallet-page-shell .wallet-stack-card .wallet-stack-head { gap: 12px; }
  }
</style>

<div class="wallet-page-shell">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="wallet-hero">
      <div class="wallet-hero-copy">
        <h2 class="wallet-hero-title">
          <i class="fa fa-wallet" style="color: #a29bfe; margin-right: 10px;"></i>MY WALLET
        </h2>
        <p class="wallet-hero-subtitle">Balances, wallets, swaps & transactions — all in one place</p>
      </div>
      <%= link_to user_dashboard_path, class: 'wallet-back-btn' do %>
        <i class="fa fa-arrow-left" style="margin-right: 6px;"></i> Dashboard
      <% end %>
    </div>

    <div class="row wallet-stats-row">
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div class="wallet-stat-card">
          <div class="wallet-stat-icon" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
            <i class="fa fa-coins" style="color: white; font-size: 18px;"></i>
          </div>
          <p class="wallet-stat-kicker">$BEEP</p>
          <p class="wallet-stat-sub">Connected Wallet</p>
          <h3 class="wallet-stat-value" style="color: white;"><%= @on_chain_beep.to_i rescue 0 %></h3>
          <p class="wallet-stat-unit">$BEEP on-chain</p>
        </div>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div class="wallet-stat-card">
          <div class="wallet-stat-icon" style="background: linear-gradient(135deg, #6c5ce7, #a29bfe);">
            <i class="fa fa-users" style="color: white; font-size: 18px;"></i>
          </div>
          <p class="wallet-stat-kicker">Referrals</p>
          <p class="wallet-stat-sub">Signups</p>
          <h3 class="wallet-stat-value" style="color: white; margin: 0;"><%= @referral_count rescue 0 %></h3>
        </div>
      </div>
      <% in_play_beep = (@active_wager_total.to_f rescue 0) %>
      <% in_play_over = in_play_beep > 0 && in_play_beep > @on_chain_beep.to_i %>
      <% ip_bg    = in_play_over ? 'rgba(255,193,7,0.1)'  : 'rgba(255,255,255,0.06)' %>
      <% ip_bdr   = in_play_over ? 'rgba(255,193,7,0.45)' : 'rgba(255,255,255,0.1)' %>
      <% ip_icon  = in_play_over ? 'linear-gradient(135deg,#f39c12,#e67e22)' : 'linear-gradient(135deg,#00b894,#00cec9)' %>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div class="wallet-stat-card" style="background: <%= ip_bg %>; border-color: <%= ip_bdr %>; position: relative;">
          <% if in_play_over %>
            <span style="position: absolute; top: 10px; right: 10px; background: rgba(255,193,7,0.2); border: 1px solid rgba(255,193,7,0.5); border-radius: 20px; padding: 2px 8px; font-size: 10px; font-weight: 700; color: #ffc107; letter-spacing: 0.5px;">!</span>
          <% end %>
          <div class="wallet-stat-icon" style="background: <%= ip_icon %>;">
            <i class="fa fa-sack-dollar" style="color: white; font-size: 18px;"></i>
          </div>
          <p class="wallet-stat-kicker">Total</p>
          <p class="wallet-stat-sub">In Play</p>
          <h3 class="wallet-stat-value" style="color: <%= in_play_over ? '#ffc107' : 'white' %>;"><%= in_play_beep.to_i %></h3>
          <p class="wallet-stat-unit">$BEEP</p>
          <% if in_play_over %>
            <p style="color: #f39c12; font-size: 10px; margin: 6px 0 0; line-height: 1.4;">Above your wallet $BEEP<br>— acquire more to unlock credit</p>
          <% end %>
        </div>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div class="wallet-stat-card">
          <div class="wallet-stat-icon" style="background: linear-gradient(135deg, #00b4d8, #0077b6);">
            <i class="fa fa-clock-rotate-left" style="color: white; font-size: 18px;"></i>
          </div>
          <p class="wallet-stat-kicker">Wagers</p>
          <p class="wallet-stat-sub">All-Time</p>
          <h3 class="wallet-stat-value" style="color: white; margin: 0;"><%= @total_wager_count rescue 0 %></h3>
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 6px; margin-bottom: 24px; background: rgba(255,255,255,0.04); border-radius: 12px; padding: 4px;">
      <button onclick="showWalletTab('wallets')" id="tab-wallets" style="flex: 1; padding: 11px 0; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-link" style="margin-right: 5px;"></i> WALLETS
      </button>
      <button onclick="showWalletTab('swap')" id="tab-swap" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-right-left" style="margin-right: 5px;"></i> SWAP
      </button>
      <button onclick="showWalletTab('history')" id="tab-history" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-receipt" style="margin-right: 5px;"></i> HISTORY
      </button>
    </div>

    <div id="panel-wallets">
      <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-md-8 col-md-offset-2" style="margin-bottom: 20px;">
          <div class="wallet-stack-card" style="background: linear-gradient(135deg, rgba(0,136,204,0.12), rgba(0,180,216,0.08)); border-color: rgba(0,180,216,0.3);">
            <div class="wallet-stack-head" style="display: flex; align-items: center; margin-bottom: 20px;">
              <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 14px; flex-shrink: 0;">
                <i class="fa fa-wallet" style="color: white; font-size: 22px;"></i>
              </div>
              <div style="flex: 1;">
                <h4 style="color: white; font-weight: 700; margin: 0; font-size: 18px;">Cardano</h4>
                <p style="color: #8892b0; margin: 0; font-size: 13px;">ADA / $BEEP</p>
              </div>
              <% if @user.cardano_wallet_address.present? %>
                <span style="padding: 5px 14px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fa fa-circle" style="font-size: 6px; margin-right: 4px; vertical-align: middle;"></i> Connected</span>
              <% else %>
                <span style="padding: 5px 14px; background: rgba(245,101,101,0.1); color: #fc8181; border: 1px solid rgba(245,101,101,0.2); border-radius: 20px; font-size: 12px; font-weight: 600;">Not Connected</span>
              <% end %>
            </div>

            <% if @user.cardano_wallet_address.present? %>
              <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
                <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Address</p>
                <code style="color: #00b4d8; word-break: break-all; font-size: 13px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
              </div>

              <% wallet_status = @wallet_info ? @wallet_info[:status] : nil %>

              <% if wallet_status == 'not_found' %>
                <%# Address unused on-chain — help user connect the right address %>
                <div style="background: rgba(255,165,0,0.12); border: 1px solid rgba(255,165,0,0.35); border-radius: 10px; padding: 16px 18px; margin-bottom: 14px;">
                  <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <i class="fa fa-triangle-exclamation" style="color: #f6ad55; font-size: 20px; margin-top: 2px; flex-shrink: 0;"></i>
                    <div>
                      <p style="color: #f6ad55; font-weight: 700; font-size: 14px; margin: 0 0 6px;">Address has no on-chain activity</p>
                      <p style="color: #a0aec0; font-size: 13px; margin: 0 0 8px; line-height: 1.5;">
                        Your connected address hasn't been used on Cardano yet, or your tokens are held across multiple wallet addresses. Reconnect with your wallet extension to link the right account.
                      </p>
                    </div>
                  </div>
                </div>

                <div style="margin-bottom: 14px;">
                  <button onclick="openWalletModal()" style="width: 100%; padding: 11px; background: rgba(255,165,0,0.2); color: #f6ad55; border: 1px solid rgba(255,165,0,0.4); border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                    <i class="fa fa-rotate" style="margin-right: 6px;"></i> Reconnect Wallet
                  </button>
                </div>

              <% elsif @wallet_info && wallet_status == 'active' %>
                <div style="display: flex; gap: 10px; margin-bottom: 14px;">
                  <div style="flex: 1; background: rgba(0,0,0,0.2); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">ADA Balance</p>
                    <span style="color: #00b4d8; font-weight: 700; font-size: 20px;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">ADA</span>
                  </div>
                  <div style="flex: 1; background: rgba(231,76,60,0.12); border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Connected Wallet $BEEP</p>
                    <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= @on_chain_beep.to_i %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">on-chain</span>
                  </div>
                </div>

                <% platform_beep = (@account.balance_cents.to_i / 100) rescue 0 %>
                <% available_to_load = (@available_to_load_beep.to_i rescue 0) %>
                <% withdrawable = (@withdrawable_beep.to_i rescue 0) %>

                <div style="background: rgba(0,0,0,0.2); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                    <div>
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Game Balance</p>
                      <span style="color: #00c853; font-weight: 700; font-size: 20px;"><%= platform_beep %> <span style="font-size: 12px; color: #8892b0;">$BEEP</span></span>
                    </div>
                    <div style="text-align: right;">
                      <p style="color: #8892b0; font-size: 11px; margin: 0 0 2px;">Available in Wallet</p>
                      <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= available_to_load %> <span style="font-size: 12px; color: #8892b0;">$BEEP</span></span>
                    </div>
                  </div>

                  <% if on_chain_mode? %>
                    <div style="background: rgba(0,136,204,0.08); border: 1px solid rgba(0,180,216,0.25); border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;">
                      <p style="color: #7fc9e8; font-size: 12px; margin: 0; line-height: 1.5;">
                        <i class="fa fa-link" style="margin-right: 6px; color: #00b4d8;"></i>
                        Loading and withdrawing are <strong>real on-chain transfers</strong>. Loading sends $BEEP from your wallet to the SportsBeep treasury (you sign in your wallet); withdrawing sends $BEEP back to your wallet. Every transfer gets a transaction hash you can verify on a Cardano explorer.
                      </p>
                    </div>

                    <!-- ON-CHAIN DEPOSIT -->
                    <div style="margin-bottom: 12px;">
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Load $BEEP (on-chain deposit)</p>
                      <div style="display: flex; gap: 8px;">
                        <input type="number" id="onchain-deposit-amount" min="1" step="1" placeholder="Amount" inputmode="numeric"
                               style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                        <button onclick="startOnchainDeposit()" id="onchain-deposit-btn"
                                style="white-space: nowrap; padding: 12px 18px; background: linear-gradient(135deg, #00c853, #00a844); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,200,83,0.3);">
                          <i class="fa fa-download" style="margin-right: 6px;"></i> Load
                        </button>
                      </div>
                      <div id="onchain-deposit-status" style="display:none; margin-top: 8px;"></div>
                    </div>

                    <!-- ON-CHAIN WITHDRAW -->
                    <%= form_tag(withdraw_beep_path, method: :post, data: { confirm: 'This sends real $BEEP tokens from the treasury to your wallet on the Cardano blockchain. Continue?' }) do %>
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Withdraw $BEEP (on-chain payout)</p>
                      <% max_onchain_withdraw = (@account.balance_cents.to_i / 100) rescue 0 %>
                      <div style="display: flex; gap: 8px;">
                        <input type="number" name="amount" min="1" step="1" max="<%= max_onchain_withdraw %>"
                               placeholder="Amount" inputmode="numeric"
                               <%= 'disabled' if max_onchain_withdraw <= 0 %>
                               style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                        <button type="submit" <%= 'disabled' if max_onchain_withdraw <= 0 %>
                                style="white-space: nowrap; padding: 12px 18px; background: rgba(231,76,60,0.15); color: #fc8181; border: 1px solid rgba(231,76,60,0.35); border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= max_onchain_withdraw <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= max_onchain_withdraw <= 0 ? '0.5' : '1' %>;">
                          <i class="fa fa-upload" style="margin-right: 6px;"></i> Withdraw
                        </button>
                      </div>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        <% if max_onchain_withdraw <= 0 %>
                          No game balance available to withdraw.
                        <% else %>
                          Up to <%= max_onchain_withdraw %> $BEEP can be sent to your verified wallet on-chain.
                        <% end %>
                      </p>
                    <% end %>

                    <% recent_transfers = @user.beep_chain_transfers.order(created_at: :desc).limit(5) %>
                    <% if recent_transfers.any? %>
                      <div style="margin-top: 14px; background: rgba(0,0,0,0.15); border-radius: 8px; padding: 10px 12px;">
                        <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 8px;">Recent on-chain transfers</p>
                        <% recent_transfers.each do |t| %>
                          <div style="display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 12px;">
                            <span style="color: <%= t.direction == 'deposit' ? '#68d391' : '#fc8181' %>;">
                              <i class="fa fa-<%= t.direction == 'deposit' ? 'download' : 'upload' %>" style="margin-right: 4px;"></i>
                              <%= t.direction.capitalize %> <%= t.amount_beep %> $BEEP
                            </span>
                            <span>
                              <% status_color = { 'pending' => '#f6ad55', 'confirmed' => '#63b3ed', 'credited' => '#68d391', 'failed' => '#fc8181', 'unknown' => '#f6ad55' }[t.status] || '#8892b0' %>
                              <span style="color: <%= status_color %>; margin-right: 8px;"><%= t.status %></span>
                              <% if t.explorer_url %>
                                <a href="<%= t.explorer_url %>" target="_blank" rel="noopener" style="color: #00b4d8; text-decoration: none;"><i class="fa fa-arrow-up-right-from-square"></i></a>
                              <% end %>
                            </span>
                          </div>
                        <% end %>
                        <% if recent_transfers.any? { |t| t.direction == 'deposit' && t.status == 'pending' } %>
                          <script>document.addEventListener('DOMContentLoaded', function() { pollDepositStatus(); });</script>
                        <% end %>
                      </div>
                    <% end %>
                  <% else %>
                  <div style="background: rgba(0,200,83,0.08); border: 1px solid rgba(0,200,83,0.25); border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;">
                    <p style="color: #9fd9b4; font-size: 12px; margin: 0; line-height: 1.5;">
                      <i class="fa fa-shield-halved" style="margin-right: 6px; color: #00c853;"></i>
                      Your real $BEEP always stays in your own wallet. Holding $BEEP simply unlocks play credit to wager with — loading and removing never moves any tokens on-chain.
                    </p>
                  </div>

                  <!-- LOAD to game -->
                  <%= form_tag(load_beep_path, method: :post, style: 'margin-bottom: 12px;') do %>
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Unlock play credit</p>
                    <div style="display: flex; gap: 8px;">
                      <input type="number" name="amount" min="1" step="1" max="<%= available_to_load %>"
                             placeholder="Amount" inputmode="numeric"
                             <%= 'disabled' if available_to_load <= 0 %>
                             style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                      <button type="submit" <%= 'disabled' if available_to_load <= 0 %>
                              style="white-space: nowrap; padding: 12px 18px; background: linear-gradient(135deg, #00c853, #00a844); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= available_to_load <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= available_to_load <= 0 ? '0.5' : '1' %>; box-shadow: 0 4px 15px rgba(0,200,83,0.3);">
                        <i class="fa fa-download" style="margin-right: 6px;"></i> Load
                      </button>
                    </div>
                    <% if available_to_load <= 0 %>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                        <% if @on_chain_beep.to_i == 0 %>
                          No $BEEP detected in your connected wallet.
                        <% else %>
                          All of your on-chain $BEEP is already loaded into the game.
                        <% end %>
                      </p>
                    <% else %>
                      <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                        You hold <%= available_to_load %> $BEEP — choose how much play credit to unlock. Your tokens stay in your wallet.
                      </p>
                    <% end %>
                  <% end %>

                  <!-- REMOVE play credit -->
                  <%= form_tag(withdraw_beep_path, method: :post) do %>
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Remove play credit</p>
                    <div style="display: flex; gap: 8px;">
                      <input type="number" name="amount" min="1" step="1" max="<%= withdrawable %>"
                             placeholder="Amount" inputmode="numeric"
                             <%= 'disabled' if withdrawable <= 0 %>
                             style="flex: 1; min-width: 0; padding: 12px 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: white; font-size: 15px; font-weight: 600;">
                      <button type="submit" <%= 'disabled' if withdrawable <= 0 %>
                              style="white-space: nowrap; padding: 12px 18px; background: rgba(231,76,60,0.15); color: #fc8181; border: 1px solid rgba(231,76,60,0.35); border-radius: 10px; font-size: 14px; font-weight: 700; cursor: <%= withdrawable <= 0 ? 'not-allowed' : 'pointer' %>; opacity: <%= withdrawable <= 0 ? '0.5' : '1' %>;">
                        <i class="fa fa-upload" style="margin-right: 6px;"></i> Remove
                      </button>
                    </div>
                    <p style="color: #8892b0; font-size: 12px; margin: 6px 0 0;">
                      <% if withdrawable <= 0 %>
                        No wallet-backed play credit available to remove.
                      <% else %>
                        Up to <%= withdrawable %> $BEEP of play credit can be removed (nothing is sent on-chain).
                      <% end %>
                    </p>
                  <% end %>
                  <% end %>
                </div>

                <% if (begin; @wallet_info[:stake_address].present?; rescue; false; end) %>
                  <div style="background: rgba(0,0,0,0.1); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
                    <p style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Stake Key</p>
                    <code style="color: #63b3ed; word-break: break-all; font-size: 11px;"><%= @wallet_info[:stake_address] %></code>
                  </div>
                <% end %>

              <% else %>
                <div style="background: rgba(255,200,0,0.1); border: 1px solid rgba(255,200,0,0.2); border-radius: 8px; padding: 12px 16px; margin-bottom: 14px; text-align: center;">
                  <i class="fa fa-spinner fa-spin" style="color: #ffc107; margin-right: 6px;"></i>
                  <span style="color: #ffc107; font-size: 13px;">Reading blockchain data...</span>
                </div>
              <% end %>

            <%= link_to disconnect_cardano_path(redirect_to: wallet_path), method: :delete, data: { confirm: 'Disconnect your Cardano wallet?' }, style: 'display: inline-block; padding: 9px 20px; background: rgba(245,101,101,0.15); color: #fc8181; border: 1px solid rgba(245,101,101,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; width: 100%; text-align: center;' do %>
                <i class="fa fa-unlink" style="margin-right: 5px;"></i> Disconnect
              <% end %>
            <% else %>
              <div style="text-align: center; padding: 10px 0 16px;">
                <p style="color: #8892b0; margin: 0 0 18px; font-size: 14px; line-height: 1.6;">
                  Connect your Cardano wallet extension to link your $BEEP holdings. You'll sign a free one-time message to prove ownership.
                </p>
                <button onclick="openWalletModal()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,136,204,0.35);" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                  <i class="fa fa-wallet" style="margin-right: 8px;"></i> Connect Cardano Wallet
                </button>
                <p style="color: #8892b0; margin: 10px 0 0; font-size: 12px;">
                  <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                  Eternl, Nami, Lace, Flint & other CIP-30 wallets supported
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="wallet-stack-card">
        <h5 style="color: #8892b0; font-weight: 600; margin: 0 0 14px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
          <i class="fa fa-circle-question" style="margin-right: 6px;"></i>Supported Cardano Wallets
        </h5>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;"><i class="fa fa-wallet" style="margin-right: 4px;"></i> Nami</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Eternl</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Flint</span>
        </div>
      </div>
    </div>

    <div id="panel-swap" style="display: none;">
      <div style="background: linear-gradient(135deg, rgba(108,92,231,0.12), rgba(162,155,254,0.08)); border: 1px solid rgba(162,155,254,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 20px;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
            <i class="fa fa-right-left" style="color: white; font-size: 18px;"></i>
          </div>
          <div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Token Swap</h4>
            <p style="color: #8892b0; margin: 0; font-size: 12px;">Exchange crypto for $BEEP tokens</p>
          </div>
        </div>

        <div style="display: flex; gap: 10px; margin-bottom: 20px;">
          <div style="flex: 1; padding: 12px; background: rgba(0,136,204,0.2); color: #00b4d8; border: 2px solid rgba(0,180,216,0.4); border-radius: 10px; font-size: 14px; font-weight: 700; text-align: center;">
            <i class="fa fa-wallet" style="margin-right: 6px;"></i> ADA &rarr; $BEEP
          </div>
        </div>

        <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; margin-bottom: 14px;">
          <div style="margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Send</p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
              <input type="number" id="swap-input-amount" placeholder="0.00" min="0" step="0.01" style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;" oninput="updateSwapOutput()">
              <div id="swap-input-label" style="display: flex; align-items: center; background: rgba(0,136,204,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                <span style="color: #00b4d8; font-weight: 700; font-size: 14px;">ADA</span>
              </div>
            </div>
          </div>

          <div style="text-align: center; margin: 12px 0;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(108,92,231,0.3); border: 1px solid rgba(162,155,254,0.4); border-radius: 50%;">
              <i class="fa fa-arrow-down" style="color: #a29bfe; font-size: 14px;"></i>
            </div>
          </div>

          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Receive</p>
              <p style="color: #8892b0; font-size: 12px; margin: 0;" id="swap-rate-label">Rate: <span style="color: #a29bfe;">1 ADA = 5.48 $BEEP</span></p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
              <input type="text" id="swap-output-amount" placeholder="0.00" readonly style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;">
              <div style="display: flex; align-items: center; background: rgba(231,76,60,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                <span style="color: #e74c3c; font-weight: 700; font-size: 14px;">$BEEP</span>
              </div>
            </div>
          </div>
        </div>

        <div style="background: rgba(0,0,0,0.15); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Exchange Rate</span>
            <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-rate-detail">1 ADA = 5.48 $BEEP</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Network Fee</span>
            <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-fee-detail">~0.17 ADA</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: #8892b0; font-size: 13px;">Estimated Time</span>
            <span style="color: white; font-size: 13px; font-weight: 600;">~1-2 minutes</span>
          </div>
        </div>

        <button onclick="initiateSwap()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(108,92,231,0.35); transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          Swap for $BEEP
        </button>
        <p style="text-align: center; color: #8892b0; margin: 10px 0 0; font-size: 12px;">
          <i class="fa fa-shield-halved" style="margin-right: 4px;"></i>
          Powered by blockchain smart contracts
        </p>
        <div id="swap-status" style="display: none; margin-top: 14px;"></div>
      </div>
    </div>

    <div id="panel-history" style="display: none;">
      <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
        <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #fdcb6e, #e17055); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
              <i class="fa fa-clock-rotate-left" style="color: white; font-size: 16px;"></i>
            </div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;">Transaction History</h4>
          </div>
          <% if @transactions.any? %>
            <%= link_to user_transactions_path, style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
              View All <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
            <% end %>
          <% end %>
        </div>

        <% if @transactions.any? %>
          <% @transactions.each do |txn| %>
            <div style="padding: 14px 22px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center;">
                <% amount_val = txn.amount_cents.to_i rescue 0 %>
                <div style="width: 36px; height: 36px; background: <%= amount_val >= 0 ? 'rgba(0,184,148,0.15)' : 'rgba(231,76,60,0.15)' %>; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                  <i class="fa <%= amount_val >= 0 ? 'fa-arrow-down' : 'fa-arrow-up' %>" style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-size: 14px;"></i>
                </div>
                <div>
                  <p style="color: white; margin: 0; font-size: 14px; font-weight: 600;"><%= txn.description %></p>
                  <p style="color: #8892b0; margin: 0; font-size: 12px;"><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></p>
                </div>
              </div>
              <span style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-weight: 700; font-size: 15px;">
                <%= amount_val >= 0 ? '+' : '' %><%= txn.amount %>
              </span>
            </div>
          <% end %>
        <% else %>
          <div style="padding: 50px 20px; text-align: center;">
            <i class="fa fa-receipt" style="font-size: 40px; color: rgba(255,255,255,0.12); margin-bottom: 14px; display: block;"></i>
            <p style="color: #8892b0; margin: 0 0 4px; font-size: 15px; font-weight: 600;">No transactions yet</p>
            <p style="color: rgba(255,255,255,0.3); margin: 0; font-size: 13px;">Enter a contest or swap tokens to get started!</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<script>
  function showWalletTab(tab) {
    var panels = ['wallets', 'swap', 'history'];
    panels.forEach(function(p) {
      var panel = document.getElementById('panel-' + p);
      var tabBtn = document.getElementById('tab-' + p);
      if (panel) panel.style.display = (p === tab) ? 'block' : 'none';
      if (tabBtn) {
        if (p === tab) {
          tabBtn.style.background = 'linear-gradient(135deg, #6c5ce7, #a29bfe)';
          tabBtn.style.color = 'white';
        } else {
          tabBtn.style.background = 'transparent';
          tabBtn.style.color = '#8892b0';
        }
      }
    });
  }

  var ADA_RATE = 5.48;

  function updateSwapOutput() {
    var input = document.getElementById('swap-input-amount');
    var output = document.getElementById('swap-output-amount');
    var val = parseFloat(input.value) || 0;
    output.value = val > 0 ? (val * ADA_RATE).toFixed(2) : '';
  }

  function initiateSwap() {
    var amount = parseFloat(document.getElementById('swap-input-amount').value);
    var statusDiv = document.getElementById('swap-status');

    if (!amount || amount <= 0) {
      statusDiv.style.display = 'block';
      statusDiv.innerHTML = '<div style="background: rgba(245,101,101,0.15); border: 1px solid rgba(245,101,101,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i>Please enter a valid amount to swap.</p></div>';
      return;
    }

    var beepAmount = (amount * ADA_RATE).toFixed(2);

    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-spinner fa-spin" style="margin-right: 6px;"></i>Processing swap of ' + amount + ' ADA for ' + beepAmount + ' $BEEP...</p></div>';

    setTimeout(function() {
      statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle" style="margin-right: 6px;"></i>Swap request submitted! Your ' + beepAmount + ' $BEEP will be credited to your account shortly. $BEEP is live on Cardano mainnet.</p></div>';
    }, 2000);
  }

  // ----- On-chain $BEEP deposit flow (CIP-30 sign + submit) -----
  function depositStatus(html, color) {
    var el = document.getElementById('onchain-deposit-status');
    if (!el) return;
    el.style.display = 'block';
    el.innerHTML = '<div style="padding: 10px 14px; border-radius: 8px; background: rgba(0,0,0,0.25); color: ' + (color || '#a0aec0') + '; font-size: 13px;">' + html + '</div>';
  }

  async function startOnchainDeposit() {
    var amount = parseInt(document.getElementById('onchain-deposit-amount').value, 10);
    if (!amount || amount <= 0) {
      depositStatus('<i class="fa fa-exclamation-circle" style="margin-right:6px;"></i>Enter a whole number of $BEEP to load.', '#fc8181');
      return;
    }
    var btn = document.getElementById('onchain-deposit-btn');
    btn.disabled = true;
    try {
      var wallets = (typeof detectCardanoWallets === 'function') ? detectCardanoWallets() : [];
      if (!window.cardano || wallets.length === 0) {
        throw new Error('No Cardano wallet extension detected. Install Eternl, Nami, or Lace and reload.');
      }
      depositStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Waiting for wallet approval…', '#00b4d8');
      var api = await window.cardano[wallets[0].key].enable();
      var used = await api.getUsedAddresses();
      var addressHex = (used && used.length > 0) ? used[0] : await api.getChangeAddress();

      depositStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Building the deposit transaction…', '#00b4d8');
      var buildResp = await fetch('<%= build_deposit_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
        body: JSON.stringify({ amount: amount, address_hex: addressHex })
      });
      var build = await buildResp.json();
      if (!buildResp.ok || !build.ok) throw new Error(build.error || 'Could not build the transaction.');

      depositStatus('<i class="fa fa-signature" style="margin-right:6px;"></i>Please review and sign the transaction in your wallet…', '#00b4d8');
      var signedTx = await api.signTx(build.unsigned_tx, false);
      depositStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Submitting to the Cardano network…', '#00b4d8');
      var txHash = await api.submitTx(signedTx);
      await recordDeposit(txHash, amount);
    } catch (e) {
      var msg = (e && (e.info || e.message)) ? (e.info || e.message) : 'Deposit was cancelled or failed.';
      depositStatus('<i class="fa fa-triangle-exclamation" style="margin-right:6px;"></i>' + String(msg), '#fc8181');
    } finally {
      btn.disabled = false;
    }
  }

  async function recordDeposit(txHash, amount) {
    await fetch('<%= record_deposit_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
      body: JSON.stringify({ tx_hash: txHash, amount: amount })
    });
    depositStatus('<i class="fa fa-check" style="margin-right:6px;"></i>Deposit submitted! Waiting for blockchain confirmation — your balance will update automatically. Tx: ' + txHash.slice(0, 16) + '…', '#68d391');
    pollDepositStatus();
  }

  var depositPollTimer = null;
  function pollDepositStatus() {
    if (depositPollTimer) return;
    var attempts = 0;
    depositPollTimer = setInterval(async function() {
      attempts++;
      if (attempts > 40) { clearInterval(depositPollTimer); depositPollTimer = null; return; }
      try {
        var resp = await fetch('<%= check_deposits_path %>', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' }
        });
        var data = await resp.json();
        if (data.ok && data.results && data.results.some(function(r) { return r.status === 'credited'; })) {
          clearInterval(depositPollTimer);
          depositPollTimer = null;
          window.location.reload();
        }
        if (data.ok && data.results && data.results.length === 0) {
          clearInterval(depositPollTimer);
          depositPollTimer = null;
        }
      } catch (e) { /* keep polling */ }
    }, 15000);
  }
</script>
