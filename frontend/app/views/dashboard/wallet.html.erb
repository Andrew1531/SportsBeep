<div class="container" style="padding-top: 20px; padding-bottom: 60px;">

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <h2 style="color: #e74c3c; margin-top: 0;">
        <i class="glyphicon glyphicon-briefcase"></i> My Wallet
      </h2>
      <p class="text-muted">Manage your $BEEP tokens and account balance</p>
    </div>
  </div>

  <div class="row" style="margin-bottom: 30px;">
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 15px;">
      <div class="panel panel-primary text-center" style="border-color: #e74c3c;">
        <div class="panel-heading" style="background-color: #e74c3c; border-color: #e74c3c;">
          <h4 class="panel-title" style="color: white;">Available Balance</h4>
        </div>
        <div class="panel-body">
          <h1 style="margin: 10px 0; color: #e74c3c;"><%= @account.balance rescue '$0.00' %></h1>
          <p class="text-muted">$BEEP Tokens</p>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 15px;">
      <div class="panel panel-info text-center">
        <div class="panel-heading">
          <h4 class="panel-title">Promo Balance</h4>
        </div>
        <div class="panel-body">
          <h1 style="margin: 10px 0;"><%= @account.promo_balance rescue '$0.00' %></h1>
          <p class="text-muted">Promotional Credits</p>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-4" style="margin-bottom: 15px;">
      <div class="panel panel-default text-center">
        <div class="panel-heading">
          <h4 class="panel-title">Total Value</h4>
        </div>
        <div class="panel-body">
          <h1 style="margin: 10px 0;"><%= (@account.balance + @account.promo_balance) rescue '$0.00' %></h1>
          <p class="text-muted">Combined Balance</p>
        </div>
      </div>
    </div>
  </div>

  <% if @user.cardano_wallet_address.present? %>
    <div class="row" style="margin-bottom: 25px;">
      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-heading" style="background-color: #34495e; color: white;">
            <h4 class="panel-title"><i class="glyphicon glyphicon-link"></i> Cardano Blockchain Wallet</h4>
          </div>
          <div class="panel-body">
            <div class="row">
              <div class="col-xs-12 col-sm-8">
                <p><strong>Connected Wallet Address:</strong></p>
                <div class="well" style="word-break: break-all; font-family: monospace; font-size: 12px; background-color: #f8f9fa;">
                  <%= @user.cardano_wallet_address %>
                </div>
              </div>
              <div class="col-xs-12 col-sm-4 text-center" style="padding-top: 20px;">
                <span class="label label-success" style="font-size: 14px; padding: 8px 15px;">
                  <i class="glyphicon glyphicon-ok"></i> Wallet Connected
                </span>
                <p class="text-muted" style="margin-top: 10px;"><small>$BEEP rewards sent to this address</small></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row" style="margin-bottom: 25px;">
      <div class="col-xs-12">
        <div class="alert alert-warning">
          <h4><i class="glyphicon glyphicon-exclamation-sign"></i> No Cardano Wallet Connected</h4>
          <p>Link your Cardano wallet address to receive $BEEP token rewards directly on the blockchain. You can add your wallet address in your account settings.</p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row" style="margin-bottom: 25px;">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h4 class="panel-title">
            <i class="glyphicon glyphicon-transfer"></i> Transaction History
            <span class="badge"><%= @transactions.size %></span>
          </h4>
        </div>
        <div class="panel-body">
          <% if @transactions.any? %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th class="text-right">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <% @transactions.each do |txn| %>
                    <tr>
                      <td><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
                      <td><%= txn.description %></td>
                      <td>
                        <span class="label label-default"><%= txn.type.to_s.demodulize.titleize rescue 'Transaction' %></span>
                      </td>
                      <td class="text-right">
                        <% amount_val = txn.amount_cents.to_i rescue 0 %>
                        <span style="color: <%= amount_val >= 0 ? '#27ae60' : '#e74c3c' %>; font-weight: bold;">
                          <%= amount_val >= 0 ? '+' : '' %><%= txn.amount %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="text-center">
              <%= link_to 'View All Transactions', user_transactions_path, class: 'btn btn-default' %>
            </div>
          <% else %>
            <div class="text-center" style="padding: 30px;">
              <i class="glyphicon glyphicon-inbox" style="font-size: 48px; color: #ccc;"></i>
              <p class="text-muted" style="margin-top: 15px;">No transactions yet. Enter a contest to get started!</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12 text-center">
      <%= link_to 'Back to Dashboard', user_dashboard_path, class: 'btn btn-default' %>
    </div>
  </div>

</div>
