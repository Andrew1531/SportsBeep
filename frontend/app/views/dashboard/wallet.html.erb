<div style="min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px;">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div style="margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
      <div>
        <h2 style="color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 26px;">
          <i class="fa fa-wallet" style="color: #a29bfe; margin-right: 8px;"></i>My Wallet
        </h2>
        <p style="color: #8892b0; margin: 0; font-size: 15px;">Manage your $BEEP tokens, ADA balance & swaps</p>
      </div>
      <%= link_to user_dashboard_path, style: 'display: inline-block; padding: 11px 28px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none; margin-top: 5px;' do %>
        <i class="fa fa-arrow-left" style="margin-right: 6px;"></i> Back to Dashboard
      <% end %>
    </div>

    <div class="row" style="margin-bottom: 20px;">
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center; transition: transform 0.2s;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #e74c3c, #c0392b); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-coins" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">$BEEP Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= @account.balance rescue '0.00' %></h3>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-gift" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Promo Balance</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= @account.promo_balance rescue '0.00' %></h3>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #00b894, #00cec9); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-sack-dollar" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Total Value</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= (@account.balance + @account.promo_balance) rescue '$0.00' %></h3>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 20px; text-align: center;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #00b4d8, #0077b6); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
            <i class="fa fa-clock-rotate-left" style="color: white; font-size: 20px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Transactions</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 24px;"><%= @transactions.size %></h3>
        </div>
      </div>
    </div>

    <% if @user.cardano_wallet_address.present? %>
      <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 24px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 18px;">
          <div style="display: flex; align-items: center;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
              <i class="fa fa-wallet" style="color: white; font-size: 18px;"></i>
            </div>
            <div>
              <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Cardano Wallet</h4>
              <p style="color: #8892b0; margin: 0; font-size: 12px;">Connected to Mainnet</p>
            </div>
          </div>
          <% if @wallet_info %>
            <div style="text-align: right; margin-top: 5px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">ADA Balance</p>
              <h3 style="color: #00b4d8; font-weight: 700; margin: 0; font-size: 26px;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %> <span style="font-size: 14px; color: #8892b0;">ADA</span></h3>
            </div>
          <% end %>
        </div>

        <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Wallet Address</p>
          <code style="color: #00b4d8; word-break: break-all; font-size: 12px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
        </div>

        <% if @wallet_info && @wallet_info[:stake_address].present? %>
          <div style="background: rgba(0,0,0,0.15); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Stake Address</p>
            <code style="color: #63b3ed; word-break: break-all; font-size: 11px;"><%= @wallet_info[:stake_address] %></code>
          </div>
        <% end %>

        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
          <p style="color: #8892b0; margin: 0; font-size: 13px;">
            <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
            $BEEP token rewards will be sent to this wallet
          </p>
          <% if @wallet_info && @wallet_info[:status] == 'empty' %>
            <span style="display: inline-block; padding: 4px 12px; background: rgba(253,203,110,0.15); color: #fdcb6e; border: 1px solid rgba(253,203,110,0.3); border-radius: 20px; font-size: 11px; font-weight: 600; margin-top: 5px;">No transactions yet</span>
          <% elsif @wallet_info && @wallet_info[:status] == 'active' %>
            <span style="display: inline-block; padding: 4px 12px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 11px; font-weight: 600; margin-top: 5px;">Active</span>
          <% end %>
        </div>
      </div>
    <% else %>
      <div style="background: rgba(0,136,204,0.1); border: 1px solid rgba(0,136,204,0.25); border-radius: 14px; padding: 18px 24px; margin-bottom: 20px;">
        <p style="color: #63b3ed; margin: 0; font-size: 14px;">
          <i class="fa fa-wallet" style="margin-right: 6px;"></i>
          <strong>Connect your Cardano wallet!</strong> Link your wallet address in your account settings to receive $BEEP token rewards.
        </p>
      </div>
    <% end %>

    <div style="background: linear-gradient(135deg, rgba(108,92,231,0.12), rgba(162,155,254,0.08)); border: 1px solid rgba(162,155,254,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
      <div style="display: flex; align-items: center; margin-bottom: 20px;">
        <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
          <i class="fa fa-right-left" style="color: white; font-size: 18px;"></i>
        </div>
        <div>
          <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Swap ADA for $BEEP</h4>
          <p style="color: #8892b0; margin: 0; font-size: 12px;">Exchange your ADA tokens for $BEEP</p>
        </div>
      </div>

      <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; margin-bottom: 14px;">
        <div style="margin-bottom: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Send</p>
            <% if @wallet_info %>
              <p style="color: #8892b0; font-size: 12px; margin: 0;">Balance: <span style="color: #00b4d8;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %> ADA</span></p>
            <% end %>
          </div>
          <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
            <input type="number" id="ada-amount" placeholder="0.00" min="0" step="0.01" style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;" oninput="updateBeepAmount()">
            <div style="display: flex; align-items: center; background: rgba(0,136,204,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
              <span style="color: #00b4d8; font-weight: 700; font-size: 14px;">ADA</span>
            </div>
          </div>
        </div>

        <div style="text-align: center; margin: 12px 0;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(108,92,231,0.3); border: 1px solid rgba(162,155,254,0.4); border-radius: 50%;">
            <i class="fa fa-arrow-down" style="color: #a29bfe; font-size: 14px;"></i>
          </div>
        </div>

        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Receive</p>
            <p style="color: #8892b0; font-size: 12px; margin: 0;">Rate: <span style="color: #a29bfe;">1 ADA = 100 $BEEP</span></p>
          </div>
          <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
            <input type="text" id="beep-amount" placeholder="0.00" readonly style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;">
            <div style="display: flex; align-items: center; background: rgba(231,76,60,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
              <span style="color: #e74c3c; font-weight: 700; font-size: 14px;">$BEEP</span>
            </div>
          </div>
        </div>
      </div>

      <div style="background: rgba(0,0,0,0.15); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: #8892b0; font-size: 13px;">Exchange Rate</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">1 ADA = 100 $BEEP</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: #8892b0; font-size: 13px;">Network Fee</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">~0.17 ADA</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: #8892b0; font-size: 13px;">Estimated Time</span>
          <span style="color: white; font-size: 13px; font-weight: 600;">~1-2 minutes</span>
        </div>
      </div>

      <% if @user.cardano_wallet_address.present? %>
        <button onclick="initiateSwap()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(108,92,231,0.35); transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          Swap ADA for $BEEP
        </button>
        <p style="text-align: center; color: #8892b0; margin: 10px 0 0; font-size: 12px;">
          <i class="fa fa-shield-halved" style="margin-right: 4px;"></i>
          Powered by Cardano smart contracts
        </p>
      <% else %>
        <div style="text-align: center; padding: 10px;">
          <p style="color: #fdcb6e; font-size: 14px; margin: 0 0 10px;">
            <i class="fa fa-exclamation-triangle" style="margin-right: 6px;"></i>
            Connect your Cardano wallet to swap tokens
          </p>
          <%= link_to 'Connect Wallet', '#', style: 'display: inline-block; padding: 10px 24px; background: rgba(108,92,231,0.3); color: #a29bfe; border: 1px solid rgba(108,92,231,0.3); border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none;' %>
        </div>
      <% end %>

      <div id="swap-status" style="display: none; margin-top: 14px;"></div>
    </div>

    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center;">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #fdcb6e, #e17055); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
            <i class="fa fa-clock-rotate-left" style="color: white; font-size: 16px;"></i>
          </div>
          <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;">Recent Transactions</h4>
        </div>
        <% if @transactions.any? %>
          <%= link_to user_transactions_path, style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
            View All <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
          <% end %>
        <% end %>
      </div>

      <% if @transactions.any? %>
        <% @transactions.each do |txn| %>
          <div style="padding: 14px 22px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center;">
              <% amount_val = txn.amount_cents.to_i rescue 0 %>
              <div style="width: 36px; height: 36px; background: <%= amount_val >= 0 ? 'rgba(0,184,148,0.15)' : 'rgba(231,76,60,0.15)' %>; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                <i class="fa <%= amount_val >= 0 ? 'fa-arrow-down' : 'fa-arrow-up' %>" style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-size: 14px;"></i>
              </div>
              <div>
                <p style="color: white; margin: 0; font-size: 14px; font-weight: 600;"><%= txn.description %></p>
                <p style="color: #8892b0; margin: 0; font-size: 12px;"><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></p>
              </div>
            </div>
            <span style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-weight: 700; font-size: 15px;">
              <%= amount_val >= 0 ? '+' : '' %><%= txn.amount %>
            </span>
          </div>
        <% end %>
      <% else %>
        <div style="padding: 40px 20px; text-align: center;">
          <i class="fa fa-receipt" style="font-size: 36px; color: rgba(255,255,255,0.15); margin-bottom: 12px;"></i>
          <p style="color: #8892b0; margin: 0 0 4px; font-size: 15px; font-weight: 600;">No transactions yet</p>
          <p style="color: rgba(255,255,255,0.3); margin: 0; font-size: 13px;">Enter a contest to get started!</p>
        </div>
      <% end %>
    </div>

  </div>
</div>

<script>
  function updateBeepAmount() {
    var adaInput = document.getElementById('ada-amount');
    var beepOutput = document.getElementById('beep-amount');
    var adaValue = parseFloat(adaInput.value) || 0;
    var beepValue = adaValue * 100;
    beepOutput.value = beepValue > 0 ? beepValue.toFixed(2) : '';
  }

  function initiateSwap() {
    var adaAmount = parseFloat(document.getElementById('ada-amount').value);
    var statusDiv = document.getElementById('swap-status');

    if (!adaAmount || adaAmount <= 0) {
      statusDiv.style.display = 'block';
      statusDiv.innerHTML = '<div style="background: rgba(245,101,101,0.15); border: 1px solid rgba(245,101,101,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i>Please enter a valid ADA amount to swap.</p></div>';
      return;
    }

    var beepAmount = (adaAmount * 100).toFixed(2);

    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-spinner fa-spin" style="margin-right: 6px;"></i>Processing swap of ' + adaAmount + ' ADA for ' + beepAmount + ' $BEEP...</p></div>';

    setTimeout(function() {
      statusDiv.innerHTML = '<div style="background: rgba(253,203,110,0.15); border: 1px solid rgba(253,203,110,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #fdcb6e; margin: 0; font-size: 14px;"><i class="fa fa-clock" style="margin-right: 6px;"></i>$BEEP token smart contract is being deployed. Swap functionality will be available once the token is live on Cardano mainnet.</p></div>';
    }, 2000);
  }
</script>
