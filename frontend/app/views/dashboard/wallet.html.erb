<div style="min-height: calc(100vh - 200px); background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 30px 15px 60px;">
  <div class="container">

    <% if flash[:notice] %>
      <div style="background: rgba(72, 187, 120, 0.15); border: 1px solid rgba(72, 187, 120, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background: rgba(245, 101, 101, 0.15); border: 1px solid rgba(245, 101, 101, 0.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <div style="margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
      <div>
        <h2 style="color: white; font-weight: 700; margin: 0 0 4px 0; font-size: 28px; font-family: 'BebasNeue', sans-serif; letter-spacing: 1px;">
          <i class="fa fa-wallet" style="color: #a29bfe; margin-right: 10px;"></i>MY WALLET
        </h2>
        <p style="color: #8892b0; margin: 0; font-size: 14px;">Balances, wallets, swaps & transactions — all in one place</p>
      </div>
      <%= link_to user_dashboard_path, style: 'display: inline-block; padding: 10px 22px; background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 5px;' do %>
        <i class="fa fa-arrow-left" style="margin-right: 6px;"></i> Dashboard
      <% end %>
    </div>

    <div class="row" style="margin-bottom: 24px;">
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 20px 16px; text-align: center;">
          <div style="width: 42px; height: 42px; background: linear-gradient(135deg, #e74c3c, #c0392b); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
            <i class="fa fa-coins" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">$BEEP</p>
          <p style="color: #555e73; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px;">On-Chain</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 22px;"><%= @on_chain_beep.to_i rescue 0 %></h3>
        </div>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 20px 16px; text-align: center;">
          <div style="width: 42px; height: 42px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
            <i class="fa fa-users" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Referrals</p>
          <p style="color: #555e73; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px;">Signups</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 22px;"><%= @referral_count rescue 0 %></h3>
        </div>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 20px 16px; text-align: center;">
          <div style="width: 42px; height: 42px; background: linear-gradient(135deg, #00b894, #00cec9); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
            <i class="fa fa-sack-dollar" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Total</p>
          <p style="color: #555e73; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px;">In Play</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 22px;"><%= number_with_precision(@active_wager_total, precision: 2) rescue '0.00' %></h3>
        </div>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-3" style="margin-bottom: 15px;">
        <div style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 20px 16px; text-align: center;">
          <div style="width: 42px; height: 42px; background: linear-gradient(135deg, #00b4d8, #0077b6); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
            <i class="fa fa-clock-rotate-left" style="color: white; font-size: 18px;"></i>
          </div>
          <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Wagers</p>
          <p style="color: #555e73; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 6px;">All-Time</p>
          <h3 style="color: white; font-weight: 700; margin: 0; font-size: 22px;"><%= @total_wager_count rescue 0 %></h3>
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 6px; margin-bottom: 24px; background: rgba(255,255,255,0.04); border-radius: 12px; padding: 4px;">
      <button onclick="showWalletTab('wallets')" id="tab-wallets" style="flex: 1; padding: 11px 0; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-link" style="margin-right: 5px;"></i> WALLETS
      </button>
      <button onclick="showWalletTab('swap')" id="tab-swap" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-right-left" style="margin-right: 5px;"></i> SWAP
      </button>
      <button onclick="showWalletTab('history')" id="tab-history" style="flex: 1; padding: 11px 0; background: transparent; color: #8892b0; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px;">
        <i class="fa fa-receipt" style="margin-right: 5px;"></i> HISTORY
      </button>
    </div>

    <div id="panel-wallets">
      <div class="row" style="margin-bottom: 20px;">
        <div class="col-xs-12 col-md-8 col-md-offset-2" style="margin-bottom: 20px;">
          <div style="background: linear-gradient(135deg, rgba(0,136,204,0.12), rgba(0,180,216,0.08)); border: 1px solid rgba(0,180,216,0.3); border-radius: 14px; padding: 24px 28px; height: 100%;">
            <div style="display: flex; align-items: center; margin-bottom: 20px;">
              <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
                <i class="fa fa-wallet" style="color: white; font-size: 22px;"></i>
              </div>
              <div style="flex: 1;">
                <h4 style="color: white; font-weight: 700; margin: 0; font-size: 18px;">Cardano</h4>
                <p style="color: #8892b0; margin: 0; font-size: 13px;">ADA / $BEEP</p>
              </div>
              <% if @user.cardano_wallet_address.present? %>
                <span style="padding: 5px 14px; background: rgba(72,187,120,0.15); color: #68d391; border: 1px solid rgba(72,187,120,0.3); border-radius: 20px; font-size: 12px; font-weight: 600;"><i class="fa fa-circle" style="font-size: 6px; margin-right: 4px; vertical-align: middle;"></i> Connected</span>
              <% else %>
                <span style="padding: 5px 14px; background: rgba(245,101,101,0.1); color: #fc8181; border: 1px solid rgba(245,101,101,0.2); border-radius: 20px; font-size: 12px; font-weight: 600;">Not Connected</span>
              <% end %>
            </div>

            <% if @user.cardano_wallet_address.present? %>
              <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 14px 18px; margin-bottom: 14px;">
                <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 6px;">Address</p>
                <code style="color: #00b4d8; word-break: break-all; font-size: 13px; line-height: 1.5;"><%= @user.cardano_wallet_address %></code>
              </div>

              <% wallet_status = @wallet_info ? @wallet_info[:status] : nil %>

              <% if wallet_status == 'not_found' %>
                <%# Address unused on-chain — help user connect the right address %>
                <div style="background: rgba(255,165,0,0.12); border: 1px solid rgba(255,165,0,0.35); border-radius: 10px; padding: 16px 18px; margin-bottom: 14px;">
                  <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <i class="fa fa-triangle-exclamation" style="color: #f6ad55; font-size: 20px; margin-top: 2px; flex-shrink: 0;"></i>
                    <div>
                      <p style="color: #f6ad55; font-weight: 700; font-size: 14px; margin: 0 0 6px;">Address has no on-chain activity</p>
                      <p style="color: #a0aec0; font-size: 13px; margin: 0 0 8px; line-height: 1.5;">
                        Your connected address hasn't been used on Cardano yet, or your tokens are held across multiple wallet addresses. Try connecting your <strong style="color: #f6ad55;">stake address</strong> instead — it covers all addresses in your wallet.
                      </p>
                      <p style="color: #a0aec0; font-size: 12px; margin: 0;">
                        In <strong>Eternl</strong>: Settings → Account → copy the <code style="background: rgba(0,0,0,0.3); padding: 1px 5px; border-radius: 3px;">stake1...</code> address<br>
                        In <strong>Nami</strong>: click your address → copy the Stake Key<br>
                        In <strong>Yoroi</strong>: Wallet → Receive → Stake address
                      </p>
                    </div>
                  </div>
                </div>

                <div style="margin-bottom: 14px;">
                  <p style="color: #8892b0; font-size: 12px; margin: 0 0 8px; text-transform: uppercase; letter-spacing: 1px;">Update address</p>
                  <%= form_tag(connect_cardano_path, method: :post) do %>
                    <input type="hidden" name="redirect_to" value="<%= wallet_path %>">
                    <input type="text" name="cardano_address" placeholder="stake1... or addr1..." style="width: 100%; padding: 11px 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,165,0,0.4); border-radius: 8px; color: white; font-size: 13px; outline: none; box-sizing: border-box; margin-bottom: 8px;">
                    <button type="submit" style="width: 100%; padding: 11px; background: rgba(255,165,0,0.2); color: #f6ad55; border: 1px solid rgba(255,165,0,0.4); border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                      <i class="fa fa-rotate" style="margin-right: 6px;"></i> Update Address
                    </button>
                  <% end %>
                </div>

              <% elsif @wallet_info && wallet_status == 'active' %>
                <div style="display: flex; gap: 10px; margin-bottom: 14px;">
                  <div style="flex: 1; background: rgba(0,0,0,0.2); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">ADA Balance</p>
                    <span style="color: #00b4d8; font-weight: 700; font-size: 20px;"><%= sprintf('%.2f', @wallet_info[:ada_balance]) %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">ADA</span>
                  </div>
                  <div style="flex: 1; background: rgba(231,76,60,0.12); border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; padding: 12px 16px;">
                    <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">$BEEP On-Chain</p>
                    <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= @on_chain_beep.to_i %></span>
                    <span style="color: #8892b0; font-size: 12px; margin-left: 4px;">$BEEP</span>
                  </div>
                </div>

                <% platform_beep = (@account.balance_cents.to_i / 100) rescue 0 %>
                <% can_sync = @on_chain_beep.to_i > platform_beep %>

                <div style="background: rgba(0,0,0,0.2); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <div>
                      <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 2px;">Platform Balance</p>
                      <span style="color: #00c853; font-weight: 700; font-size: 20px;"><%= platform_beep %> <span style="font-size: 12px; color: #8892b0;">$BEEP</span></span>
                    </div>
                    <div style="text-align: right;">
                      <p style="color: #8892b0; font-size: 11px; margin: 0 0 2px;">On-Chain</p>
                      <span style="color: #e74c3c; font-weight: 700; font-size: 20px;"><%= @on_chain_beep.to_i %> <span style="font-size: 12px; color: #8892b0;">$BEEP</span></span>
                    </div>
                  </div>

                  <% if can_sync %>
                    <% new_beep = @on_chain_beep.to_i - platform_beep %>
                    <%= form_tag(sync_beep_path, method: :post) do %>
                      <button type="submit" style="width: 100%; padding: 13px; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px; box-shadow: 0 4px 15px rgba(231,76,60,0.35);">
                        <i class="fa fa-download" style="margin-right: 8px;"></i> Load <%= new_beep %> $BEEP to Platform
                      </button>
                    <% end %>
                    <p style="color: #8892b0; font-size: 12px; text-align: center; margin: 8px 0 0;">
                      <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                      Credits your on-chain $BEEP to your SportsBeep account.
                    </p>
                  <% else %>
                    <div style="background: rgba(0,200,83,0.1); border: 1px solid rgba(0,200,83,0.3); border-radius: 8px; padding: 10px 14px; text-align: center;">
                      <i class="fa fa-check-circle" style="color: #00c853; margin-right: 6px;"></i>
                      <span style="color: #68d391; font-size: 13px; font-weight: 600;">
                        <% if @on_chain_beep.to_i == 0 %>
                          No $BEEP tokens detected at this address.
                        <% else %>
                          Platform balance is up to date.
                        <% end %>
                      </span>
                    </div>
                  <% end %>
                </div>

                <% if (begin; @wallet_info[:stake_address].present?; rescue; false; end) %>
                  <div style="background: rgba(0,0,0,0.1); border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
                    <p style="color: #8892b0; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">Stake Key</p>
                    <code style="color: #63b3ed; word-break: break-all; font-size: 11px;"><%= @wallet_info[:stake_address] %></code>
                  </div>
                <% end %>

              <% else %>
                <div style="background: rgba(255,200,0,0.1); border: 1px solid rgba(255,200,0,0.2); border-radius: 8px; padding: 12px 16px; margin-bottom: 14px; text-align: center;">
                  <i class="fa fa-spinner fa-spin" style="color: #ffc107; margin-right: 6px;"></i>
                  <span style="color: #ffc107; font-size: 13px;">Reading blockchain data...</span>
                </div>
              <% end %>

              <%= link_to disconnect_cardano_path(redirect_to: wallet_path), method: :delete, data: { confirm: 'Disconnect your Cardano wallet?' }, style: 'display: inline-block; padding: 9px 20px; background: rgba(245,101,101,0.15); color: #fc8181; border: 1px solid rgba(245,101,101,0.3); border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;' do %>
                <i class="fa fa-unlink" style="margin-right: 5px;"></i> Disconnect
              <% end %>
            <% else %>
              <div style="text-align: center; padding: 10px 0 16px;">
                <p style="color: #8892b0; margin: 0 0 18px; font-size: 14px; line-height: 1.6;">
                  Enter your Cardano wallet address to receive $BEEP token rewards.
                </p>
                <%= form_tag(connect_cardano_path, method: :post, id: 'cardano-form') do %>
                  <input type="hidden" name="redirect_to" value="<%= wallet_path %>">
                  <div style="position: relative; margin-bottom: 12px;">
                    <input type="text" name="cardano_address" id="cardano-address-input" placeholder="addr1q... or stake1..." style="width: 100%; padding: 14px 18px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: white; font-size: 14px; outline: none; box-sizing: border-box;" oninput="validateCardanoAddress()">
                  </div>
                  <button type="submit" id="cardano-connect-btn" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(0,136,204,0.35); transition: opacity 0.2s; opacity: 0.5;" disabled onmouseover="if(!this.disabled)this.style.opacity='0.9'" onmouseout="this.style.opacity=this.disabled?'0.5':'1'">
                    <i class="fa fa-wallet" style="margin-right: 8px;"></i> Connect Cardano
                  </button>
                <% end %>
                <p style="color: #8892b0; margin: 10px 0 0; font-size: 12px;">
                  <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
                  Nami, Eternl, Yoroi & more supported
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 18px 22px;">
        <h5 style="color: #8892b0; font-weight: 600; margin: 0 0 14px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
          <i class="fa fa-circle-question" style="margin-right: 6px;"></i>Supported Cardano Wallets
        </h5>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;"><i class="fa fa-wallet" style="margin-right: 4px;"></i> Nami</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Eternl</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Yoroi</span>
          <span style="padding: 5px 12px; background: rgba(0,180,216,0.1); color: #00b4d8; border-radius: 6px; font-size: 12px; font-weight: 600;">Flint</span>
        </div>
      </div>
    </div>

    <div id="panel-swap" style="display: none;">
      <div style="background: linear-gradient(135deg, rgba(108,92,231,0.12), rgba(162,155,254,0.08)); border: 1px solid rgba(162,155,254,0.25); border-radius: 14px; padding: 24px 28px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 20px;">
          <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 14px;">
            <i class="fa fa-right-left" style="color: white; font-size: 18px;"></i>
          </div>
          <div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 17px;">Token Swap</h4>
            <p style="color: #8892b0; margin: 0; font-size: 12px;">Exchange crypto for $BEEP tokens</p>
          </div>
        </div>

        <div style="display: flex; gap: 10px; margin-bottom: 20px;">
          <div style="flex: 1; padding: 12px; background: rgba(0,136,204,0.2); color: #00b4d8; border: 2px solid rgba(0,180,216,0.4); border-radius: 10px; font-size: 14px; font-weight: 700; text-align: center;">
            <i class="fa fa-wallet" style="margin-right: 6px;"></i> ADA &rarr; $BEEP
          </div>
        </div>

        <div style="background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; margin-bottom: 14px;">
          <div style="margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Send</p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
              <input type="number" id="swap-input-amount" placeholder="0.00" min="0" step="0.01" style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;" oninput="updateSwapOutput()">
              <div id="swap-input-label" style="display: flex; align-items: center; background: rgba(0,136,204,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                <span style="color: #00b4d8; font-weight: 700; font-size: 14px;">ADA</span>
              </div>
            </div>
          </div>

          <div style="text-align: center; margin: 12px 0;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(108,92,231,0.3); border: 1px solid rgba(162,155,254,0.4); border-radius: 50%;">
              <i class="fa fa-arrow-down" style="color: #a29bfe; font-size: 14px;"></i>
            </div>
          </div>

          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <p style="color: #8892b0; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 0;">You Receive</p>
              <p style="color: #8892b0; font-size: 12px; margin: 0;" id="swap-rate-label">Rate: <span style="color: #a29bfe;">1 ADA = 5.48 $BEEP</span></p>
            </div>
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 16px;">
              <input type="text" id="swap-output-amount" placeholder="0.00" readonly style="flex: 1; background: transparent; border: none; color: white; font-size: 20px; font-weight: 600; outline: none; width: 100%;">
              <div style="display: flex; align-items: center; background: rgba(231,76,60,0.2); padding: 6px 14px; border-radius: 8px; margin-left: 10px;">
                <span style="color: #e74c3c; font-weight: 700; font-size: 14px;">$BEEP</span>
              </div>
            </div>
          </div>
        </div>

        <div style="background: rgba(0,0,0,0.15); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Exchange Rate</span>
            <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-rate-detail">1 ADA = 5.48 $BEEP</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: #8892b0; font-size: 13px;">Network Fee</span>
            <span style="color: white; font-size: 13px; font-weight: 600;" id="swap-fee-detail">~0.17 ADA</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: #8892b0; font-size: 13px;">Estimated Time</span>
            <span style="color: white; font-size: 13px; font-weight: 600;">~1-2 minutes</span>
          </div>
        </div>

        <button onclick="initiateSwap()" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 15px rgba(108,92,231,0.35); transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          Swap for $BEEP
        </button>
        <p style="text-align: center; color: #8892b0; margin: 10px 0 0; font-size: 12px;">
          <i class="fa fa-shield-halved" style="margin-right: 4px;"></i>
          Powered by blockchain smart contracts
        </p>
        <div id="swap-status" style="display: none; margin-top: 14px;"></div>
      </div>
    </div>

    <div id="panel-history" style="display: none;">
      <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden; margin-bottom: 20px;">
        <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #fdcb6e, #e17055); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
              <i class="fa fa-clock-rotate-left" style="color: white; font-size: 16px;"></i>
            </div>
            <h4 style="color: white; font-weight: 700; margin: 0; font-size: 16px;">Transaction History</h4>
          </div>
          <% if @transactions.any? %>
            <%= link_to user_transactions_path, style: 'color: #a29bfe; font-size: 13px; text-decoration: none; font-weight: 600;' do %>
              View All <i class="fa fa-arrow-right" style="margin-left: 4px; font-size: 11px;"></i>
            <% end %>
          <% end %>
        </div>

        <% if @transactions.any? %>
          <% @transactions.each do |txn| %>
            <div style="padding: 14px 22px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center;">
                <% amount_val = txn.amount_cents.to_i rescue 0 %>
                <div style="width: 36px; height: 36px; background: <%= amount_val >= 0 ? 'rgba(0,184,148,0.15)' : 'rgba(231,76,60,0.15)' %>; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                  <i class="fa <%= amount_val >= 0 ? 'fa-arrow-down' : 'fa-arrow-up' %>" style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-size: 14px;"></i>
                </div>
                <div>
                  <p style="color: white; margin: 0; font-size: 14px; font-weight: 600;"><%= txn.description %></p>
                  <p style="color: #8892b0; margin: 0; font-size: 12px;"><%= txn.created_at.strftime("%b %d, %Y %I:%M %p") %></p>
                </div>
              </div>
              <span style="color: <%= amount_val >= 0 ? '#00b894' : '#e74c3c' %>; font-weight: 700; font-size: 15px;">
                <%= amount_val >= 0 ? '+' : '' %><%= txn.amount %>
              </span>
            </div>
          <% end %>
        <% else %>
          <div style="padding: 50px 20px; text-align: center;">
            <i class="fa fa-receipt" style="font-size: 40px; color: rgba(255,255,255,0.12); margin-bottom: 14px; display: block;"></i>
            <p style="color: #8892b0; margin: 0 0 4px; font-size: 15px; font-weight: 600;">No transactions yet</p>
            <p style="color: rgba(255,255,255,0.3); margin: 0; font-size: 13px;">Enter a contest or swap tokens to get started!</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<script>
  function showWalletTab(tab) {
    var panels = ['wallets', 'swap', 'history'];
    panels.forEach(function(p) {
      var panel = document.getElementById('panel-' + p);
      var tabBtn = document.getElementById('tab-' + p);
      if (panel) panel.style.display = (p === tab) ? 'block' : 'none';
      if (tabBtn) {
        if (p === tab) {
          tabBtn.style.background = 'linear-gradient(135deg, #6c5ce7, #a29bfe)';
          tabBtn.style.color = 'white';
        } else {
          tabBtn.style.background = 'transparent';
          tabBtn.style.color = '#8892b0';
        }
      }
    });
  }

  var ADA_RATE = 5.48;

  function updateSwapOutput() {
    var input = document.getElementById('swap-input-amount');
    var output = document.getElementById('swap-output-amount');
    var val = parseFloat(input.value) || 0;
    output.value = val > 0 ? (val * ADA_RATE).toFixed(2) : '';
  }

  function initiateSwap() {
    var amount = parseFloat(document.getElementById('swap-input-amount').value);
    var statusDiv = document.getElementById('swap-status');

    if (!amount || amount <= 0) {
      statusDiv.style.display = 'block';
      statusDiv.innerHTML = '<div style="background: rgba(245,101,101,0.15); border: 1px solid rgba(245,101,101,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #fc8181; margin: 0; font-size: 14px;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i>Please enter a valid amount to swap.</p></div>';
      return;
    }

    var beepAmount = (amount * ADA_RATE).toFixed(2);

    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-spinner fa-spin" style="margin-right: 6px;"></i>Processing swap of ' + amount + ' ADA for ' + beepAmount + ' $BEEP...</p></div>';

    setTimeout(function() {
      statusDiv.innerHTML = '<div style="background: rgba(72,187,120,0.15); border: 1px solid rgba(72,187,120,0.3); border-radius: 10px; padding: 12px 16px;"><p style="color: #68d391; margin: 0; font-size: 14px;"><i class="fa fa-check-circle" style="margin-right: 6px;"></i>Swap request submitted! Your ' + beepAmount + ' $BEEP will be credited to your account shortly. $BEEP is live on Cardano mainnet.</p></div>';
    }, 2000);
  }

  function validateCardanoAddress() {
    var input = document.getElementById('cardano-address-input');
    var btn = document.getElementById('cardano-connect-btn');
    if (!input || !btn) return;
    var val = input.value.trim();
    var valid = val.length > 50 && (val.startsWith('addr1') || val.startsWith('addr_test1') || val.startsWith('stake1') || val.startsWith('stake_test1'));
    btn.disabled = !valid;
    btn.style.opacity = valid ? '1' : '0.5';
  }
</script>
