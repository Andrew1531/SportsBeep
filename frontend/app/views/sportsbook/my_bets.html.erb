<div class="my-bets-page">

  <div class="bets-header">
    <div class="container" style="max-width: 960px; margin: 0 auto;">
      <h1>MY BETS</h1>
      <p class="subtitle">Track your wagers and results</p>
    </div>
  </div>

  <div class="container" style="max-width: 960px; margin: 0 auto;">

    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-inner">
          <div class="stat-value"><%= Money.new(@total_wagered).format rescue '$0.00' %></div>
          <div class="stat-label">Wagered</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-inner">
          <div class="stat-value"><%= Money.new(@total_won).format rescue '$0.00' %></div>
          <div class="stat-label">Won</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-inner wins">
          <div class="stat-value"><%= @win_count %></div>
          <div class="stat-label">Wins</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-inner losses">
          <div class="stat-value"><%= @loss_count %></div>
          <div class="stat-label">Losses</div>
        </div>
      </div>
    </div>

    <div class="bets-section">
      <h3 class="section-title"><i class="fa fa-clock"></i> OPEN WAGERS</h3>

      <% if @open_wagers.any? %>
        <% @open_wagers.each do |wager| %>
          <%
            away_city, away_mascot = split_team_name(wager.away_team)
            home_city, home_mascot = split_team_name(wager.home_team)
            away_color = team_color(wager.away_team, 0)
            home_color = team_color(wager.home_team, 0)
          %>
          <div class="bet-card">
            <div class="bet-card-matchup">
              <div class="bet-split-away" style="background: <%= away_color %>;"></div>
              <div class="bet-split-home" style="background: <%= home_color %>;"></div>
              <%= image_tag 'at.png', class: 'bet-at-image' %>
              <div class="bet-team-away">
                <% if away_city.present? %>
                  <div class="bet-team-city"><%= away_city %></div>
                <% end %>
                <div class="bet-team-mascot"><%= away_mascot %></div>
              </div>
              <div class="bet-team-home">
                <% if home_city.present? %>
                  <div class="bet-team-city"><%= home_city %></div>
                <% end %>
                <div class="bet-team-mascot"><%= home_mascot %></div>
              </div>
            </div>
            <div class="bet-info-bar">
              <div class="bet-type-info">
                <span class="bet-selection-name"><%= wager.selection %></span>
                <span class="bet-type-label"><%= wager.bet_type_display %></span>
              </div>
              <span class="bet-odds-badge"><%= wager.odds_display %></span>
            </div>
            <div class="bet-bottom-bar">
              <span>Wager: <span class="bet-wager-amount"><%= wager.amount %> $BEEP</span></span>
              <span>Payout: <span class="bet-payout-amount"><%= wager.potential_payout %></span></span>
            </div>
            <div class="bet-status-strip status-<%= wager.status %>"><%= wager.status_display %></div>
          </div>
        <% end %>
      <% else %>
        <div class="no-bets">
          <%= image_tag 'ic_pickgame.png', style: 'width: 48px; height: 48px; opacity: 0.2; margin-bottom: 8px;' %>
          <p>No open wagers</p>
        </div>
      <% end %>
    </div>

    <div class="bets-section">
      <h3 class="section-title"><i class="fa fa-flag-checkered"></i> SETTLED BETS</h3>

      <% if @settled_wagers.any? %>
        <% @settled_wagers.each do |wager| %>
          <%
            away_city, away_mascot = split_team_name(wager.away_team)
            home_city, home_mascot = split_team_name(wager.home_team)
            away_color = team_color(wager.away_team, 0)
            home_color = team_color(wager.home_team, 0)
          %>
          <div class="bet-card">
            <div class="bet-card-matchup">
              <div class="bet-split-away" style="background: <%= away_color %>;"></div>
              <div class="bet-split-home" style="background: <%= home_color %>;"></div>
              <%= image_tag 'at.png', class: 'bet-at-image' %>
              <div class="bet-team-away">
                <% if away_city.present? %>
                  <div class="bet-team-city"><%= away_city %></div>
                <% end %>
                <div class="bet-team-mascot"><%= away_mascot %></div>
              </div>
              <div class="bet-team-home">
                <% if home_city.present? %>
                  <div class="bet-team-city"><%= home_city %></div>
                <% end %>
                <div class="bet-team-mascot"><%= home_mascot %></div>
              </div>
            </div>
            <div class="bet-info-bar">
              <div class="bet-type-info">
                <span class="bet-selection-name"><%= wager.selection %></span>
                <span class="bet-type-label"><%= wager.bet_type_display %></span>
              </div>
              <span class="bet-odds-badge"><%= wager.odds_display %></span>
            </div>
            <div class="bet-bottom-bar">
              <span>Wager: <span class="bet-wager-amount"><%= wager.amount %> $BEEP</span></span>
              <span>Payout: <span class="bet-payout-amount"><%= wager.potential_payout %></span></span>
            </div>
            <div class="bet-status-strip status-<%= wager.status %>"><%= wager.status_display %></div>
          </div>
        <% end %>
      <% else %>
        <div class="no-bets">
          <%= image_tag 'ic_contests.png', style: 'width: 48px; height: 48px; opacity: 0.2; margin-bottom: 8px;' %>
          <p>No settled bets yet</p>
        </div>
      <% end %>
    </div>

    <div class="back-to-sportsbook">
      <%= link_to 'Back to Sportsbook', sportsbook_path %>
    </div>

  </div>
</div>
