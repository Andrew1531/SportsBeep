<div class="dk-sportsbook">

  <div class="dk-top-bar">
    <div class="dk-top-inner">
      <div class="dk-brand">
        <%= (image_tag 'logo.png', class: 'dk-logo') rescue nil %>
        <span class="dk-title">SPORTSBOOK</span>
      </div>
      <div class="dk-balance">
        <span class="dk-bal-label">Balance</span>
        <span class="dk-bal-value"><%= number_with_precision(@account.balance, precision: 2) rescue '0.00' %></span>
        <span class="dk-bal-currency">$BEEP</span>
      </div>
    </div>
  </div>

  <nav class="dk-sport-nav">
    <% sports = [
      { key: 'mlb', label: 'MLB', icon: 'ic_baseball.png' },
      { key: 'nfl', label: 'NFL', icon: 'ic_football.png' },
      { key: 'nba', label: 'NBA', icon: 'ic_basketball.png' },
      { key: 'nhl', label: 'NHL', icon: 'ic_hockey.png' }
    ] %>
    <% sports.each do |s| %>
      <%= link_to sportsbook_path(sport: s[:key]), class: "dk-sport-tab #{'active' if @sport == s[:key]}" do %>
        <%= image_tag s[:icon], class: 'dk-sport-icon' %>
        <span><%= s[:label] %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="dk-content">

    <% if flash[:notice] %>
      <div class="dk-alert dk-alert-success"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="dk-alert dk-alert-error"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></div>
    <% end %>

    <% unless @has_beep %>
      <div class="dk-alert dk-alert-warning">
        <i class="fa fa-exclamation-triangle"></i>
        You need <strong>$BEEP tokens</strong> to place wagers.
        <%= link_to 'Get $BEEP', wallet_path %>
      </div>
    <% end %>

    <% if @open_wagers.present? %>
      <div class="dk-active-bets">
        <div class="dk-active-header">
          <span><i class="fa fa-receipt"></i> Active Wagers (<%= @open_wagers.size %>)</span>
          <%= link_to 'View All', my_bets_path, class: 'dk-view-all' %>
        </div>
        <% @open_wagers.each do |wager| %>
          <div class="dk-active-row">
            <div class="dk-active-sel"><%= wager.selection %></div>
            <div class="dk-active-type"><%= wager.bet_type_display %> (<%= wager.odds_display %>)</div>
            <div class="dk-active-amt"><%= wager.amount %> $BEEP</div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @games.any? %>
      <div class="dk-odds-header">
        <div class="dk-oh-left"><%= @sport.upcase %> — <%= @games.size %> Games</div>
        <div class="dk-oh-right">
          <span class="dk-oh-col">SPREAD</span>
          <span class="dk-oh-col">TOTAL</span>
          <span class="dk-oh-col">MONEYLINE</span>
        </div>
      </div>

      <% grouped = @games.group_by { |g| g[:start_date] ? Time.parse(g[:start_date]).strftime('%A, %b %-d') : 'TBD' } rescue { 'Today' => @games } %>
      <% grouped.each do |date_label, games| %>
        <div class="dk-date-divider"><%= date_label %></div>

        <% games.each do |game| %>
          <% odds = game[:odds] || {} %>
          <% ml = odds[:moneyline] || {} %>
          <% sp = odds[:spread] || {} %>
          <% tot = odds[:total] || {} %>
          <% start_time = game[:start_date] ? Time.parse(game[:start_date]) : nil rescue nil %>
          <% start_time_str = start_time ? start_time.iso8601 : '' %>
          <%
            away_city, away_mascot = split_team_name(game[:away_team])
            home_city, home_mascot = split_team_name(game[:home_team])
            away_color = team_color(game[:away_team], 0)
            home_color = team_color(game[:home_team], 0)
          %>

          <div class="dk-game-row">
            <div class="dk-game-info">
              <div class="dk-time">
                <% if game[:is_live] %>
                  <span class="dk-live-dot"></span><span class="dk-live-text">LIVE</span>
                <% elsif start_time %>
                  <%= start_time.strftime('%-I:%M %p') %>
                <% end %>
              </div>
              <div class="dk-teams">
                <div class="dk-team-row">
                  <span class="dk-team-color" style="background: <%= away_color %>;"></span>
                  <span class="dk-team-name"><%= game[:away_team] %></span>
                </div>
                <div class="dk-team-row">
                  <span class="dk-team-color" style="background: <%= home_color %>;"></span>
                  <span class="dk-team-name"><%= game[:home_team] %></span>
                </div>
              </div>
            </div>

            <div class="dk-odds-cells">
              <div class="dk-odds-col">
                <% if sp[:away_points] && sp[:away] %>
                  <button type="button" class="dk-odds-btn js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="spread" data-selection="<%= game[:away_team] %>" data-points="<%= sp[:away_points] %>" data-odds="<%= sp[:away] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-line"><%= sp[:away_points].to_f > 0 ? "+#{sp[:away_points]}" : sp[:away_points] %></span>
                    <span class="dk-price"><%= sp[:away].to_i > 0 ? "+#{sp[:away].to_i}" : sp[:away].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
                <% if sp[:home_points] && sp[:home] %>
                  <button type="button" class="dk-odds-btn js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="spread" data-selection="<%= game[:home_team] %>" data-points="<%= sp[:home_points] %>" data-odds="<%= sp[:home] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-line"><%= sp[:home_points].to_f > 0 ? "+#{sp[:home_points]}" : sp[:home_points] %></span>
                    <span class="dk-price"><%= sp[:home].to_i > 0 ? "+#{sp[:home].to_i}" : sp[:home].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
              </div>

              <div class="dk-odds-col">
                <% if tot[:over] && tot[:points] %>
                  <button type="button" class="dk-odds-btn js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="total" data-selection="Over" data-points="<%= tot[:points] %>" data-odds="<%= tot[:over] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-line">O <%= tot[:points] %></span>
                    <span class="dk-price"><%= tot[:over].to_i > 0 ? "+#{tot[:over].to_i}" : tot[:over].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
                <% if tot[:under] && tot[:points] %>
                  <button type="button" class="dk-odds-btn js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="total" data-selection="Under" data-points="<%= tot[:points] %>" data-odds="<%= tot[:under] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-line">U <%= tot[:points] %></span>
                    <span class="dk-price"><%= tot[:under].to_i > 0 ? "+#{tot[:under].to_i}" : tot[:under].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
              </div>

              <div class="dk-odds-col">
                <% if ml[:away] %>
                  <button type="button" class="dk-odds-btn dk-odds-ml js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="moneyline" data-selection="<%= game[:away_team] %>" data-points="" data-odds="<%= ml[:away] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-price"><%= ml[:away].to_i > 0 ? "+#{ml[:away].to_i}" : ml[:away].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
                <% if ml[:home] %>
                  <button type="button" class="dk-odds-btn dk-odds-ml js-bet-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="moneyline" data-selection="<%= game[:home_team] %>" data-points="" data-odds="<%= ml[:home] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>">
                    <span class="dk-price"><%= ml[:home].to_i > 0 ? "+#{ml[:home].to_i}" : ml[:home].to_i %></span>
                  </button>
                <% else %>
                  <div class="dk-odds-empty"></div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="dk-empty-state">
        <% no_game_icons = { 'mlb' => 'ic_baseball.png', 'nfl' => 'ic_football.png', 'nba' => 'ic_basketball.png', 'nhl' => 'ic_hockey.png' } %>
        <%= image_tag no_game_icons[@sport] || 'ic_baseball.png', class: 'dk-empty-icon' %>
        <h3>No <%= @sport.upcase %> Games Available</h3>
        <p>Check back later or browse another sport.</p>
      </div>
    <% end %>

  </div>
</div>

<div id="dk-betslip" class="dk-betslip-overlay">
  <div class="dk-betslip-panel">
    <div class="dk-bs-header">
      <span class="dk-bs-title">Bet Slip</span>
      <button class="dk-bs-close" onclick="closeBetSlip()"><i class="fa fa-times"></i></button>
    </div>

    <div class="dk-bs-pick">
      <div class="dk-bs-pick-sel" id="bs-selection"></div>
      <div class="dk-bs-pick-detail" id="bs-detail"></div>
      <div class="dk-bs-pick-matchup" id="bs-matchup"></div>
    </div>

    <div class="dk-bs-odds-row">
      <span class="dk-bs-odds-label">Odds</span>
      <span class="dk-bs-odds-value" id="bs-odds"></span>
    </div>

    <%= form_tag place_wager_path, method: :post, id: 'bet-slip-form' do %>
      <input type="hidden" name="wager[fixture_id]" id="wager_fixture_id">
      <input type="hidden" name="wager[game_id]" id="wager_game_id">
      <input type="hidden" name="wager[away_team]" id="wager_away_team">
      <input type="hidden" name="wager[home_team]" id="wager_home_team">
      <input type="hidden" name="wager[game_start_time]" id="wager_game_start_time">
      <input type="hidden" name="wager[bet_type]" id="wager_bet_type">
      <input type="hidden" name="wager[selection]" id="wager_selection">
      <input type="hidden" name="wager[selection_detail]" id="wager_selection_detail">
      <input type="hidden" name="wager[odds]" id="wager_odds">
      <input type="hidden" name="wager[points]" id="wager_points">
      <input type="hidden" name="wager[sport]" id="wager_sport">
      <input type="hidden" name="wager[league]" id="wager_league">
      <input type="hidden" name="wager[sportsbook]" value="DraftKings">

      <div class="dk-bs-amount-section">
        <label class="dk-bs-amount-label">Wager ($BEEP)</label>
        <div class="dk-bs-input-wrap">
          <span class="dk-bs-dollar">$</span>
          <input type="number" name="wager[amount_cents]" id="wager_amount_cents" min="1" step="1" placeholder="0" class="dk-bs-input" oninput="updatePayout()">
        </div>
        <div class="dk-bs-quick">
          <button type="button" onclick="setAmount(100)">$1</button>
          <button type="button" onclick="setAmount(500)">$5</button>
          <button type="button" onclick="setAmount(1000)">$10</button>
          <button type="button" onclick="setAmount(2500)">$25</button>
          <button type="button" onclick="setAmount(5000)">$50</button>
        </div>
      </div>

      <div class="dk-bs-payout">
        <div class="dk-bs-payout-row">
          <span>Wager</span>
          <span id="bs-wager-display">$0.00</span>
        </div>
        <div class="dk-bs-payout-row dk-bs-payout-total">
          <span>To Win</span>
          <span id="bs-payout-display">$0.00</span>
        </div>
      </div>

      <button type="submit" class="dk-bs-submit">Place Wager</button>
    <% end %>
  </div>
</div>

<script>
  document.querySelectorAll('.js-bet-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var d = this.dataset;
      openBetSlip(d.fixture, d.game, d.away, d.home, d.start, d.type, d.selection, d.points, d.odds, d.sport, d.league);
    });
  });

  function openBetSlip(fixtureId, gameId, awayTeam, homeTeam, startTime, betType, selection, points, odds, sport, league) {
    document.getElementById('wager_fixture_id').value = fixtureId;
    document.getElementById('wager_game_id').value = gameId;
    document.getElementById('wager_away_team').value = awayTeam;
    document.getElementById('wager_home_team').value = homeTeam;
    document.getElementById('wager_game_start_time').value = startTime;
    document.getElementById('wager_bet_type').value = betType;
    document.getElementById('wager_selection').value = selection;
    document.getElementById('wager_odds').value = odds;
    document.getElementById('wager_points').value = points || '';
    document.getElementById('wager_sport').value = sport;
    document.getElementById('wager_league').value = league;

    document.getElementById('bs-matchup').textContent = awayTeam + ' @ ' + homeTeam;

    var oddsNum = parseInt(odds);
    var oddsText = oddsNum > 0 ? '+' + oddsNum : oddsNum.toString();
    document.getElementById('bs-odds').textContent = oddsText;

    var selText = '';
    var detailText = '';
    if (betType === 'moneyline') {
      selText = selection;
      detailText = 'Moneyline';
    } else if (betType === 'spread') {
      var pts = parseFloat(points);
      var ptsDisplay = pts > 0 ? '+' + pts : pts.toString();
      selText = selection + ' ' + ptsDisplay;
      detailText = 'Spread';
      document.getElementById('wager_selection_detail').value = ptsDisplay;
    } else if (betType === 'total') {
      selText = selection + ' ' + points;
      detailText = 'Total';
      document.getElementById('wager_selection_detail').value = selection;
    }

    document.getElementById('bs-selection').textContent = selText;
    document.getElementById('bs-detail').textContent = detailText;

    document.getElementById('wager_amount_cents').value = '';
    document.getElementById('bs-wager-display').textContent = '$0.00';
    document.getElementById('bs-payout-display').textContent = '$0.00';

    document.getElementById('dk-betslip').classList.add('open');
  }

  function closeBetSlip() {
    document.getElementById('dk-betslip').classList.remove('open');
  }

  function setAmount(cents) {
    document.getElementById('wager_amount_cents').value = cents;
    updatePayout();
  }

  function updatePayout() {
    var amountCents = parseInt(document.getElementById('wager_amount_cents').value) || 0;
    var odds = parseFloat(document.getElementById('wager_odds').value) || 0;
    var amount = amountCents / 100.0;

    document.getElementById('bs-wager-display').textContent = '$' + amount.toFixed(2);

    var profit = 0;
    if (odds > 0) {
      profit = amount * odds / 100;
    } else if (odds < 0) {
      profit = amount * 100 / Math.abs(odds);
    }
    document.getElementById('bs-payout-display').textContent = '$' + profit.toFixed(2);
  }

  document.getElementById('dk-betslip').addEventListener('click', function(e) {
    if (e.target === this) closeBetSlip();
  });
</script>
