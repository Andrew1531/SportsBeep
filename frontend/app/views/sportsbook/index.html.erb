<%# Expose real balance to JavaScript for client-side guard %>
<script>
  var SB_LOGGED_IN     = <%= user_signed_in? ? 'true' : 'false' %>;
  var SB_TOKENS = <%= raw((@approved_tokens || []).each_with_object({}) { |token, values|
    balance = @account ? @account.token_balance_for(token).balance_units.to_i : 0
    values[token.id] = { ticker: token.ticker, decimals: token.decimals, balanceUnits: balance, balance: token.format_units(balance) }
  }.to_json) %>;
</script>

<%# Buy BEEP modal — shown when wager exceeds balance %>
<div id="buy-beep-modal" class="bb-modal-backdrop" onclick="if(event.target===this)bbCloseModal()" style="display:none;">
  <div class="bb-modal">
    <button class="bb-modal-close" onclick="bbCloseModal()">&#x2715;</button>
    <div class="bb-modal-icon"><i class="fa fa-bolt"></i></div>
    <h2 class="bb-modal-title">Insufficient $BEEP</h2>
    <p class="bb-modal-body" id="bb-modal-msg">
      You can only wager play credit you've unlocked in your SportsBeep game balance. Holding $BEEP in your connected wallet unlocks credit — your real tokens stay in your wallet.
    </p>
    <div class="bb-modal-balance-row">
      <span class="bb-modal-bal-label">Your Balance</span>
      <span class="bb-modal-bal-value" id="bb-modal-bal"></span>
    </div>
    <div class="bb-modal-actions">
      <% if user_signed_in? %>
        <%= link_to 'Go to Wallet →', wallet_path, class: 'bb-btn-primary' %>
      <% else %>
        <%= link_to 'Sign Up Free', new_user_registration_path, class: 'bb-btn-primary' %>
      <% end %>
      <button class="bb-btn-secondary" onclick="bbCloseModal()">Cancel</button>
    </div>
    <p class="bb-modal-hint">Only unlocked play credit can be wagered. Unlock credit from your wallet holdings first — no tokens are moved on-chain.</p>
  </div>
</div>

<%# Hidden form that submits wagers to the backend %>
<%= form_tag place_wager_path, method: :post, id: 'hidden-bet-form', style: 'display:none' do %>
  <input type="hidden" id="wager_fixture_id"      name="wager[fixture_id]">
  <input type="hidden" id="wager_game_id"         name="wager[game_id]">
  <input type="hidden" id="wager_away_team"       name="wager[away_team]">
  <input type="hidden" id="wager_home_team"       name="wager[home_team]">
  <input type="hidden" id="wager_game_start_time" name="wager[game_start_time]">
  <input type="hidden" id="wager_bet_type"        name="wager[bet_type]">
  <input type="hidden" id="wager_selection"       name="wager[selection]">
  <input type="hidden" id="wager_selection_detail" name="wager[selection_detail]">
  <input type="hidden" id="wager_odds"            name="wager[odds]">
  <input type="hidden" id="wager_points"          name="wager[points]">
  <input type="hidden" id="wager_sport"           name="wager[sport]">
  <input type="hidden" id="wager_league"          name="wager[league]">
  <input type="hidden" id="wager_amount_cents"    name="wager[amount_cents]">
  <input type="hidden" id="wager_approved_token_id" name="wager[approved_token_id]">
  <input type="hidden" id="wager_amount_units" name="wager[amount_units]">
  <input type="hidden" id="wager_is_parlay"       name="wager[is_parlay]" value="false">
  <input type="hidden" id="wager_parlay_legs"     name="wager[parlay_legs]">
<% end %>

<div class="dk-sportsbook">

  <%# TOP BAR %>
  <div class="dk-top-bar">
    <div class="dk-top-inner">
      <div class="dk-brand">
        <span class="dk-title">SPORTSBOOK</span>
      </div>
      <div class="dk-balance">
        <span class="dk-bal-label">Game Balance</span>
        <span class="dk-bal-value"><%= number_with_precision(@account.balance, precision: 2) rescue '0.00' %></span>
        <span class="dk-bal-currency">$BEEP</span>
        <% wallet_connected = (current_user&.cardano_wallet_address.present? rescue false) %>
        <% if wallet_connected %>
          <div style="color:#8892b0;font-size:11px;margin-top:4px;">This is the only $BEEP you can wager right now.</div>
        <% else %>
          <div style="color:#f6ad55;font-size:11px;margin-top:4px;">
            <i class="fa fa-exclamation-circle" style="margin-right:4px;"></i>No wallet connected —
            <%= link_to 'connect & load $BEEP', wallet_path, style: 'color:#00c853;text-decoration:underline;' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# SPORT TABS %>
  <div class="dk-sport-nav">
    <% [['mlb','MLB','ic_baseball.png'],['nfl','NFL','ic_football.png'],['nba','NBA','ic_basketball.png'],['nhl','NHL','ic_hockey.png']].each do |key, label, icon| %>
      <%= link_to sportsbook_path(sport: key), class: "dk-sport-tab#{' active' if @sport == key}" do %>
        <%= (image_tag icon, class: 'dk-sport-icon') rescue nil %>
        <%= label %>
      <% end %>
    <% end %>
  </div>

  <div class="dk-content" style="padding: 0 16px 80px;">

    <%# FLASH MESSAGES %>
    <% if flash[:notice] %>
      <div class="dk-alert dk-alert-success" style="margin-top:12px;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="dk-alert dk-alert-error" style="margin-top:12px;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></div>
    <% end %>
    <% unless @has_beep %>
      <div class="dk-alert dk-alert-warning" style="margin-top:12px;"><i class="fa fa-exclamation-triangle"></i> You need <strong>unlocked play credit</strong> to place wagers. Unlock it from your connected wallet holdings — your tokens stay in your wallet. <%= link_to 'Go to Wallet →', wallet_path %></div>
    <% end %>

    <%# ACTIVE WAGERS (compact list) %>
    <% if @open_wagers.present? %>
      <div class="dk-active-bets" style="margin-top:16px;">
        <div class="dk-active-header">
          <span><i class="fa fa-receipt"></i> ACTIVE WAGERS</span>
          <%= link_to 'View All →', my_bets_path, class: 'dk-view-all' %>
        </div>
        <% @open_wagers.each do |w| %>
          <div class="dk-active-row">
            <span class="dk-active-sel"><%= w.selection %></span>
            <span class="dk-active-type"><%= w.bet_type_display rescue w.bet_type %></span>
            <span class="dk-active-amt"><%= w.amount %> $BEEP</span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# NAV TABS %>
    <div class="fantasy-nav-bar" style="margin-top:16px;">
      <a class="fnav-link active" href="<%= sportsbook_path(sport: @sport) %>">Available Lines</a>
      <%= link_to 'My Wagers', my_bets_path, class: 'fnav-link' %>
    </div>

    <% if @games.any? %>
      <%# STICKY ODDS COLUMNS HEADER %>
      <div class="dk-odds-header">
        <div class="dk-oh-left"><%= @sport.upcase %> LINES &nbsp;·&nbsp; <span style="color:#555e73;font-weight:500;font-size:13px;"><%= @games.size %> games</span></div>
        <div class="dk-oh-right">
          <span class="dk-oh-col">SPREAD</span>
          <span class="dk-oh-col">TOTAL</span>
          <span class="dk-oh-col">ML</span>
        </div>
      </div>

      <%# GAMES LIST %>
      <% current_date = nil %>
      <% @games.each_with_index do |game, idx| %>
        <%
          odds         = game[:odds] || {}
          ml           = odds[:moneyline] || {}
          sp           = odds[:spread] || {}
          tot          = odds[:total] || {}
          start_time   = game[:start_date] ? (Time.parse(game[:start_date]) rescue nil) : nil
          date_label   = start_time ? start_time.strftime('%A, %b %-d').upcase : 'UPCOMING'
          time_label   = start_time ? start_time.in_time_zone('Eastern Time (US & Canada)').strftime('%-I:%M') : '—'
          ampm_label   = start_time ? start_time.in_time_zone('Eastern Time (US & Canada)').strftime('%p') : ''
          away_color   = team_color(game[:away_team], 0)
          home_color   = team_color(game[:home_team], 0)
          away_city, away_mascot = split_team_name(game[:away_team])
          home_city, home_mascot = split_team_name(game[:home_team])
          gid          = "g#{idx}"
          fix          = game[:fixture_id].to_s
          gam          = game[:game_id].to_s
          at           = j(game[:away_team])
          ht           = j(game[:home_team])
          ts           = start_time ? start_time.iso8601 : ''
          sp_str       = game[:league].to_s
        %>

        <% if date_label != current_date %>
          <% current_date = date_label %>
          <div class="dk-date-divider"><%= date_label %></div>
        <% end %>

        <div class="dk-game-row" id="<%= gid %>">
          <%# Team logo panel %>
          <% away_logo = team_logo_url(game[:away_team]); home_logo = team_logo_url(game[:home_team]) %>
          <div class="dk-logo-panel">
            <div class="dk-logo-slot" style="border-bottom:1px solid rgba(0,0,0,0.3);">
              <% if away_logo %>
                <img src="<%= away_logo %>" alt="<%= away_mascot %>" class="dk-team-logo-img">
              <% else %>
                <div class="dk-logo-fallback" style="background:<%= away_color %>;"></div>
              <% end %>
            </div>
            <div class="dk-logo-slot">
              <% if home_logo %>
                <img src="<%= home_logo %>" alt="<%= home_mascot %>" class="dk-team-logo-img">
              <% else %>
                <div class="dk-logo-fallback" style="background:<%= home_color %>;"></div>
              <% end %>
            </div>
          </div>

          <div class="dk-game-info">
            <div class="dk-time">
              <% if game[:is_live] %>
                <span class="dk-live-dot"></span>
                <span class="dk-live-text">LIVE</span>
              <% else %>
                <div><%= time_label %></div>
                <div style="font-size:10px;"><%= ampm_label %></div>
              <% end %>
            </div>
            <div class="dk-teams">
              <div class="dk-team-row">
                <div class="dk-team-color" style="background:<%= away_color %>;"></div>
                <span class="dk-team-name"><%= away_mascot %></span>
              </div>
              <div class="dk-team-row">
                <div class="dk-team-color" style="background:<%= home_color %>;"></div>
                <span class="dk-team-name"><%= home_mascot %></span>
              </div>
            </div>
          </div>

          <div class="dk-odds-cells">
            <%# SPREAD COLUMN %>
            <div class="dk-odds-col">
              <% if sp[:away_points] && sp[:away] %>
                <button class="dk-odds-btn" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','spread','<%= at %>','<%= sp[:away_points] %>','<%= sp[:away] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-line"><%= sp[:away_points].to_f > 0 ? "+#{sp[:away_points]}" : sp[:away_points] %></span>
                  <span class="dk-price"><%= sp[:away].to_i > 0 ? "+#{sp[:away].to_i}" : sp[:away].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
              <% if sp[:home_points] && sp[:home] %>
                <button class="dk-odds-btn" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','spread','<%= ht %>','<%= sp[:home_points] %>','<%= sp[:home] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-line"><%= sp[:home_points].to_f > 0 ? "+#{sp[:home_points]}" : sp[:home_points] %></span>
                  <span class="dk-price"><%= sp[:home].to_i > 0 ? "+#{sp[:home].to_i}" : sp[:home].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
            </div>

            <%# TOTAL COLUMN %>
            <div class="dk-odds-col">
              <% if tot[:over] && tot[:points] %>
                <button class="dk-odds-btn" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','total','Over','<%= tot[:points] %>','<%= tot[:over] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-line">O&nbsp;<%= tot[:points] %></span>
                  <span class="dk-price"><%= tot[:over].to_i > 0 ? "+#{tot[:over].to_i}" : tot[:over].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
              <% if tot[:under] && tot[:points] %>
                <button class="dk-odds-btn" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','total','Under','<%= tot[:points] %>','<%= tot[:under] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-line">U&nbsp;<%= tot[:points] %></span>
                  <span class="dk-price"><%= tot[:under].to_i > 0 ? "+#{tot[:under].to_i}" : tot[:under].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
            </div>

            <%# MONEYLINE COLUMN %>
            <div class="dk-odds-col">
              <% if ml[:away] %>
                <button class="dk-odds-btn dk-odds-ml" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','moneyline','<%= at %>','','<%= ml[:away] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-price"><%= ml[:away].to_i > 0 ? "+#{ml[:away].to_i}" : ml[:away].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
              <% if ml[:home] %>
                <button class="dk-odds-btn dk-odds-ml" onclick="sbOpenBetslip('<%= gid %>','<%= fix %>','<%= gam %>','<%= at %>','<%= ht %>','<%= ts %>','moneyline','<%= ht %>','','<%= ml[:home] %>','<%= @sport %>','<%= sp_str %>',this)">
                  <span class="dk-price"><%= ml[:home].to_i > 0 ? "+#{ml[:home].to_i}" : ml[:home].to_i %></span>
                </button>
              <% else %><div class="dk-odds-empty"></div><% end %>
            </div>
          </div>
        </div>

      <% end %>

    <% else %>
      <div class="dk-empty-state">
        <%= (image_tag({ 'mlb' => 'ic_baseball.png', 'nfl' => 'ic_football.png', 'nba' => 'ic_basketball.png', 'nhl' => 'ic_hockey.png' }[@sport] || 'ic_baseball.png', class: 'dk-empty-icon') rescue nil) %>
        <h3>No <%= @sport.upcase %> Lines Available</h3>
        <p>Check back soon or browse another sport.</p>
      </div>
    <% end %>

  </div>
</div>

<%# ===== BET SLIP OVERLAY ===== %>
<div class="dk-betslip-overlay" id="betslip-overlay" onclick="sbHandleOverlayClick(event)">
  <div class="dk-betslip-panel">
    <div class="dk-bs-header">
      <span class="dk-bs-title">Place Bet</span>
      <button class="dk-bs-close" onclick="sbCloseBetslip()" type="button"><i class="fa fa-times"></i></button>
    </div>

    <div class="dk-bs-pick">
      <div class="dk-bs-pick-sel" id="bs-pick-name"></div>
      <div class="dk-bs-pick-detail" id="bs-pick-detail"></div>
      <div class="dk-bs-pick-matchup" id="bs-pick-matchup"></div>
    </div>

    <div class="dk-bs-odds-row">
      <span class="dk-bs-odds-label">ODDS</span>
      <span class="dk-bs-odds-value" id="bs-odds"></span>
    </div>

    <div class="dk-bs-amount-section">
      <% if @approved_tokens.present? %>
        <label class="dk-bs-amount-label" for="bs-token">WAGER TOKEN</label>
        <select id="bs-token" onchange="sbTokenChanged()">
          <% @approved_tokens.each { |token| %><option value="<%= token.id %>"><%= token.ticker %> — <%= token.format_units(@account ? @account.token_balance_for(token).balance_units : 0) %></option><% } %>
        </select>
        <div id="bs-token-balance" class="dk-bs-amount-label"></div>
      <% end %>
      <label class="dk-bs-amount-label" for="bs-amount">WAGER AMOUNT</label>
      <div class="dk-bs-input-wrap">
        <input type="text" inputmode="decimal" class="dk-bs-input" id="bs-amount" placeholder="0" style="padding-left: 12px;" oninput="sbUpdatePayout()">
      </div>
      <div class="dk-bs-quick">
        <button type="button" onclick="sbSetAmount('1')">1</button>
        <button type="button" onclick="sbSetAmount('5')">5</button>
        <button type="button" onclick="sbSetAmount('25')">25</button>
        <button type="button" onclick="sbSetAmount('50')">50</button>
        <button type="button" onclick="sbSetAmount('100')">100</button>
      </div>
    </div>

    <div class="dk-bs-payout">
      <div class="dk-bs-payout-row">
        <span>Wager</span>
        <span id="bs-wager-disp">— $BEEP</span>
      </div>
      <div class="dk-bs-payout-row dk-bs-payout-total">
        <span title="Profit, excluding your original wager">To Win</span>
        <span id="bs-win-disp" aria-live="polite">— $BEEP</span>
      </div>
    </div>

    <button class="dk-bs-submit" type="button" onclick="sbPlaceBet()">PLACE BET</button>
  </div>
</div>

<script>
var sbCurrentPick = null;
var sbCurrentBtn  = null;

window.sbOpenBetslip = function(gid, fixId, gameId, away, home, start, type, selection, points, odds, sport, league, btnEl) {
  // Deselect previous button
  if (sbCurrentBtn) sbCurrentBtn.classList.remove('selected');
  btnEl.classList.add('selected');
  sbCurrentBtn = btnEl;

  var oddsNum = parseInt(odds);
  var oddsText = oddsNum > 0 ? '+' + oddsNum : oddsNum.toString();

  var pickLabel = '', detail = '', matchup = away.replace(/\\u0027/g,"'") + ' @ ' + home.replace(/\\u0027/g,"'");
  if (type === 'moneyline') {
    pickLabel = selection + ' ML';
    detail    = 'Moneyline · ' + oddsText;
  } else if (type === 'spread') {
    var pts = parseFloat(points);
    pickLabel = selection + ' ' + (pts > 0 ? '+' + pts : pts);
    detail    = 'Spread · ' + (pts > 0 ? '+' + pts : pts) + ' · ' + oddsText;
  } else if (type === 'total') {
    pickLabel = selection + ' ' + points;
    detail    = selection + ' ' + points + ' · ' + oddsText;
  }

  sbCurrentPick = { gid: gid, fixId: fixId, gameId: gameId, away: away, home: home, start: start, type: type, selection: selection, points: points, odds: odds, oddsNum: oddsNum, sport: sport, league: league, pickLabel: pickLabel };

  document.getElementById('bs-pick-name').textContent    = pickLabel;
  document.getElementById('bs-pick-detail').textContent  = detail;
  document.getElementById('bs-pick-matchup').textContent = matchup;
  document.getElementById('bs-odds').textContent         = oddsText;
  document.getElementById('bs-amount').value             = '';
  document.getElementById('bs-wager-disp').textContent   = '— $BEEP';
  document.getElementById('bs-win-disp').textContent     = '— $BEEP';
  sbUpdatePayout();

  document.getElementById('betslip-overlay').classList.add('open');
  setTimeout(function() { document.getElementById('bs-amount').focus(); }, 300);
};

window.sbCloseBetslip = function() {
  document.getElementById('betslip-overlay').classList.remove('open');
  if (sbCurrentBtn) { sbCurrentBtn.classList.remove('selected'); sbCurrentBtn = null; }
  sbCurrentPick = null;
};

window.sbHandleOverlayClick = function(e) {
  if (e.target === document.getElementById('betslip-overlay')) sbCloseBetslip();
};

window.sbSetAmount = function(cents) {
  document.getElementById('bs-amount').value = cents;
  sbUpdatePayout();
};

window.sbSelectedToken = function() {
  var picker = document.getElementById('bs-token');
  return picker ? SB_TOKENS[picker.value] : null;
};

window.sbTokenChanged = function() {
  var token = sbSelectedToken();
  var picker = document.getElementById('bs-token');
  if (picker) document.getElementById('wager_approved_token_id').value = picker.value;
  var balanceLabel = document.getElementById('bs-token-balance');
  if (balanceLabel) balanceLabel.textContent = token ? 'Available: ' + token.balance + ' ' + token.ticker : '';
  sbUpdatePayout();
};

window.sbUpdatePayout = function() {
  var amount = document.getElementById('bs-amount').value.trim();
  var token = sbSelectedToken();
  var p = sbCurrentPick;
  var winnings = document.getElementById('bs-win-disp');
  winnings.textContent = '—' + (token ? ' ' + token.ticker : '');
  if (!token) return;
  document.getElementById('bs-wager-disp').textContent = (amount || '—') + ' ' + token.ticker;
  if (!p || !/^\d+(?:\.\d*)?$/.test(amount)) return;
  var decimals = Number(token.decimals);
  if (!Number.isInteger(decimals) || decimals < 0 || decimals > 30) return;
  var parts = amount.split('.');
  var fraction = parts[1] || '';
  if (fraction.length > decimals && /[1-9]/.test(fraction.slice(decimals))) return;
  var stake = BigInt(parts[0]) * (10n ** BigInt(decimals)) +
    BigInt((fraction.slice(0, decimals).padEnd(decimals, '0')) || '0');
  var odds = Number(p.oddsNum);
  if (stake <= 0n || !Number.isSafeInteger(odds) || odds === 0) return;
  // Match Wager#payout_for: profit is rounded down to the token's smallest unit.
  var profit = odds > 0 ? stake * BigInt(odds) / 100n : stake * 100n / BigInt(-odds);
  var digits = profit.toString().padStart(decimals + 1, '0');
  var formatted = decimals ? digits.slice(0, -decimals) + '.' + digits.slice(-decimals) : digits;
  if (decimals) formatted = formatted.replace(/\.?0+$/, '');
  winnings.textContent = formatted + ' ' + token.ticker;
};

window.bbCloseModal = function() {
  document.getElementById('buy-beep-modal').style.display = 'none';
};

window.sbPlaceBet = function() {
  var p = sbCurrentPick;
  if (!p) { alert('No pick selected'); return; }
  var amount = document.getElementById('bs-amount').value.trim();
  if (!/^\d+(?:\.\d+)?$/.test(amount)) { alert('Enter a positive decimal wager amount.'); return; }

  // Balance guard — intercept before submit
  if (!SB_LOGGED_IN) {
    window.location.href = '<%= new_user_session_path %>';
    return;
  }
  document.getElementById('wager_fixture_id').value      = p.fixId;
  document.getElementById('wager_game_id').value         = p.gameId;
  document.getElementById('wager_away_team').value       = p.away;
  document.getElementById('wager_home_team').value       = p.home;
  document.getElementById('wager_game_start_time').value = p.start;
  document.getElementById('wager_bet_type').value        = p.type;
  document.getElementById('wager_selection').value       = p.selection;
  document.getElementById('wager_selection_detail').value = p.points || '';
  document.getElementById('wager_odds').value            = p.odds;
  document.getElementById('wager_points').value          = p.points || '';
  document.getElementById('wager_sport').value           = p.sport;
  document.getElementById('wager_league').value          = p.league;
  document.getElementById('wager_amount_cents').value    = '';
  document.getElementById('wager_amount_units').value    = '';
  document.getElementById('wager_approved_token_id').value = document.getElementById('bs-token').value;
  var amountField = document.getElementById('wager_amount');
  if (!amountField) {
    amountField = document.createElement('input');
    amountField.type = 'hidden'; amountField.id = 'wager_amount'; amountField.name = 'wager[amount]';
    document.getElementById('hidden-bet-form').appendChild(amountField);
  }
  amountField.value = amount;
  document.getElementById('wager_is_parlay').value       = 'false';
  document.getElementById('wager_parlay_legs').value     = '';
  document.getElementById('hidden-bet-form').submit();
};

// Close on Escape key
document.addEventListener('keydown', function(e) {
