<div class="my-bets-page">

  <div class="bets-header">
    <div class="container" style="max-width: 960px; margin: 0 auto;">
      <h1>SPORTSBOOK</h1>
      <p class="subtitle">Balance: <span style="color: #00c853; font-weight: 700;"><%= number_with_precision(@account.balance, precision: 2) rescue '0.00' %> $BEEP</span></p>
    </div>
  </div>

  <div class="container" style="max-width: 960px; margin: 0 auto;">

    <nav class="dk-sport-nav">
      <% sports = [
        { key: 'mlb', label: 'MLB', icon: 'ic_baseball.png' },
        { key: 'nfl', label: 'NFL', icon: 'ic_football.png' },
        { key: 'nba', label: 'NBA', icon: 'ic_basketball.png' },
        { key: 'nhl', label: 'NHL', icon: 'ic_hockey.png' }
      ] %>
      <% sports.each do |s| %>
        <%= link_to sportsbook_path(sport: s[:key]), class: "dk-sport-tab #{'active' if @sport == s[:key]}" do %>
          <%= (image_tag s[:icon], class: 'dk-sport-icon') rescue nil %>
          <span><%= s[:label] %></span>
        <% end %>
      <% end %>
    </nav>

    <% if flash[:notice] %>
      <div class="dk-alert dk-alert-success" style="margin: 12px 16px 0;"><i class="fa fa-check-circle"></i> <%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="dk-alert dk-alert-error" style="margin: 12px 16px 0;"><i class="fa fa-exclamation-circle"></i> <%= flash[:alert] %></div>
    <% end %>

    <% unless @has_beep %>
      <div class="dk-alert dk-alert-warning" style="margin: 12px 16px 0;">
        <i class="fa fa-exclamation-triangle"></i>
        You need <strong>$BEEP tokens</strong> to place wagers.
        <%= link_to 'Get $BEEP', wallet_path %>
      </div>
    <% end %>

    <% if @open_wagers.present? %>
      <div class="bets-section" style="margin-top: 12px;">
        <h3 class="section-title"><i class="fa fa-receipt" style="color: #00c853; margin-right: 6px;"></i> ACTIVE WAGERS (<%= @open_wagers.size %>)  <%= link_to 'View All', my_bets_path, style: 'float: right; font-size: 12px; color: #4fc3f7; text-decoration: none; font-weight: 500; text-transform: none; letter-spacing: 0;' %></h3>
        <% @open_wagers.each do |wager| %>
          <%
            w_away_city, w_away_mascot = split_team_name(wager.away_team)
            w_home_city, w_home_mascot = split_team_name(wager.home_team)
            w_away_color = team_color(wager.away_team, 0)
            w_home_color = team_color(wager.home_team, 0)
          %>
          <div class="bet-card">
            <div class="bet-card-matchup">
              <div class="bet-split-away" style="background: <%= w_away_color %>;"></div>
              <div class="bet-split-home" style="background: <%= w_home_color %>;"></div>
              <%= image_tag 'at_large.png', class: 'bet-at-image', style: 'width:28px;height:auto;opacity:0.85;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));' rescue nil %>
              <div class="bet-team-away">
                <% if w_away_city.present? %><div class="bet-team-city"><%= w_away_city %></div><% end %>
                <div class="bet-team-mascot"><%= w_away_mascot %></div>
              </div>
              <div class="bet-team-home">
                <% if w_home_city.present? %><div class="bet-team-city"><%= w_home_city %></div><% end %>
                <div class="bet-team-mascot"><%= w_home_mascot %></div>
              </div>
            </div>
            <div class="bet-info-bar">
              <div class="bet-type-info">
                <span class="bet-selection-name"><%= wager.selection %></span>
                <span class="bet-type-label"><%= wager.bet_type_display %></span>
              </div>
              <span class="bet-odds-badge"><%= wager.odds_display %></span>
            </div>
            <div class="bet-bottom-bar">
              <span>Wager: <span class="bet-wager-amount"><%= wager.amount %> $BEEP</span></span>
              <span>Payout: <span class="bet-payout-amount"><%= wager.potential_payout %></span></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @games.any? %>
      <div class="bets-section" style="margin-top: 16px;">
        <h3 class="section-title"><i class="fa fa-calendar" style="color: #00c853; margin-right: 6px;"></i> <%= @sport.upcase %> LINES &mdash; <%= @games.size %> GAMES</h3>

        <% grouped = @games.group_by { |g| g[:start_date] ? Time.parse(g[:start_date]).strftime('%A, %b %-d') : 'TBD' } rescue { 'Today' => @games } %>
        <% grouped.each do |date_label, games| %>
          <div class="sb-date-label"><%= date_label %></div>

          <% games.each_with_index do |game, idx| %>
            <% odds = game[:odds] || {} %>
            <% ml = odds[:moneyline] || {} %>
            <% sp = odds[:spread] || {} %>
            <% tot = odds[:total] || {} %>
            <% start_time = game[:start_date] ? Time.parse(game[:start_date]) : nil rescue nil %>
            <% start_time_str = start_time ? start_time.iso8601 : '' %>
            <% card_id = "g#{idx}" %>
            <%
              away_city, away_mascot = split_team_name(game[:away_team])
              home_city, home_mascot = split_team_name(game[:home_team])
              away_color = team_color(game[:away_team], 0)
              home_color = team_color(game[:home_team], 0)
            %>

            <div class="bet-card sb-game-card" id="<%= card_id %>">
              <div class="bet-card-matchup">
                <div class="bet-split-away" style="background: <%= away_color %>;"></div>
                <div class="bet-split-home" style="background: <%= home_color %>;"></div>
                <%= image_tag 'at_large.png', class: 'bet-at-image', style: 'width:28px;height:auto;opacity:0.85;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));' rescue nil %>
                <div class="bet-team-away">
                  <% if away_city.present? %><div class="bet-team-city"><%= away_city %></div><% end %>
                  <div class="bet-team-mascot"><%= away_mascot %></div>
                </div>
                <div class="bet-team-home">
                  <% if home_city.present? %><div class="bet-team-city"><%= home_city %></div><% end %>
                  <div class="bet-team-mascot"><%= home_mascot %></div>
                </div>
                <% if game[:is_live] %>
                  <div class="sb-live-badge"><span class="dk-live-dot"></span> LIVE</div>
                <% elsif start_time %>
                  <div class="sb-time-badge"><%= start_time.strftime('%-I:%M %p') %></div>
                <% end %>
              </div>

              <div class="sb-odds-grid">
                <div class="sb-odds-grid-header">
                  <span class="sb-og-team-col"></span>
                  <span class="sb-og-col">SPREAD</span>
                  <span class="sb-og-col">TOTAL</span>
                  <span class="sb-og-col">ML</span>
                </div>
                <div class="sb-odds-grid-row">
                  <span class="sb-og-team"><span class="sb-og-color" style="background: <%= away_color %>;"></span> <%= away_mascot %></span>
                  <% if sp[:away_points] && sp[:away] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="spread" data-selection="<%= game[:away_team] %>" data-points="<%= sp[:away_points] %>" data-odds="<%= sp[:away] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-line"><%= sp[:away_points].to_f > 0 ? "+#{sp[:away_points]}" : sp[:away_points] %></span>
                      <span class="sb-btn-price"><%= sp[:away].to_i > 0 ? "+#{sp[:away].to_i}" : sp[:away].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                  <% if tot[:over] && tot[:points] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="total" data-selection="Over" data-points="<%= tot[:points] %>" data-odds="<%= tot[:over] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-line">O <%= tot[:points] %></span>
                      <span class="sb-btn-price"><%= tot[:over].to_i > 0 ? "+#{tot[:over].to_i}" : tot[:over].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                  <% if ml[:away] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="moneyline" data-selection="<%= game[:away_team] %>" data-points="" data-odds="<%= ml[:away] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-price"><%= ml[:away].to_i > 0 ? "+#{ml[:away].to_i}" : ml[:away].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                </div>
                <div class="sb-odds-grid-row">
                  <span class="sb-og-team"><span class="sb-og-color" style="background: <%= home_color %>;"></span> <%= home_mascot %></span>
                  <% if sp[:home_points] && sp[:home] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="spread" data-selection="<%= game[:home_team] %>" data-points="<%= sp[:home_points] %>" data-odds="<%= sp[:home] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-line"><%= sp[:home_points].to_f > 0 ? "+#{sp[:home_points]}" : sp[:home_points] %></span>
                      <span class="sb-btn-price"><%= sp[:home].to_i > 0 ? "+#{sp[:home].to_i}" : sp[:home].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                  <% if tot[:under] && tot[:points] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="total" data-selection="Under" data-points="<%= tot[:points] %>" data-odds="<%= tot[:under] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-line">U <%= tot[:points] %></span>
                      <span class="sb-btn-price"><%= tot[:under].to_i > 0 ? "+#{tot[:under].to_i}" : tot[:under].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                  <% if ml[:home] %>
                    <button type="button" class="sb-odds-btn js-pick-btn" data-fixture="<%= game[:fixture_id] %>" data-game="<%= game[:game_id] %>" data-away="<%= game[:away_team] %>" data-home="<%= game[:home_team] %>" data-start="<%= start_time_str %>" data-type="moneyline" data-selection="<%= game[:home_team] %>" data-points="" data-odds="<%= ml[:home] %>" data-sport="<%= @sport %>" data-league="<%= game[:league] %>" data-card="<%= card_id %>">
                      <span class="sb-btn-price"><%= ml[:home].to_i > 0 ? "+#{ml[:home].to_i}" : ml[:home].to_i %></span>
                    </button>
                  <% else %>
                    <div class="sb-odds-btn sb-btn-empty">&mdash;</div>
                  <% end %>
                </div>
              </div>

              <div class="sb-bet-area" id="<%= card_id %>-bet" style="display:none;">
                <div class="sb-bet-pick-row">
                  <span class="sb-bet-pick-label" id="<%= card_id %>-pick-name"></span>
                  <span class="sb-bet-pick-odds" id="<%= card_id %>-pick-odds"></span>
                  <button type="button" class="sb-bet-remove" onclick="removePick('<%= card_id %>')"><i class="fa fa-times"></i></button>
                </div>
                <div class="sb-bet-input-row">
                  <label class="sb-bet-label">WAGER AMOUNT</label>
                  <div class="sb-bet-field">
                    <span class="sb-bet-currency">$BEEP</span>
                    <input type="number" class="sb-bet-input" id="<%= card_id %>-amount" min="1" step="1" placeholder="Enter amount" oninput="updateCardPayout('<%= card_id %>')">
                  </div>
                  <div class="sb-bet-quicks">
                    <button type="button" onclick="setCardAmount('<%= card_id %>', 100)">$1</button>
                    <button type="button" onclick="setCardAmount('<%= card_id %>', 500)">$5</button>
                    <button type="button" onclick="setCardAmount('<%= card_id %>', 2500)">$25</button>
                    <button type="button" onclick="setCardAmount('<%= card_id %>', 5000)">$50</button>
                    <button type="button" onclick="setCardAmount('<%= card_id %>', 10000)">$100</button>
                  </div>
                </div>
                <div class="sb-bet-footer">
                  <span class="sb-bet-payout">To Win: <strong id="<%= card_id %>-payout">$0.00</strong></span>
                  <div class="sb-bet-actions">
                    <button type="button" class="sb-btn-parlay" onclick="addToParlay('<%= card_id %>')"><i class="fa fa-plus"></i> Parlay</button>
                    <button type="button" class="sb-btn-place" onclick="placeSingleBet('<%= card_id %>')">Place Bet</button>
                  </div>
                </div>
              </div>

            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bets-section" style="margin-top: 16px;">
        <div class="no-bets">
          <% no_game_icons = { 'mlb' => 'ic_baseball.png', 'nfl' => 'ic_football.png', 'nba' => 'ic_basketball.png', 'nhl' => 'ic_hockey.png' } %>
          <%= (image_tag no_game_icons[@sport] || 'ic_baseball.png', style: 'width: 48px; height: 48px; opacity: 0.2; margin-bottom: 8px;') rescue nil %>
          <p>No <%= @sport.upcase %> games available. Check back later.</p>
        </div>
      </div>
    <% end %>

    <div class="back-to-sportsbook" style="margin-top: 12px;">
      <%= link_to 'My Bets', my_bets_path %>
    </div>

  </div>
</div>

<div id="parlay-tray" class="sb-parlay-tray">
  <div class="sb-parlay-bar" onclick="toggleParlayTray()">
    <span><i class="fa fa-layer-group" style="color:#00c853;margin-right:6px;"></i>PARLAY BUILDER</span>
    <span class="sb-parlay-cnt" id="parlay-count">0 Legs</span>
    <i class="fa fa-chevron-up sb-parlay-arrow" id="parlay-chevron"></i>
  </div>
  <div class="sb-parlay-body" id="parlay-body">
    <div class="sb-parlay-legs" id="parlay-legs">
      <div class="sb-parlay-empty-msg" id="parlay-empty-msg">Tap <strong>+ Parlay</strong> on any pick to start building</div>
    </div>
    <div class="sb-parlay-summary" id="parlay-summary" style="display:none;">
      <div class="sb-parlay-combo-row">
        <span>Combined Odds</span>
        <span class="sb-parlay-combo-val" id="parlay-combined-odds">+100</span>
      </div>
      <div class="sb-bet-input-row" style="margin-bottom:10px;">
        <label class="sb-bet-label">PARLAY WAGER</label>
        <div class="sb-bet-field">
          <span class="sb-bet-currency">$BEEP</span>
          <input type="number" class="sb-bet-input" id="parlay-amount" min="1" step="1" placeholder="Enter amount" oninput="updateParlayPayout()">
        </div>
        <div class="sb-bet-quicks">
          <button type="button" onclick="setParlayAmount(100)">$1</button>
          <button type="button" onclick="setParlayAmount(500)">$5</button>
          <button type="button" onclick="setParlayAmount(2500)">$25</button>
          <button type="button" onclick="setParlayAmount(10000)">$100</button>
        </div>
      </div>
      <div class="sb-parlay-win-row">To Win: <strong id="parlay-payout">$0.00</strong></div>
      <button type="button" class="sb-btn-place" style="width:100%;padding:12px;font-size:15px;" onclick="submitParlay()">Place Parlay Bet</button>
    </div>
  </div>
</div>

<%= form_tag place_wager_path, method: :post, id: 'hidden-bet-form', style: 'display:none;' do %>
  <input type="hidden" name="wager[fixture_id]" id="wager_fixture_id">
  <input type="hidden" name="wager[game_id]" id="wager_game_id">
  <input type="hidden" name="wager[away_team]" id="wager_away_team">
  <input type="hidden" name="wager[home_team]" id="wager_home_team">
  <input type="hidden" name="wager[game_start_time]" id="wager_game_start_time">
  <input type="hidden" name="wager[bet_type]" id="wager_bet_type">
  <input type="hidden" name="wager[selection]" id="wager_selection">
  <input type="hidden" name="wager[selection_detail]" id="wager_selection_detail">
  <input type="hidden" name="wager[odds]" id="wager_odds">
  <input type="hidden" name="wager[points]" id="wager_points">
  <input type="hidden" name="wager[sport]" id="wager_sport">
  <input type="hidden" name="wager[league]" id="wager_league">
  <input type="hidden" name="wager[amount_cents]" id="wager_amount_cents">
  <input type="hidden" name="wager[sportsbook]" value="SportsBeep">
  <input type="hidden" name="wager[is_parlay]" id="wager_is_parlay" value="false">
  <input type="hidden" name="wager[parlay_legs]" id="wager_parlay_legs" value="">
<% end %>

<script>
  var activePicks = {};
  var parlayLegs = [];

  document.querySelectorAll('.js-pick-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var d = this.dataset;
      selectPick(d.card, d.fixture, d.game, d.away, d.home, d.start, d.type, d.selection, d.points, d.odds, d.sport, d.league, this);
    });
  });

  function selectPick(cardId, fixtureId, gameId, away, home, start, type, selection, points, odds, sport, league, btnEl) {
    var card = document.getElementById(cardId);
    card.querySelectorAll('.sb-odds-btn.sb-selected').forEach(function(b) { b.classList.remove('sb-selected'); });
    btnEl.classList.add('sb-selected');
    var oddsNum = parseInt(odds);
    var oddsText = oddsNum > 0 ? '+' + oddsNum : oddsNum.toString();
    var pickLabel = '', detailText = '';
    if (type === 'moneyline') { pickLabel = selection + ' ML'; }
    else if (type === 'spread') { var pts = parseFloat(points); pickLabel = selection + ' ' + (pts > 0 ? '+' + pts : pts); detailText = pts > 0 ? '+' + pts : pts.toString(); }
    else if (type === 'total') { pickLabel = selection + ' ' + points; detailText = selection; }
    document.getElementById(cardId + '-pick-name').textContent = pickLabel;
    document.getElementById(cardId + '-pick-odds').textContent = oddsText;
    document.getElementById(cardId + '-bet').style.display = 'block';
    activePicks[cardId] = { fixtureId: fixtureId, gameId: gameId, away: away, home: home, start: start, type: type, selection: selection, detail: detailText, points: points, odds: odds, oddsNum: oddsNum, sport: sport, league: league, pickLabel: pickLabel };
    updateCardPayout(cardId);
  }

  function removePick(cardId) {
    document.getElementById(cardId + '-bet').style.display = 'none';
    document.getElementById(cardId).querySelectorAll('.sb-odds-btn.sb-selected').forEach(function(b) { b.classList.remove('sb-selected'); });
    delete activePicks[cardId]; removeFromParlay(cardId);
  }

  function setCardAmount(cardId, cents) { document.getElementById(cardId + '-amount').value = cents; updateCardPayout(cardId); }

  function updateCardPayout(cardId) {
    var amountCents = parseInt(document.getElementById(cardId + '-amount').value) || 0;
    var pick = activePicks[cardId]; if (!pick) return;
    var amount = amountCents / 100.0;
    document.getElementById(cardId + '-payout').textContent = '$' + calcProfit(amount, pick.oddsNum).toFixed(2);
  }

  function calcProfit(amount, odds) {
    if (odds > 0) return amount * odds / 100;
    if (odds < 0) return amount * 100 / Math.abs(odds);
    return 0;
  }

  function placeSingleBet(cardId) {
    var pick = activePicks[cardId]; if (!pick) return;
    var amountCents = parseInt(document.getElementById(cardId + '-amount').value) || 0;
    if (amountCents < 1) { alert('Enter a wager amount'); return; }
    document.getElementById('wager_fixture_id').value = pick.fixtureId;
    document.getElementById('wager_game_id').value = pick.gameId;
    document.getElementById('wager_away_team').value = pick.away;
    document.getElementById('wager_home_team').value = pick.home;
    document.getElementById('wager_game_start_time').value = pick.start;
    document.getElementById('wager_bet_type').value = pick.type;
    document.getElementById('wager_selection').value = pick.selection;
    document.getElementById('wager_selection_detail').value = pick.detail;
    document.getElementById('wager_odds').value = pick.odds;
    document.getElementById('wager_points').value = pick.points || '';
    document.getElementById('wager_sport').value = pick.sport;
    document.getElementById('wager_league').value = pick.league;
    document.getElementById('wager_amount_cents').value = amountCents;
    document.getElementById('wager_is_parlay').value = 'false';
    document.getElementById('wager_parlay_legs').value = '';
    document.getElementById('hidden-bet-form').submit();
  }

  function addToParlay(cardId) {
    var pick = activePicks[cardId]; if (!pick) return;
    parlayLegs = parlayLegs.filter(function(l) { return l.cardId !== cardId; });
    parlayLegs.push({ cardId: cardId, pick: pick });
    renderParlay(); showParlayTray();
  }

  function removeFromParlay(cardId) {
    parlayLegs = parlayLegs.filter(function(l) { return l.cardId !== cardId; });
    renderParlay();
  }

  function renderParlay() {
    var legsDiv = document.getElementById('parlay-legs');
    var emptyMsg = document.getElementById('parlay-empty-msg');
    var summary = document.getElementById('parlay-summary');
    var countEl = document.getElementById('parlay-count');
    legsDiv.querySelectorAll('.sb-parlay-leg').forEach(function(el) { el.remove(); });
    if (parlayLegs.length === 0) { emptyMsg.style.display = 'block'; summary.style.display = 'none'; countEl.textContent = '0 Legs'; return; }
    emptyMsg.style.display = 'none'; summary.style.display = 'block';
    countEl.textContent = parlayLegs.length + (parlayLegs.length === 1 ? ' Leg' : ' Legs');
    parlayLegs.forEach(function(leg) {
      var div = document.createElement('div'); div.className = 'sb-parlay-leg';
      var ot = leg.pick.oddsNum > 0 ? '+' + leg.pick.oddsNum : leg.pick.oddsNum;
      div.innerHTML = '<span class="sb-pl-name">' + leg.pick.pickLabel + '</span><span class="sb-pl-matchup">' + leg.pick.away + ' @ ' + leg.pick.home + '</span><span class="sb-pl-odds">' + ot + '</span><button type="button" class="sb-pl-remove" onclick="removeFromParlay(\'' + leg.cardId + '\')"><i class="fa fa-times"></i></button>';
      legsDiv.appendChild(div);
    });
    var combinedDecimal = 1;
    parlayLegs.forEach(function(leg) { var d = leg.pick.oddsNum >= 0 ? (leg.pick.oddsNum / 100 + 1) : (100 / Math.abs(leg.pick.oddsNum) + 1); combinedDecimal *= d; });
    var ca = combinedDecimal >= 2 ? '+' + Math.round((combinedDecimal - 1) * 100) : '-' + Math.round(100 / (combinedDecimal - 1));
    document.getElementById('parlay-combined-odds').textContent = ca;
    document.getElementById('parlay-combined-odds').dataset.decimal = combinedDecimal;
    updateParlayPayout();
  }

  function setParlayAmount(cents) { document.getElementById('parlay-amount').value = cents; updateParlayPayout(); }
  function updateParlayPayout() {
    var a = parseInt(document.getElementById('parlay-amount').value) || 0;
    var d = parseFloat(document.getElementById('parlay-combined-odds').dataset.decimal) || 1;
    document.getElementById('parlay-payout').textContent = '$' + (a / 100.0 * d).toFixed(2);
  }
  function toggleParlayTray() { document.getElementById('parlay-tray').classList.toggle('open'); }
  function showParlayTray() { document.getElementById('parlay-tray').classList.add('open'); }

  function submitParlay() {
    if (parlayLegs.length < 2) { alert('Add at least 2 legs to your parlay'); return; }
    var amountCents = parseInt(document.getElementById('parlay-amount').value) || 0;
    if (amountCents < 1) { alert('Enter a wager amount'); return; }
    var fl = parlayLegs[0].pick;
    document.getElementById('wager_fixture_id').value = fl.fixtureId;
    document.getElementById('wager_game_id').value = fl.gameId;
    document.getElementById('wager_away_team').value = fl.away;
    document.getElementById('wager_home_team').value = fl.home;
    document.getElementById('wager_game_start_time').value = fl.start;
    document.getElementById('wager_bet_type').value = 'parlay';
    document.getElementById('wager_selection').value = parlayLegs.length + '-Leg Parlay';
    document.getElementById('wager_selection_detail').value = parlayLegs.map(function(l) { return l.pick.pickLabel; }).join(' | ');
    var dec = parseFloat(document.getElementById('parlay-combined-odds').dataset.decimal) || 1;
    document.getElementById('wager_odds').value = dec >= 2 ? Math.round((dec - 1) * 100) : -Math.round(100 / (dec - 1));
    document.getElementById('wager_points').value = '';
    document.getElementById('wager_sport').value = fl.sport;
    document.getElementById('wager_league').value = fl.league;
    document.getElementById('wager_amount_cents').value = amountCents;
    document.getElementById('wager_is_parlay').value = 'true';
    document.getElementById('wager_parlay_legs').value = JSON.stringify(parlayLegs.map(function(l) { return { selection: l.pick.pickLabel, odds: l.pick.oddsNum, matchup: l.pick.away + ' @ ' + l.pick.home, type: l.pick.type }; }));
    document.getElementById('hidden-bet-form').submit();
  }
</script>
