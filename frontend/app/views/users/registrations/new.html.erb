<div class="user-registration">
  <div class="container">
    <div class="registration-form-container">
      <h4>Sign Up</h4>
      <%= render 'shared/errors', errors: resource.errors.full_messages %>
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.input :username, required: false, autofocus: true, label: false %>
        <%= f.input :email, required: false, label: false %>
        <%= f.input :password, required: false, label: false %>
        <%= f.input :promo_code, label: false %>
        <%= f.button :submit, 'Sign Up', class: 'registration-btn' %>
      <% end %>
    </div>
  </div>
</div>
