<div id="wallet-connect-modal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.85); z-index:9999; overflow-y:auto;">
  <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:440px; max-width:95%;">
    <div style="background: linear-gradient(135deg, #1a1a2e, #16213e); border: 1px solid rgba(255,255,255,0.15); border-radius: 16px; overflow: hidden;">
      <div style="background: linear-gradient(135deg, #e74c3c, #c0392b); padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
        <h3 style="font-family: 'BebasNeue', sans-serif; font-size: 24px; color: white; margin: 0; letter-spacing: 1px;"><i class="fa fa-link" style="margin-right: 8px;"></i>CONNECT WALLET</h3>
        <button onclick="closeWalletModal()" style="background:none; border:none; color:rgba(255,255,255,0.7); font-size:20px; cursor:pointer; padding:4px;"><i class="fa fa-xmark"></i></button>
      </div>

      <div style="padding: 24px;">
        <% if current_user&.cardano_wallet_address.present? %>
          <div style="background: linear-gradient(135deg, rgba(0,136,204,0.12), rgba(0,180,216,0.08)); border: 1px solid rgba(0,180,216,0.3); border-radius: 12px; padding: 18px 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
              <div style="display: flex; align-items: center;">
                <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #0088cc, #00b4d8); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                  <i class="fa fa-wallet" style="color: white; font-size: 18px;"></i>
                </div>
                <div>
                  <p style="color: white; font-weight: 700; margin: 0; font-size: 15px;"><%= current_user.cardano_wallet_name.presence&.capitalize || 'Cardano' %></p>
                  <p style="color: #8892b0; margin: 0; font-size: 12px;">ADA / $BEEP</p>
                </div>
              </div>
              <% if current_user.cardano_wallet_verified_at.present? %>
                <span style="padding: 4px 12px; background: rgba(72,187,120,0.15); color: #68d391; border-radius: 20px; font-size: 11px; font-weight: 600;"><i class="fa fa-check" style="font-size: 9px; margin-right: 4px;"></i>Verified</span>
              <% else %>
                <span style="padding: 4px 12px; background: rgba(246,173,85,0.15); color: #f6ad55; border-radius: 20px; font-size: 11px; font-weight: 600;"><i class="fa fa-triangle-exclamation" style="font-size: 9px; margin-right: 4px;"></i>Not verified</span>
              <% end %>
            </div>
            <div style="background: rgba(0,0,0,0.25); border-radius: 8px; padding: 10px 14px; margin-bottom: 10px;">
              <code style="color: #00b4d8; word-break: break-all; font-size: 12px;"><%= current_user.cardano_wallet_address %></code>
            </div>
            <% unless current_user.cardano_wallet_verified_at.present? %>
              <p style="color: #f6ad55; font-size: 12px; margin: 0 0 10px;">Ownership not verified yet — reconnect with your wallet extension and sign the verification message to unlock $BEEP loading.</p>
              <button onclick="renderWalletChoices()" style="width: 100%; padding: 10px; background: linear-gradient(135deg, #0088cc, #00b4d8); color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; margin-bottom: 10px;">
                <i class="fa fa-signature" style="margin-right: 6px;"></i> Verify with Wallet
              </button>
            <% end %>
            <%= link_to disconnect_cardano_path(redirect_to: request.fullpath), method: :delete, data: { confirm: 'Disconnect your Cardano wallet?' }, style: 'display: inline-block; padding: 8px 16px; background: rgba(245,101,101,0.15); color: #fc8181; border: 1px solid rgba(245,101,101,0.3); border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;' do %>
              <i class="fa fa-unlink" style="margin-right: 4px;"></i> Disconnect
            <% end %>
          </div>
        <% end %>

        <div id="wallet-picker" style="<%= current_user&.cardano_wallet_address.present? ? 'display:none;' : '' %> margin-top: <%= current_user&.cardano_wallet_address.present? ? '14px' : '0' %>;">
          <p style="color: #a0aec0; font-size: 13px; margin: 0 0 12px;">Choose a wallet extension to connect. You'll approve the connection and sign a one-time message proving you own the wallet — this costs nothing and sends no transaction.</p>
          <div id="wallet-list"></div>
        </div>

        <div id="modal-wallet-status" style="display: none; margin-top: 14px;"></div>

        <div style="text-align: center; margin-top: 16px;">
          <p style="color: #8892b0; font-size: 12px; margin: 0;">
            <i class="fa fa-info-circle" style="margin-right: 4px;"></i>
            Eternl, Nami, Lace, Flint &amp; other CIP-30 wallets supported
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function openWalletModal() {
    var modal = document.getElementById('wallet-connect-modal');
    if (modal) {
      modal.style.display = 'block';
      renderWalletChoices();
    }
  }
  function closeWalletModal() {
    var modal = document.getElementById('wallet-connect-modal');
    if (modal) modal.style.display = 'none';
  }
  (function() {
    var modal = document.getElementById('wallet-connect-modal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) closeWalletModal();
      });
    }
  })();

  function walletStatus(html, color) {
    var el = document.getElementById('modal-wallet-status');
    if (!el) return;
    el.style.display = 'block';
    el.innerHTML = '<div style="padding: 10px 14px; border-radius: 8px; background: rgba(0,0,0,0.25); color: ' + (color || '#a0aec0') + '; font-size: 13px;">' + html + '</div>';
  }

  function detectCardanoWallets() {
    var found = [];
    var api = window.cardano;
    if (!api) return found;
    Object.keys(api).forEach(function(key) {
      var w = api[key];
      if (w && typeof w.enable === 'function' && w.apiVersion) {
        found.push({ key: key, name: w.name || key, icon: w.icon });
      }
    });
    // De-duplicate by display name (some wallets register multiple keys)
    var seen = {};
    return found.filter(function(w) {
      var n = (w.name || w.key).toLowerCase();
      if (seen[n]) return false;
      seen[n] = true;
      return true;
    });
  }

  function renderWalletChoices() {
    var picker = document.getElementById('wallet-picker');
    var list = document.getElementById('wallet-list');
    if (!picker || !list) return;
    picker.style.display = 'block';
    var wallets = detectCardanoWallets();
    if (wallets.length === 0) {
      list.innerHTML = '<div style="padding: 14px; background: rgba(246,173,85,0.1); border: 1px solid rgba(246,173,85,0.3); border-radius: 10px; color: #f6ad55; font-size: 13px;">' +
        'No Cardano wallet extension detected in this browser. Install <strong>Eternl</strong>, <strong>Nami</strong>, or <strong>Lace</strong>, then reload this page.' +
        '</div>';
      return;
    }
    list.innerHTML = wallets.map(function(w) {
      var icon = w.icon ? '<img src="' + w.icon + '" style="width:24px;height:24px;border-radius:6px;margin-right:10px;" alt="">' : '<i class="fa fa-wallet" style="margin-right:10px;color:#00b4d8;"></i>';
      return '<button onclick="connectCip30Wallet(\'' + w.key + '\')" style="width:100%; display:flex; align-items:center; padding:12px 14px; margin-bottom:8px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; color:white; font-size:14px; font-weight:600; cursor:pointer; text-align:left;">' +
        icon + walletEscape(w.name) + '</button>';
    }).join('');
  }

  function walletEscape(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function toHex(str) {
    var out = '';
    var enc = new TextEncoder().encode(str);
    for (var i = 0; i < enc.length; i++) out += enc[i].toString(16).padStart(2, '0');
    return out;
  }

  function csrfToken() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.content : '';
  }

  async function connectCip30Wallet(key) {
    try {
      walletStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Waiting for wallet approval…', '#00b4d8');
      var api = await window.cardano[key].enable();

      var used = await api.getUsedAddresses();
      var addressHex = (used && used.length > 0) ? used[0] : await api.getChangeAddress();
      if (!addressHex) throw new Error('Could not read an address from the wallet.');

      var rewards = await api.getRewardAddresses();
      var signAddressHex = (rewards && rewards.length > 0) ? rewards[0] : addressHex;

      walletStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Requesting verification challenge…', '#00b4d8');
      var nonceResp = await fetch('<%= cardano_nonce_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' }
      });
      if (!nonceResp.ok) throw new Error('Could not get a verification challenge from the server.');
      var nonce = (await nonceResp.json()).nonce;

      walletStatus('<i class="fa fa-signature" style="margin-right:6px;"></i>Please sign the verification message in your wallet…', '#00b4d8');
      var signed = await api.signData(signAddressHex, toHex(nonce));

      walletStatus('<i class="fa fa-circle-notch fa-spin" style="margin-right:6px;"></i>Verifying signature…', '#00b4d8');
      var resp = await fetch('<%= connect_cardano_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
        body: JSON.stringify({
          wallet_name: key,
          address_hex: addressHex,
          signed_address_hex: signAddressHex,
          signature: signed.signature,
          key: signed.key
        })
      });
      var data = await resp.json();
      if (resp.ok && data.ok) {
        walletStatus('<i class="fa fa-check" style="margin-right:6px;"></i>Wallet connected and verified! Reloading…', '#68d391');
        setTimeout(function() { window.location.reload(); }, 800);
      } else {
        throw new Error(data.error || 'Verification failed.');
      }
    } catch (e) {
      var msg = (e && (e.info || e.message)) ? (e.info || e.message) : 'Connection was cancelled or failed.';
      walletStatus('<i class="fa fa-triangle-exclamation" style="margin-right:6px;"></i>' + walletEscape(String(msg)), '#fc8181');
    }
  }
</script>
