<div class="card-container player-score-card">
  <div class="card" ng-style="{ 'background': player.teamColor }">
    <div class="flipper">
      <div class="front">
        <div class="top-left">{{ player.number }}</div>
        <div class="top-right hidden-xs">{{ player.position }}</div>
        <div class="top-right visible-xs">{{ player.score }}</div>
        <div class="clearfix"></div>
        <%= image_tag 'silhouette.png', class: 'picture', 'ng-hide' => 'player.headshot_url' %>
        <img class="picture" ng-show="player.headshot_url" ng-src="{{ player.headshot_url }}">
        <p class="middle">
          <span class="player-name">{{ player.name }}</span><br>
          <span class="team-name" ng-style="{ 'color': player.team.secondary_color }">{{ player.team.name }}</span>
        </p>
        <div class="content">
          {{ player.score }}
        </div>
        <div class="backdrop">
          <team-name-backdrop sb-team="player.team"></team-name-backdrop>
        </div>
        <div class="clearfix"></div>
      </div>

      <div class="back">
        <div class="top-left">{{ player.number }}</div>
        <div class="top-right hidden-xs">{{ player.position }}</div>
        <div class="top-right visible-xs">{{ player.score }}</div>
        <div class="clearfix"></div>
        <%= image_tag 'silhouette.png', class: 'picture', 'ng-hide' => 'player.headshot_url' %>
        <img class="picture" ng-show="player.headshot_url" ng-src="{{ player.headshot_url }}">
        <p class="middle">
          <span class="player-name">{{ player.name }}</span><br>
          <span class="team-name" ng-style="{ 'color': player.team.secondary_color }">{{ player.team.name }}</span>
        </p>
        <div class="content">
          <div class="scrollable">
            <table ng-if="stats.length > 0">
              <tr>
                <td>Stat</td>
                <td>Amount</td>
                <td>Points</td>
              </tr>
              <tr ng-repeat="stat in stats">
                <td>{{ stat.abbr }}</td>
                <td>{{ stat.amount }}</td>
                <td>{{ stat.points }}</td>
              </tr>
            </table>
            <span class="no-stats-msg" ng-if="stats.length == 0">No stats available for this player.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>