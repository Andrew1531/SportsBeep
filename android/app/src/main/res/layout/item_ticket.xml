<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/userPhoto_ImageView"
        android:layout_width="@dimen/portrait_size"
        android:layout_height="@dimen/portrait_size"
        android:src="@drawable/player_silhouette" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@color/panel_background"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/place_FontTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/baby_blue"
                android:textSize="32sp"
                app:font="BebasNeue" />

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/userName_FontTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textSize="32sp"
                app:font="BebasNeue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@color/dark_blue"
            android:gravity="right"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <com.sportsbeep.app.ui.view.FontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total"
                android:textColor="@color/baby_blue"
                android:textSize="16sp" />

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/points_FontTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textColor="@color/light_red"
                android:textSize="32sp"
                app:font="BebasNeue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>