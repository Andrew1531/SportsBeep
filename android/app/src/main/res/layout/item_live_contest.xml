<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/item_game_big" />

        <ProgressBar
            android:id="@+id/contest_ProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_blue"
        android:padding="4dp">

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/pool_placement_FontTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pool_placement"
            android:textSize="16sp" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/points_FontTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:text="@string/points"
            android:textColor="@color/green"
            android:textSize="22sp"
            app:font="BebasNeue" />
    </LinearLayout>
</LinearLayout>