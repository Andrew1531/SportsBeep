<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sportsbeep.app.ui.view.FontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_blue"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/scoring_breakdown"
        android:textSize="36sp"
        app:font="BebasNeue" />

    <include layout="@layout/item_game_compact" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/black"
            android:dividerHeight="1dp" />

        <ProgressBar
            android:id="@android:id/progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gray"
            android:gravity="right|center_vertical"
            android:paddingRight="100dp"
            android:paddingTop="4dp"
            android:text="@string/total_lc"
            android:textSize="26sp" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/points_FontTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel_background"
            android:gravity="right|center_vertical"
            android:paddingBottom="4dp"
            android:paddingRight="15dp"
            android:paddingTop="4dp"
            android:textColor="@color/green"
            android:textSize="36sp"
            app:font="BebasNeue" />
    </LinearLayout>
</LinearLayout>