<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    android:id="@+id/game_LinearLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/date_FontTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="11sp" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/time_FontTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="11sp" />
    </LinearLayout>

    <com.sportsbeep.app.ui.view.SplitColorRelativeLayout
        android:id="@+id/parent_SplitColorRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        app:splitDirection="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/at" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/teamMarket1_FontTextView"
                style="@style/GameCompactTeamMarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/teamName1_FontTextView"
                style="@style/GameCompactTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="right"
            android:orientation="vertical">


            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/teamMarket2_FontTextView"
                style="@style/GameCompactTeamMarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.sportsbeep.app.ui.view.FontTextView
                android:id="@+id/teamName2_FontTextView"
                style="@style/GameCompactTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-5dp" />
        </LinearLayout>
    </com.sportsbeep.app.ui.view.SplitColorRelativeLayout>

</LinearLayout>