<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/item_game_big" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel_background"
        android:padding="4dp">

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_time" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/days_FontTextView"
            style="@style/ContestTimeFontTextView"
            android:layout_marginLeft="2dp"
            app:font="BebasNeue" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/days" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/hours_FontTextView"
            style="@style/ContestTimeFontTextView"
            android:layout_marginLeft="2dp"
            app:font="BebasNeue" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/hrs" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/minutes_FontTextView"
            style="@style/ContestTimeFontTextView"
            android:layout_marginLeft="2dp"
            app:font="BebasNeue" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/mins" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/seconds_FontTextView"
            style="@style/ContestTimeFontTextView"
            android:layout_marginLeft="2dp"
            app:font="BebasNeue" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/secs" />
    </LinearLayout>
</LinearLayout>