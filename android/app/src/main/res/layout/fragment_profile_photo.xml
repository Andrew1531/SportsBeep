<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_blue_rounded"
    android:gravity="center"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/profilePhoto_ImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/player_silhouette_circle" />

    <com.sportsbeep.app.ui.view.FontTextView
        android:id="@+id/name_FontTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:singleLine="true"
        android:textSize="32sp"
        app:font="BebasNeue" />

    <Space
        android:layout_width="0dp"
        android:layout_height="36dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/cancel_FontTextView"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_red"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:text="@string/cancel"
            android:textSize="22sp" />

        <Space
            android:layout_width="20dp"
            android:layout_height="wrap_content" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/save_FontTextView"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_red"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:text="@string/save"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>