<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:orientation="vertical">

    <com.sportsbeep.app.ui.view.FontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/change_choices" />

    <com.sportsbeep.app.ui.view.FontTextView
        android:id="@+id/setYourTeam_FontTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/set_your_team_selector"
        android:enabled="false"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        android:text="@string/set_your_team"
        android:textSize="36sp"
        app:font="BebasNeue" />

</LinearLayout>