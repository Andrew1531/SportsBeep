<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/DialogStyle"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.sportsbeep.app.ui.view.FontTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="@string/commit_to_contest"
        android:textSize="18sp"
        app:font="BebasNeue" />

    <com.sportsbeep.app.ui.view.FontTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/are_you_ready"
        android:textSize="32sp"
        app:font="BebasNeue" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/yes_FontTextView"
            style="@style/DialogButtonStyle"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/yes" />

        <com.sportsbeep.app.ui.view.FontTextView
            android:id="@+id/cancel_FontTextView"
            style="@style/DialogButtonStyle"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>