<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/playerPortrait_Bitmap"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/player_silhouette" />
    </item>
    <item>
        <shape
            android:innerRadius="91dp"
            android:shape="ring"
            android:thickness="38dp"
            android:useLevel="false">
            <solid android:color="@color/panel_background" />
        </shape>
    </item>
    <item android:id="@+id/colorRing_Drawable">
        <shape
            android:innerRadius="91dp"
            android:shape="ring"
            android:thickness="8dp"
            android:useLevel="false">
            <solid android:color="@color/blue_gray" />
        </shape>
    </item>
</layer-list>